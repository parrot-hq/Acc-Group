    "Who-we-are.html": {
      "settings": {
        "title": "Who we are",
        "meta_descr": "Accounting for Retail - Petrol stations, shops",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": 10
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "font-weight": "500"
            },
            ".content-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "color": "#ffffff",
              "margin-left": "0.6rem",
              "span": {
                "margin-right": "15px",
                "margin-left": "20px",
                "padding": "10px",
                "border-radius": "100%",
                "color": "@primaryColor",
                "background-color": "#ffffff",
                "font-size": "2.475rem"
              }
            },
            ".mbr-section-btn": {
              "display": "flex",
              ".btn": {
                "font-weight": "700 !important"
              }
            },
            ".video-wrap": {
              "cursor": "pointer",
              "margin-left": "30px",
              ".mbr-media": {
                "z-index": "70",
                "height": "100%",
                "-o-object-fit": "cover",
                "object-fit": "cover",
                "background-repeat": "no-repeat",
                "background-size": "cover",
                "cursor": "pointer"
              },
              ".mbr-media span": {
                "font-size": "20px",
                "cursor": "pointer",
                "display": "inline-block",
                "transition": "all 0.25s",
                "color": "@iconColor",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              ".icon-wrap": {
                "background-color": "@bgIconColor",
                "width": "3.7em",
                "height": "3.7em",
                "border-radius": "50%",
                "max-width": "100% !important",
                "text-align": "center",
                "display": "inline-block",
                "border": "2px solid transparent",
                "box-sizing": "content-box",
                "position": "relative",
                ".line-video-1, .line-video-2": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "border": "2px solid rgba(255, 255, 255, 0.8)",
                  "border-radius": "50%",
                  "animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation": "squares 2.4s linear 0s infinite",
                  "-ms-animation": "squares 2.4s linear 0s infinite",
                  "-o-animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation-play-state": "running",
                  "animation-play-state": "running",
                  "opacity": "0"
                },
                ".line-video-2": {
                  "-webkit-animation-delay": "1.2s",
                  "animation-delay": "1.2s"
                }
              },
              ".mbr-text": {
                "color": "#ffffff",
                "font-weight": "700"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "calc(80vw / 1.778)",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "4vw",
              "top": "4vh",
              "color": "@successColor",
              "z-index": "5000000",
              "font-size": "37px",
              "background": "#000",
              "padding": "20px",
              "border-radius": "50%",
              "&:hover": {
                "color": "@successColor"
              }
            },
            "@media (max-width: 991px)": {
              ".separator, .sep-holder, .sep-line": {
                "display": "none !important"
              }
            },
            "@media (max-width: 768px)": {
              ".buttons-wrap": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  "justify-content": "center"
                },
                ".video-wrap": {
                  "margin-left": "0",
                  "margin-top": "25px",
                  "justify-content": "center"
                }
              }
            },
            "@-webkit-keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            "@keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            ".skew": {
              "background-image": "url(@bgImg1)",
              "background-position": "center left",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "overflow": "hidden",
              "transition": "background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s",
              "margin-top": "-140px",
              "margin-bottom": "0",
              "z-index": "8",
              "position": "absolute",
              "display": "block",
              "width": "100%",
              "bottom": "0",
              ".inner": {
                "min-height": "150px",
                "align-items": "center",
                "display": "flex",
                "margin-right": "auto",
                "margin-left": "auto",
                "position": "relative"
              }
            }
          },
          "_name": "header4",
          "_customHTML": "<section class=\"header4\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"playervimeo\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Buttons Position\" name=\"justify\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Video Button\" name=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n        <input type=\"color\" title=\"Play Icon Color\" name=\"iconColor\" value=\"#279e64\" condition=\"showVideoButton\">\n        <input type=\"color\" title=\"Play Icon Background\" name=\"bgIconColor\" value=\"#ffffff\" condition=\"showVideoButton\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=J21qu_vspfg\" condition=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Bottom Mask\" name=\"showBottmMask\" checked>\n        <input type=\"image\" title=\"Image 1\" name=\"bgImg1\" value=\"@PROJECT_PATH@/assets/images/bg-skew.png\" condition=\"showBottmMask\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/carolyn-christine-d7bmnvgja2q-unsplash.jpg\" title=\"Image\" selected>\n            <input type=\"color\" value=\"#13287d\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#1b1a1a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-left\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"wrap d-flex flex-column\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold align-left w-100\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><div><span style=\"font-size: 4.375rem;\">Why us?</span><br></div></h1>\n                    <p class=\"mbr-section-subtitle mbr-bold align-left pb-1 mbr-fonts-style w-100\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        REGULAR CLEANING</p>\n                    <p class=\"mbr-text align-left mbr-fonts-style mt-4\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                         and we'll do the number crunching</p>\n                    <div class=\"buttons-wrap d-flex mt-4 w-100\" mbr-class=\"{'justify-content-start': justify == 1, 'justify-content-center': justify == 2, 'justify-content-end': justify == 3}\">\n                        <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"index.html#form2-i\" data-app-placeholder=\"Type Text\">FREE Business Toolkit</a></div>\n                        <div class=\"video-wrap d-flex align-items-center\" mbr-if=\"showVideoButton\">\n                            <div class=\"mbr-media show-modal align-center d-flex align-items-center\" data-modal=\".modalWindow\" mbr-if=\"showVideoButton\">\n                                <div class=\"icon-wrap\" mbr-if=\"showVideoButton\">\n                                    <span mbr-icon class=\"mbr-iconfont fa-play fa\" mbr-if=\"showVideoButton\"></span>\n                                    <span class=\"line-video-animation line-video-1\"></span>\n                                    <br>\n                                    <span class=\"line-video-animation line-video-2\"></span>\n                                </div>\n                            </div>\n                            <h4 class=\"mbr-text mbr-fonts-style align-self-center ml-3 my-auto mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".video-wrap .mbr-text,.mbr-section-btn\" mbr-if=\"showVideoButton\">\n                                Our Video!\n                            </h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-arrow-down mbr-iconfont\"></i>\n        </a>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"skew\" mbr-if=\"showBottmMask\">\n        <div class=\"inner\">\n\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "shhKz4MJWb",
          "_anchor": "header4-9g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".main-row": {
                "flex-direction": "row-reverse"
              },
              ".content": {
                "padding-right": "30px"
              }
            },
            "& when not (@reverseContent)": {
              ".content": {
                "padding-left": "30px"
              }
            },
            "img": {
              "width": "100%"
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "text-align": "left",
              "color": "@primaryColor"
            },
            ".mbr-text": {
              "color": "#0a1126"
            },
            ".left-part": {
              "color": "@secondaryColor",
              ".number": {
                "color": "@numberColor",
                "display": "inline"
              },
              ".mbr-text": {
                "color": "@primaryColor",
                "display": "inline"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              ".btn": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".left-part .mbr-text, .left-part": {
              "color": "#0239b6"
            }
          },
          "_name": "content3",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content3\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&amp;&amp;bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"7\" condition=\"!fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showTabText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" checked=\"\">\n        <input type=\"checkbox\" title=\"Bottom Text\" name=\"showBottomBlock\" checked=\"\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n        <input type=\"color\" title=\"Number Color\" name=\"numberColor\" value=\"#279e64\" selected=\"\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&amp;&amp;bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row main-row\">\n            <div class=\"col-lg-6\">\n                <img src=\"@PROJECT_PATH@/assets/images/office.jpg\" alt=\"\">\n            </div>\n            <div class=\"col-lg-6 content\">\n                <h3 class=\"mbr-fonts-style mbr-section-subtitle align-left mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    About us</h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">Looking for friendly, local accountants?</h2>\n                <p class=\"mbr-fonts-style mbr-text mbr-regular pt-4\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText\" data-app-selector=\".mbr-text\"><b>Then look no further! </b>Accountancy Group can assist businesses of all sizes to increase their profitability, whilst also meeting the compliance demands from the authorities.<br><br>From start-ups and local owner-managed businesses, to high net worth individuals, care homes and dentists, our experienced and proactive team work on behalf of a wide range of clients and can offer tailored advice to suit your individual requirements.<br><br>Paying too much tax? We will work tirelessly to help you maximise your wealth and ensure your personal tax burden is kept to a legal minimum.<br></p>\n                <div class=\"row\">\n                    <div class=\"left-part align-self-center col-12 col-md-5\" mbr-if=\"showNumber\">\n                        <p class=\"number mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-2\" data-app-selector=\".left-part .mbr-text .number, .left-part\">30+</p>\n                        <p mbr-text=\"\" class=\"mbr-text mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".left-part .mbr-text, .left-part\">&nbsp;Years of expertise</p>\n                    </div>\n                    <div class=\"col-12 col-md-7 mt-4 mt-md-0\" mbr-if=\"showBottomBlock\">\n                        <p class=\"mbr-text mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">What’s more, we offer a quick turnaround, fixed fees (so there’s no nasty surprises!) and a free initial consultation – why not contact us today to find out more?<br></p>\n                    </div>\n                </div>\n                <div class=\"mbr-section-btn align-left\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Learn More</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content3-a3",
          "_isUserblock": true,
          "_cid": "shDt2wZMkh",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@isGradientBg)": {
                "background": "linear-gradient(to bottom, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-iconfont": {
              "font-size": "50px",
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "width": "100%",
              "margin-bottom": "15px",
              "margin-top": "20px"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff",
              "width": "100%",
              "position": "relative",
              "padding-top": "25px",
              "&::before": {
                "content": "\"\"",
                "position": "absolute",
                "display": "block",
                "width": "80px",
                "height": "2px",
                "background-color": "#fff",
                "top": "0",
                "left": "50%",
                "transform": "translateX(-50%)"
              }
            },
            ".mbr-text": {
              "color": "#ffffff",
              "width": "100"
            },
            ".content-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "color": "@secondaryColor",
              "margin-left": "0.6rem",
              "span": {
                "margin-right": "15px",
                "margin-left": "20px",
                "padding": "10px",
                "border-radius": "100%",
                "color": "#ffffff",
                "background-color": "#ffffff",
                "font-size": "2.475rem"
              }
            },
            ".mbr-section-btn": {
              ".btn": {
                "border-radius": "3px",
                "padding": "12px 40px !important",
                "margin-right": "20px"
              }
            },
            "@media (max-width: 991px)": {
              ".separator, .sep-holder, .sep-line": {
                "display": "none !important"
              }
            },
            "@media (max-width: 768px)": {
              ".buttons-wrap": {
                "flex-direction": "column"
              }
            },
            ".items": {
              "display": "flex",
              "flex-direction": "row",
              "position": "relative",
              "padding-top": "25px",
              "& when (@showLine)": {
                "&::before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "display": "block",
                  "width": "80px",
                  "height": "2px",
                  "background-color": "@lineColor",
                  "top": "0",
                  "left": "50%",
                  "transform": "translateX(-50%)"
                }
              },
              ".list-item": {
                "vertical-align": "middle",
                "padding-top": "5px",
                "padding-bottom": "5px",
                "align-items": "center",
                "-webkit-align-items": "center",
                "display": "flex",
                ".listico": {
                  "display": "inline-block",
                  "padding-right": "1rem",
                  "padding-left": "1rem",
                  "font-size": "~\"@{listicon}rem\"",
                  "margin": "auto",
                  "color": "@iconColor"
                },
                ".text2": {
                  "display": "inline-block",
                  "color": "#ffffff",
                  "text-align": "left",
                  "margin-bottom": "0"
                },
                "&:last-child": {
                  ".listico": {
                    "display": "none"
                  }
                }
              }
            }
          },
          "_name": "title1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"title1\" group=\"Title\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"25\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"25\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <select title=\"Text Position\" name=\"justify\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\" selected>Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Line\" name=\"showLine\" condition=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n\n        <input type=\"checkbox\" title=\"Items\" name=\"showItems\" checked>\n        <input type=\"range\" inline name=\"list1Items\" title=\"List Items Count\" min=\"0\" max=\"5\" value=\"1\" condition=\"showItems\">\n        <input type=\"range\" inline title=\"List Icons Size\" name=\"listicon\" min=\"0.2\" max=\"2\" step=\"0.1\" value=\"1\" condition=\"showItems\">\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#ffffff\" selected condition=\"showLine && showItems\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffffff\" selected condition=\"showItems\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/clark-tibbs-oqstl2l5oxi-unsplash.jpg\" title=\"Image\" selected>\n            <input type=\"color\" value=\"#13287d\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Bg\" name=\"isGradientBg\" condition=\"bg.type=='color'\" checked>\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#279e64\" condition=\"bg.type=='color' && isGradientBg\" selected>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#13287d\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.83\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-center\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"wrap d-flex flex-column\" mbr-class=\"{'align-items-start': justify == 1, 'align-items-center': justify == 2, 'align-items-end': justify == 3}\">\n                    <span mbr-icon class=\"mbr-iconfont mbrib-like\" mbr-if=\"showIcon\"></span>\n                    <h1 class=\"mbr-fonts-style mbr-section-title mbr-bold align-center\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">\n                        10 good reasons</h1>\n                    <div class=\"items mbr-white\" mbr-list mbr-list-grow=\"list1Items\" mbr-if=\"showItems\">\n                        <div class=\"list-item\">\n                            <h5 class=\"mbr-fonts-style mbr-regular text2\" mbr-theme-style=\"display-7\" data-app-selector=\".items .list-item .text2, .items .list-item\">Why You Should Use Accountancy Group!</h5>\n                            <span class=\"listico\">/</span>\n                        </div>\n                        \n                        \n                        \n                        \n                    </div>\n                    <p class=\"mbr-text align-center pt-4 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed nisl elit, varius ut magna vel,\n                        tincidunt iaculis sem. Interdum\n                        et malesuada fames ac ante ipsum primis in faucibus.</p>\n                    <div class=\"buttons-wrap w-100 mt-4\">\n                        <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-lg btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                PURCHASE NOW</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "shhRbJg4Pq",
          "_anchor": "title1-9y",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".counter-container": {
              "color": "#464646",
              "div": {
                "margin-bottom": "1rem",
                "padding-left": "5rem"
              },
              "li": {
                "list-style": "none",
                "padding-left": "6rem",
                "position": "relative"
              },
              ".counter": {
                "text-overflow": "clip",
                "overflow": "hidden",
                "white-space": "nowrap",
                "font-size": "40px",
                "position": "absolute",
                "left": "0",
                "display": "inline-block",
                "margin": "0 0 5px",
                "line-height": "40px",
                "transition": "all .2s",
                "width": "60px",
                "height": "40px"
              }
            },
            "P": {
              "text-align": "left",
              "color": "#000000"
            }
          },
          "_name": "extContent1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"mbr-section article extСontent\" group=\"Additional Blocks\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Counter Color\" name=\"counterColor\" value=\"#1ec5bf\" condition=\"stylizedCounters\">\n        <input type=\"range\" inline title=\"Count\" name=\"listItems\" min=\"1\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text counter-container col-12 col-md-8 mbr-fonts-style pt-5\" mbr-list mbr-list-grow=\"listItems\">\n                <div class=\"mb-5\">\n                    <h4 class=\"counter\">01.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Special <b>Discounts</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">You will never receive an unexpected bill from us.<br></p>\n                </div>\n                <div class=\"mb-5\">\n                    <h4 class=\"counter\">02.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Weekly <b>Reports</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We provide you with telephone, online and face to face support.<br></p>\n                </div>\n                <div class=\"mb-5\">\n                    <h4 class=\"counter\">03.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We aim to prepare your draft accounts within 30 working days of you supplying us with all the information we require in the format agreed between us.<br></p>\n                </div>\n            <div class=\"mb-5\">\n                    <h4 class=\"counter\">04.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We will GUARANTEE to return all e-mails within the day Monday to Friday, if the request is received by 3PM.<br></p>\n                </div><div class=\"mb-5\">\n                    <h4 class=\"counter\">05.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We GUARANTEE to return all phone calls within the day if the request is received by 4PM.<br></p>\n                </div><div class=\"mb-5\">\n                    <h4 class=\"counter\">06.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We GUARANTEE to reply to your letters within 2 working days where further research is not required.<br></p>\n                </div><div class=\"mb-5\">\n                    <h4 class=\"counter\">07.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">If we miss a filing deadline and you have provided us with all the required information within 28 working days of that deadline we will pay your penalty and do next years tax return free of charge.<br></p>\n                </div><div class=\"mb-5\">\n                    <h4 class=\"counter\">08.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We will provide you with proactive prompt services.<br></p>\n                </div><div class=\"mb-5\">\n                    <h4 class=\"counter\">09.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We will remind you in advance of filing deadlines.<br></p>\n                </div><div class=\"mb-5\">\n                    <h4 class=\"counter\">10.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Easy to <b>Use Tools</b></h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">We will provide you with a tax return and a year end checklist to help you organise the information required to enable us to prepare the return and year end accounts.<br></p>\n                </div></div>\n        </div>\n    </div>\n</section>",
          "_cid": "shhR7LX7JG",
          "_anchor": "extContent1-9x",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
