        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@isGradientBg)": {
                "background": "linear-gradient(to bottom, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".content-inner": {
              ".left-content": {
                "display": "block",
                ".mbr-section-title": {
                  "color": "#ffffff",
                  "margin-bottom": "11px"
                },
                ".mbr-text": {
                  "color": "#ffffff"
                }
              },
              ".right-content": {
                "display": "block",
                ".mbr-text": {
                  "color": "#ffffff",
                  "font-weight": "500",
                  "margin-bottom": "17px",
                  "letter-spacing": ".02em"
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "border-radius": "30px",
                    "padding": "18px 42px !important",
                    "&-white": {
                      "color": "#000000 !important",
                      "&:hover": {
                        "background-color": "@successColor !important",
                        "border-color": "@successColor !important"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".content-inner": {
                "justify-content": "center !important"
              },
              "*": {
                "text-align": "center"
              }
            }
