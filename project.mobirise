    "Tax-assessment.html": {
      "settings": {
        "title": "Tax-assessment",
        "meta_descr": "Accounting for Retail - Petrol stations, shops",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": 2
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "font-weight": "500"
            },
            ".content-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "color": "#ffffff",
              "margin-left": "0.6rem",
              "span": {
                "margin-right": "15px",
                "margin-left": "20px",
                "padding": "10px",
                "border-radius": "100%",
                "color": "@primaryColor",
                "background-color": "#ffffff",
                "font-size": "2.475rem"
              }
            },
            ".mbr-section-btn": {
              "display": "flex",
              ".btn": {
                "font-weight": "700 !important"
              }
            },
            ".video-wrap": {
              "cursor": "pointer",
              "margin-left": "30px",
              ".mbr-media": {
                "z-index": "70",
                "height": "100%",
                "-o-object-fit": "cover",
                "object-fit": "cover",
                "background-repeat": "no-repeat",
                "background-size": "cover",
                "cursor": "pointer"
              },
              ".mbr-media span": {
                "font-size": "20px",
                "cursor": "pointer",
                "display": "inline-block",
                "transition": "all 0.25s",
                "color": "@iconColor",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              ".icon-wrap": {
                "background-color": "@bgIconColor",
                "width": "3.7em",
                "height": "3.7em",
                "border-radius": "50%",
                "max-width": "100% !important",
                "text-align": "center",
                "display": "inline-block",
                "border": "2px solid transparent",
                "box-sizing": "content-box",
                "position": "relative",
                ".line-video-1, .line-video-2": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "border": "2px solid rgba(255, 255, 255, 0.8)",
                  "border-radius": "50%",
                  "animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation": "squares 2.4s linear 0s infinite",
                  "-ms-animation": "squares 2.4s linear 0s infinite",
                  "-o-animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation-play-state": "running",
                  "animation-play-state": "running",
                  "opacity": "0"
                },
                ".line-video-2": {
                  "-webkit-animation-delay": "1.2s",
                  "animation-delay": "1.2s"
                }
              },
              ".mbr-text": {
                "color": "#ffffff",
                "font-weight": "700"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "calc(80vw / 1.778)",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "4vw",
              "top": "4vh",
              "color": "@successColor",
              "z-index": "5000000",
              "font-size": "37px",
              "background": "#000",
              "padding": "20px",
              "border-radius": "50%",
              "&:hover": {
                "color": "@successColor"
              }
            },
            "@media (max-width: 991px)": {
              ".separator, .sep-holder, .sep-line": {
                "display": "none !important"
              }
            },
            "@media (max-width: 768px)": {
              ".buttons-wrap": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  "justify-content": "center"
                },
                ".video-wrap": {
                  "margin-left": "0",
                  "margin-top": "25px",
                  "justify-content": "center"
                }
              }
            },
            "@-webkit-keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            "@keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            ".skew": {
              "background-image": "url(@bgImg1)",
              "background-position": "center left",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "overflow": "hidden",
              "transition": "background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s",
              "margin-top": "-140px",
              "margin-bottom": "0",
              "z-index": "8",
              "position": "absolute",
              "display": "block",
              "width": "100%",
              "bottom": "0",
              ".inner": {
                "min-height": "150px",
                "align-items": "center",
                "display": "flex",
                "margin-right": "auto",
                "margin-left": "auto",
                "position": "relative"
              }
            }
          },
          "_name": "header4",
          "_customHTML": "<section class=\"header4\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"playervimeo\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Buttons Position\" name=\"justify\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Video Button\" name=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n        <input type=\"color\" title=\"Play Icon Color\" name=\"iconColor\" value=\"#279e64\" condition=\"showVideoButton\">\n        <input type=\"color\" title=\"Play Icon Background\" name=\"bgIconColor\" value=\"#ffffff\" condition=\"showVideoButton\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=J21qu_vspfg\" condition=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Bottom Mask\" name=\"showBottmMask\" checked>\n        <input type=\"image\" title=\"Image 1\" name=\"bgImg1\" value=\"@PROJECT_PATH@/assets/images/bg-skew.png\" condition=\"showBottmMask\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/gabrielle-henderson-hjckknwcxxq-unsplash.jpg\" title=\"Image\" selected>\n            <input type=\"color\" value=\"#13287d\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#3b5998\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-left\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"wrap d-flex flex-column\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold align-left w-100\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><div><span style=\"font-size: 4.375rem;\">Tax assessment</span><br></div></h1>\n                    <p class=\"mbr-section-subtitle mbr-bold align-left pb-1 mbr-fonts-style w-100\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        REGULAR CLEANING</p>\n                    <p class=\"mbr-text align-left mbr-fonts-style mt-4\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                         Self assessment Tax Return News - <br>Deadline extended - 28th Feb 2021</p>\n                    <div class=\"buttons-wrap d-flex mt-4 w-100\" mbr-class=\"{'justify-content-start': justify == 1, 'justify-content-center': justify == 2, 'justify-content-end': justify == 3}\">\n                        <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"index.html#Calendly_html\" data-app-placeholder=\"Type Text\">\n                                Download FREE Business toolkit</a></div>\n                        <div class=\"video-wrap d-flex align-items-center\" mbr-if=\"showVideoButton\">\n                            <div class=\"mbr-media show-modal align-center d-flex align-items-center\" data-modal=\".modalWindow\" mbr-if=\"showVideoButton\">\n                                <div class=\"icon-wrap\" mbr-if=\"showVideoButton\">\n                                    <span mbr-icon class=\"mbr-iconfont fa-play fa\" mbr-if=\"showVideoButton\"></span>\n                                    <span class=\"line-video-animation line-video-1\"></span>\n                                    <br>\n                                    <span class=\"line-video-animation line-video-2\"></span>\n                                </div>\n                            </div>\n                            <h4 class=\"mbr-text mbr-fonts-style align-self-center ml-3 my-auto mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".video-wrap .mbr-text,.mbr-section-btn\" mbr-if=\"showVideoButton\">\n                                Our Video!\n                            </h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-arrow-down mbr-iconfont\"></i>\n        </a>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"skew\" mbr-if=\"showBottmMask\">\n        <div class=\"inner\">\n\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sniQzc7sXy",
          "_anchor": "header4-au",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".main-row": {
                "flex-direction": "row-reverse"
              },
              ".content": {
                "padding-right": "30px"
              }
            },
            "& when not (@reverseContent)": {
              ".content": {
                "padding-left": "30px"
              }
            },
            "img": {
              "width": "100%"
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "text-align": "left",
              "color": "@primaryColor"
            },
            ".mbr-text": {
              "color": "#232323"
            },
            ".left-part": {
              "color": "@secondaryColor",
              ".number": {
                "color": "@numberColor",
                "display": "inline"
              },
              ".mbr-text": {
                "color": "@primaryColor",
                "display": "inline"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              ".btn": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            }
          },
          "_name": "content3",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content3 cleanm4_content3\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"7\" condition=\"!fullScreen\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showTabText\" checked>\n\t\t<input type=\"checkbox\" title=\"Number\" name=\"showNumber\">\n\t\t<input type=\"checkbox\" title=\"Bottom Text\" name=\"showBottomBlock\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n\t\t<input type=\"color\" title=\"Number Color\" name=\"numberColor\" value=\"#279e64\" selected>\n\t\t<input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n\t\t<div class=\"row main-row\">\n\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/tax-return-new.png\" alt>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-6 content\">\n\t\t\t\t<h3 class=\"mbr-fonts-style mbr-section-subtitle align-left mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\tAbout Company\n\t\t\t\t</h3>\n\t\t\t\t<h2 class=\"mbr-fonts-style mbr-section-title mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">Anyone who cannot file their return by the 31 January deadline will not receive a late filing penalty if they file online by 28 February.</h2>\n\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular pt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showTabText\" data-app-selector=\".mbr-text\">More than 8.9m customers have already filed their tax return. HMRC is encouraging anyone who has not yet filed their tax return to do so by 31 January, if possible.<br><br>More info - <b><a href=\"http://www.gov.uk\" class=\"text-success\" target=\"_blank\">www.gov.uk</a></b></p>\n\t\t\t\t<div class=\"row\">\n\t\t\t\t\t<div class=\"left-part align-self-center col-12 col-md-5\" mbr-if=\"showNumber\">\n\t\t\t\t\t\t<p class=\"number mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-1\" data-app-selector=\".left-part .mbr-text .number, .left-part\">\n\t\t\t\t\t\t\t25\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p mbr-text class=\"mbr-text mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".left-part .mbr-text, .left-part\">\n\t\t\t\t\t\t\tYears Experience\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-12 col-md-7 mt-4 mt-md-0\" mbr-if=\"showBottomBlock\">\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\t\tBy creating an easy way to match homeowners with trusted, professional service providers at\n\t\t\t\t\t\t\taffordable rates, we’re taking\n\t\t\t\t\t\t\tthe first step toward our mission of providing cleaning services to everyone.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"mbr-section-btn align-left\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t<a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"> Learn\n\t\t\t\t\t\tMore</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "snjw2kVzvl",
          "_anchor": "content3-bc",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor",
              "text-align": "left"
            },
            "img": {
              "width": "100%"
            },
            ".mbr-text": {
              "color": "#0a1126"
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              ".btn": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".cards-wrap": {
              "flex-direction": "column"
            },
            ".wrapper": {
              "border-radius": "0.25rem",
              "margin-bottom": "26px",
              "display": "flex",
              ".img": {
                "margin-bottom": "20px",
                "margin-right": "25px",
                "background-color": "@iconBgColor",
                "width": "50px",
                "min-width": "50px",
                "height": "50px",
                "border-radius": "3px",
                "display": "inline-flex",
                "align-items": "center",
                "justify-content": "center",
                "&:hover": {
                  "-webkit-animation-name": "animation-wobble-vertical",
                  "animation-name": "animation-wobble-vertical",
                  "-webkit-animation-duration": "1s",
                  "animation-duration": "1s",
                  "-webkit-animation-timing-function": "ease-in-out",
                  "animation-timing-function": "ease-in-out",
                  "-webkit-animation-iteration-count": "1",
                  "animation-iteration-count": "1"
                },
                ".mbr-iconfont": {
                  "font-size": "1.875rem",
                  "top": "0",
                  "color": "contrast(@iconBgColor)",
                  "border-radius": "50%"
                }
              },
              ".content": {
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            ".widget-container": {
              "margin": "0 0 30px",
              ".project-info": {
                "padding": "15px 30px 13px",
                "background-color": "@widgetBgColor",
                "border-radius": "3px",
                ".info-item": {
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "padding": "17px 0",
                  "border-bottom": "1px solid @widgetBorderColor",
                  ".label": {
                    "font-weight": "500",
                    "margin-right": "10px",
                    "flex": "none",
                    "margin-bottom": "0"
                  },
                  ".info-text": {
                    "margin-bottom": "0"
                  },
                  "&:last-child": {
                    "border-bottom": "none"
                  }
                }
              }
            },
            ".newsletter": {
              "padding": "35px 30px 40px",
              "border-radius": "3px",
              "display": "block",
              ".mbr-section-subtitle": {
                "position": "relative",
                "margin-bottom": "25px",
                "color": "@primaryColor"
              },
              ".form-group, .mbr-section-btn": {
                "margin": "0",
                "padding": "0",
                "display": "-webkit-flex"
              },
              "textarea": {
                "height": "110px !important"
              },
              ".form-control": {
                "font-size": "14px",
                "background": "@inputBg",
                "color": "@inputTextColor",
                "display": "block",
                "height": "60px",
                "border-radius": "3px",
                "width": "100%",
                "padding": "13px 20px !important",
                "padding-right": "50px !important",
                "transition": "all .3s linear 0ms",
                "&::-webkit-input-placeholder": {
                  "color": "@inputTextColor"
                },
                "&::-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-ms-input-placeholder": {
                  "color": "@inputTextColor"
                }
              },
              ".form-group": {
                "margin-bottom": "8.6px"
              },
              ".dragArea": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  ".btn": {
                    "font-weight": "bold",
                    "margin-left": "0 !important",
                    "margin-right": "0 !important",
                    "position": "relative",
                    "overflow": "hidden",
                    "&.btn-success": {
                      "&:hover": {
                        "background-color": "@secondaryColor !important",
                        "border-color": "@secondaryColor !important",
                        "color": "#ffffff !important"
                      }
                    },
                    "&::after": {
                      "background-color": "@infoColor",
                      "content": "\"\"",
                      "height": "150px",
                      "left": "-75px",
                      "position": "absolute",
                      "top": "-60px",
                      "transform": "rotate(35deg)",
                      "transition": "all 1.5s cubic-bezier(0.19, 1, 0.22, 1)",
                      "width": "40px",
                      "opacity": "0",
                      "outline": "none",
                      "text-decoration": "none"
                    },
                    "&:hover": {
                      "&::after": {
                        "left": "250px",
                        "opacity": "0.8"
                      }
                    }
                  }
                }
              }
            },
            ".cards-wrap2": {
              "flex-direction": "column",
              ".wrapper2": {
                "border-radius": "0.25rem",
                "margin-bottom": "26px",
                ".img": {
                  "margin-bottom": "20px",
                  ".mbr-iconfont": {
                    "font-size": "50px",
                    "top": "0",
                    "color": "@secondaryColor",
                    "border-radius": "50%"
                  }
                },
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "padding-bottom": "14px",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            "@-webkit-keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            "@keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            ".cards-wrap .wrapper .content .mbr-text, .img": {
              "color": "#0a1126"
            },
            ".bottomPart .wrapper2 .mbr-text, .img": {
              "color": "#0a1126"
            },
            ".cards-wrap .wrapper .content .mbr-card-title, .img": {
              "color": "#ff7c00"
            }
          },
          "_name": "content6",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content6\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Widget\" name=\"showWidget\">\n        <input type=\"checkbox\" title=\"Form\" name=\"showForm\">\n        <input type=\"color\" title=\"Input BG Color\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n        <input type=\"color\" title=\"Input Text Color\" name=\"inputTextColor\" value=\"#83868c\" condition=\"showForm\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showTabText1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showTabText2\">\n        <input type=\"checkbox\" title=\"Bottom Part\" name=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icon Bg\" name=\"iconBgColor\" value=\"#279e64\" selected>\n        <header condition=\"showWidget\">Widget</header>\n        <select title=\"Items Count\" name=\"widgetItemsCount\" condition=\"showWidget\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n        </select>\n        <input type=\"color\" title=\"Bg Color\" name=\"widgetBgColor\" value=\"#eeeff2\" selected condition=\"showWidget\">\n        <input type=\"color\" title=\"Border Color\" name=\"widgetBorderColor\" value=\"#dcdfe2\" selected condition=\"showWidget\">\n\n        <header condition=\"showBottomPart\">Bottom Part</header>\n        <select title=\"Cards\" name=\"cardsAmount2\" condition=\"showBottomPart\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon2\" checked condition=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle2\" checked condition=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText2\" checked condition=\"showBottomPart\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background2.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row main-row\">\n            <div class=\"col-md-4\">\n                <div class=\"widget-container\" mbr-if=\"showWidget\">\n                    <div class=\"project-info\">\n                        <div class=\"info-item\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                More info:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                <a href=\"https://www.gov.uk/\" class=\"text-success\" target=\"_blank\">https://www.gov.uk/</a></p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 1\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Extended until:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                28.02.2021&nbsp;</p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 2\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"></p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\"></p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 3\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Date Start:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                10 July, 2025\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 4\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Date Completed:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                12 July, 2025\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 5\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Website:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                www.example.com\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 6\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Other Info:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                Anything\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"newsletter\" mbr-if=\"showForm\">\n                    <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".newsletter .mbr-section-subtitle\">\n                        Have Any Query?\n                    </h3>\n                    <div mbr-form class=\"form1\" mbr-if=\"showForm\">\n                        <!---Formbuilder Form--->\n                        <form action=\"info@accountancygroup.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler px-2\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! We will be in touch shortly.</div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 form-group\" data-for=\"name\">\n                                    <input type=\"text\" name=\"first-name\" placeholder=\"Your Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                </div>\n                                <div class=\"form-group col\" data-for=\"email\">\n                                    <input type=\"text\" name=\"email\" placeholder=\"Telephone number\" data-form-field=\"E-mail\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\">\n                                </div>\n                                <div data-for=\"message\" class=\"col-lg-12 form-group\">\n                                    <textarea name=\"message\" placeholder=\"Your requirement\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\" value></textarea>\n                                </div>\n                                <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\">\n                                    <a type=\"submit\" class=\"btn btn-lg btn-success\">Send Message</a>\n                                </div>\n                            </div>\n                        </form>\n                        <!---Formbuilder Form--->\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-8\">\n                <h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Details\n                </h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title mbr-bold align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">\n                    Feb 28th Deadline</h2>\n                <img src=\"@PROJECT_PATH@/assets/images/tax-return-new.png\" mbr-if=\"showImage\" class=\"mb-5 mt-3\" alt>\n\n\n                <p class=\"mbr-fonts-style mbr-text mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showTabText1\" data-app-selector=\".mbr-text\">Taxpayers are still obliged to pay their bill by 31 January. Interest will be charged from 1 February on any outstanding liabilities. They can pay online, via their bank, or by post before they file. More information on how to pay is available at www.gov.uk.Online suppliers are increasing to provide various goods &amp; services in wholesale and retail, not only within UK but also worldwide.<br><br>Taxpayers who cannot afford to pay their tax bill on time can apply online to spread their bill over up to 12 months. But they will need to file their 2019-20 tax return before setting up a time to pay arrangement, so HMRC is encouraging everyone to do this as soon as possible.<br></p>\n                <div class=\"cards-wrap d-flex mt-4\">\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 0\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-sale\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Our focus</h4>\n\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">To help our clients start, grow and succeed in their businesses</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">100% service\n                                    guarantee\n                                </h4>\n\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Safe &amp;\n                                    Effective\n                                </h4>\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-cash\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">About\n                                    Cleaning\n                                </h4>\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mbr-fonts-style mbr-text mbr-regular mb-5\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText2\" data-app-selector=\".mbr-text\">\n                    Tellus in hac habitasse platea dictumst vestibulum rhoncus est pellentesque. Pharetra convallis\n                    posuere morbi leo urna molestie at elementum eu. Sed felis eget velit aliquet sagittis. Congue\n                    mauris rhoncus aenean vel elit scelerisque mauris pellentesque. Eget arcu dictum varius duis at\n                    consectetur lorem. Porttitor massa id neque aliquam vestibulum morbi blandit cursus. Nisi vitae\n                    suscipit tellus mauris a diam maecenas sed enim.&nbsp;</p>\n                <div class=\"row bottomPart\" mbr-if=\"showBottomPart\">\n                    <div class=\"col-lg-6\">\n                        <div class=\"image-wrap mb-5\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr.jpg\" alt>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <div class=\"cards-wrap2 d-flex\">\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 0\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-sale\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Vetted,\n                                        background\n                                        checked\n                                    </h4>\n\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut labore et dolore tumber tur adipisicing\n                                        elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 1\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">100% service\n                                        guarantee\n                                    </h4>\n\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 2\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Safe &amp; Effective\n                                    </h4>\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 3\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Cleaning is...\n                                    </h4>\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mbr-section-btn align-left\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Learn More</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sniQzczdty",
          "_anchor": "content6-av",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".card-wrapper": {
              "height": "100%",
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".meta": {
                  "color": "#999999",
                  "position": "relative",
                  "margin-bottom": "33px",
                  "& when (@showLines)": {
                    "&::before": {
                      "content": "\"\"",
                      "display": "block",
                      "width": "20px",
                      "height": "3px",
                      "background-color": "@linesColor",
                      "position": "absolute",
                      "left": "0",
                      "bottom": "-25px"
                    }
                  },
                  ".item": {
                    "transition": "all 0.3s ease-in",
                    "&:hover": {
                      "color": "@tagsHoverColor !important"
                    }
                  },
                  ".mbr-iconfont": {
                    "color": "@infoColor",
                    "margin-right": "4px",
                    "font-size": "14px",
                    "font-weight": "400"
                  },
                  ".item-category": {
                    ".category": {
                      "color": "@primaryColor",
                      "font-weight": "500"
                    }
                  },
                  ".item-date": {
                    ".date": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:before": {
                      "content": "\"-\"",
                      "margin-left": "5px",
                      "margin-right": "3px",
                      "color": "@infoColor"
                    },
                    "&::after": {
                      "content": "\"-\"",
                      "margin-left": "5px",
                      "margin-right": "3px",
                      "color": "@infoColor"
                    }
                  },
                  ".item-comment": {
                    ".comment": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "& when (@showLines)": {
                      "&:after": {
                        "content": "\"\"",
                        "display": "block",
                        "width": "35px",
                        "height": "3px",
                        "background-color": "@linesColor",
                        "position": "absolute",
                        "left": "30px",
                        "bottom": "-25px"
                      }
                    }
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500"
                },
                ".mbr-text": {
                  "margin-bottom": "24px",
                  "color": "@infoColor"
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  "display": "inline-block",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            "a[class*=\"text-\"]:not(.nav-link):not(.dropdown-item):not([role])": {
              "background-position": "0 2.1em"
            },
            ".card-wrapper .card-box .mbr-text, .mbr-section-btn": {
              "color": "#232323"
            }
          },
          "_name": "content1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content1 cleanm4_content1\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"!fullScreen\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\" condition=\"!fullScreen\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Meta\" name=\"showMeta\">\n\t\t<input type=\"checkbox\" title=\"Lines\" name=\"showLines\" condition=\"showMeta\">\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n\t\t<header condition=\"showMeta || showLink\">Colors</header>\n\t\t<input type=\"color\" name=\"tagsHoverColor\" title=\"Tags Hover\" value=\"#279e64\" selected condition=\"showMeta\">\n\t\t<input type=\"color\" name=\"linesColor\" title=\"Lines\" value=\"#279e64\" selected condition=\"showMeta && showLines\">\n\t\t<input type=\"color\" name=\"iconColor\" title=\"Link Icon\" value=\"#13287d\" selected condition=\"showLink\">\n\t\t<input type=\"color\" name=\"iconColorHover\" title=\"Link Icon Hover\" value=\"#ffffff\" selected condition=\"showLink\">\n\t\t<input type=\"color\" name=\"iconBgColorHover\" title=\"Link Icon Bg Hover\" value=\"#279e64\" selected condition=\"showLink\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#eeeff2\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#eeeff2\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-box align-left\">\n\n\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn, .card-wrapper .card-box .meta\">HMRC chief executive Jim Harra said:<span style=\"font-weight: normal;\"> ‘We want to encourage as many people as possible to file their return on time, so we can calculate their tax bill and help them if they cannot pay it straight away.</span></h4>\n\t\t\t\t\t\t<h5 class=\"card-subtitle align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn, .card-wrapper .card-box .meta\">\n\t\t\t\t\t\t\tThe best outdoor cleaning</h5>\n\t\t\t\t\t\t<div class=\"meta mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showMeta\">\n\t\t\t\t\t\t\t<span class=\"item-category\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont clock mbrib-folder\"></span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"mbr-fonts-style mbr-text category item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-category .item, .card-wrapper .card-box .meta\">Kitchen\n\t\t\t\t\t\t\t\t\tCleaning, </span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"mbr-fonts-style mbr-text category item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-category .item, .card-wrapper .card-box .meta\">Office\n\t\t\t\t\t\t\t\t\tCleaning</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t<span class=\"item-date\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont comment mbrib-calendar\"></span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"mbr-fonts-style mbr-text date item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-date .date, .card-wrapper .card-box .meta\">July\n\t\t\t\t\t\t\t\t\t25,\n\t\t\t\t\t\t\t\t\t2025</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t<span class=\"item-comment\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont comment mbrib-help\"></span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"mbr-fonts-style mbr-text comment item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-comment .comment, .card-wrapper .card-box .meta\">\n\t\t\t\t\t\t\t\t\tComments: 4</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"><i>‘But we recognise the immense pressure that many people are facing in these unprecedented times and it has become increasingly clear that some people will not be able to file their return by 31 January.<br></i><br><i>‘Not charging late filing penalties for late online tax returns submitted in February will give them the breathing space they need to complete and file their returns, without worrying about receiving a penalty. We can reasonably assume most of these people will have a valid reason for filing late, caused by the pandemic.’</i></p>\n\n\t\t\t\t\t\t<div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t<a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n\t\t\t\t\t\t\t\tContinue Reading<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div>\n\t\t<div class=\"modalWindow\" style=\"display: none;\">\n\t\t\t<div class=\"modalWindow-container\">\n\t\t\t\t<div class=\"modalWindow-video-container\">\n\t\t\t\t\t<div class=\"modalWindow-video\">\n\t\t\t\t\t\t<iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n\t\t\t\t\t</div>\n\t\t\t\t\t<a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n\t\t\t\t\t\t<span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n\t\t\t\t\t\t<span class=\"sr-only\">Close</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "snjx58mBkL",
          "_anchor": "content1-be",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor",
              "text-align": "left"
            },
            "img": {
              "width": "100%"
            },
            ".mbr-text": {
              "color": "#0a1126"
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              ".btn": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".cards-wrap": {
              "flex-direction": "column"
            },
            ".wrapper": {
              "border-radius": "0.25rem",
              "margin-bottom": "26px",
              "display": "flex",
              ".img": {
                "margin-bottom": "20px",
                "margin-right": "25px",
                "background-color": "@iconBgColor",
                "width": "50px",
                "min-width": "50px",
                "height": "50px",
                "border-radius": "3px",
                "display": "inline-flex",
                "align-items": "center",
                "justify-content": "center",
                "&:hover": {
                  "-webkit-animation-name": "animation-wobble-vertical",
                  "animation-name": "animation-wobble-vertical",
                  "-webkit-animation-duration": "1s",
                  "animation-duration": "1s",
                  "-webkit-animation-timing-function": "ease-in-out",
                  "animation-timing-function": "ease-in-out",
                  "-webkit-animation-iteration-count": "1",
                  "animation-iteration-count": "1"
                },
                ".mbr-iconfont": {
                  "font-size": "1.875rem",
                  "top": "0",
                  "color": "contrast(@iconBgColor)",
                  "border-radius": "50%"
                }
              },
              ".content": {
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            ".widget-container": {
              "margin": "0 0 30px",
              ".project-info": {
                "padding": "15px 30px 13px",
                "background-color": "@widgetBgColor",
                "border-radius": "3px",
                ".info-item": {
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "padding": "17px 0",
                  "border-bottom": "1px solid @widgetBorderColor",
                  ".label": {
                    "font-weight": "500",
                    "margin-right": "10px",
                    "flex": "none",
                    "margin-bottom": "0"
                  },
                  ".info-text": {
                    "margin-bottom": "0"
                  },
                  "&:last-child": {
                    "border-bottom": "none"
                  }
                }
              }
            },
            ".newsletter": {
              "padding": "35px 30px 40px",
              "border-radius": "3px",
              "display": "block",
              ".mbr-section-subtitle": {
                "position": "relative",
                "margin-bottom": "25px",
                "color": "@primaryColor"
              },
              ".form-group, .mbr-section-btn": {
                "margin": "0",
                "padding": "0",
                "display": "-webkit-flex"
              },
              "textarea": {
                "height": "110px !important"
              },
              ".form-control": {
                "font-size": "14px",
                "background": "@inputBg",
                "color": "@inputTextColor",
                "display": "block",
                "height": "60px",
                "border-radius": "3px",
                "width": "100%",
                "padding": "13px 20px !important",
                "padding-right": "50px !important",
                "transition": "all .3s linear 0ms",
                "&::-webkit-input-placeholder": {
                  "color": "@inputTextColor"
                },
                "&::-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-ms-input-placeholder": {
                  "color": "@inputTextColor"
                }
              },
              ".form-group": {
                "margin-bottom": "8.6px"
              },
              ".dragArea": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  ".btn": {
                    "font-weight": "bold",
                    "margin-left": "0 !important",
                    "margin-right": "0 !important",
                    "position": "relative",
                    "overflow": "hidden",
                    "&.btn-success": {
                      "&:hover": {
                        "background-color": "@secondaryColor !important",
                        "border-color": "@secondaryColor !important",
                        "color": "#ffffff !important"
                      }
                    },
                    "&::after": {
                      "background-color": "@infoColor",
                      "content": "\"\"",
                      "height": "150px",
                      "left": "-75px",
                      "position": "absolute",
                      "top": "-60px",
                      "transform": "rotate(35deg)",
                      "transition": "all 1.5s cubic-bezier(0.19, 1, 0.22, 1)",
                      "width": "40px",
                      "opacity": "0",
                      "outline": "none",
                      "text-decoration": "none"
                    },
                    "&:hover": {
                      "&::after": {
                        "left": "250px",
                        "opacity": "0.8"
                      }
                    }
                  }
                }
              }
            },
            ".cards-wrap2": {
              "flex-direction": "column",
              ".wrapper2": {
                "border-radius": "0.25rem",
                "margin-bottom": "26px",
                ".img": {
                  "margin-bottom": "20px",
                  ".mbr-iconfont": {
                    "font-size": "50px",
                    "top": "0",
                    "color": "@secondaryColor",
                    "border-radius": "50%"
                  }
                },
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "padding-bottom": "14px",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            "@-webkit-keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            "@keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            ".cards-wrap .wrapper .content .mbr-text, .img": {
              "color": "#0a1126"
            },
            ".bottomPart .wrapper2 .mbr-text, .img": {
              "color": "#0a1126"
            },
            ".cards-wrap .wrapper .content .mbr-card-title, .img": {
              "color": "#ff7c00"
            }
          },
          "_name": "content6",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content6\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Widget\" name=\"showWidget\">\n        <input type=\"checkbox\" title=\"Form\" name=\"showForm\">\n        <input type=\"color\" title=\"Input BG Color\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n        <input type=\"color\" title=\"Input Text Color\" name=\"inputTextColor\" value=\"#83868c\" condition=\"showForm\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showTabText1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showTabText2\">\n        <input type=\"checkbox\" title=\"Bottom Part\" name=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icon Bg\" name=\"iconBgColor\" value=\"#279e64\" selected>\n        <header condition=\"showWidget\">Widget</header>\n        <select title=\"Items Count\" name=\"widgetItemsCount\" condition=\"showWidget\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n        </select>\n        <input type=\"color\" title=\"Bg Color\" name=\"widgetBgColor\" value=\"#eeeff2\" selected condition=\"showWidget\">\n        <input type=\"color\" title=\"Border Color\" name=\"widgetBorderColor\" value=\"#dcdfe2\" selected condition=\"showWidget\">\n\n        <header condition=\"showBottomPart\">Bottom Part</header>\n        <select title=\"Cards\" name=\"cardsAmount2\" condition=\"showBottomPart\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon2\" checked condition=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle2\" checked condition=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText2\" checked condition=\"showBottomPart\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background2-1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row main-row\">\n            <div class=\"col-md-4\">\n                <div class=\"widget-container\" mbr-if=\"showWidget\">\n                    <div class=\"project-info\">\n                        <div class=\"info-item\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                More info:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                <a href=\"https://www.gov.uk/\" class=\"text-success\" target=\"_blank\">https://www.gov.uk/</a></p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 1\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Extended until:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                28.02.2021&nbsp;</p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 2\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"></p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\"></p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 3\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Date Start:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                10 July, 2025\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 4\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Date Completed:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                12 July, 2025\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 5\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Website:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                www.example.com\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 6\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Other Info:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                Anything\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"newsletter\" mbr-if=\"showForm\">\n                    <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".newsletter .mbr-section-subtitle\">\n                        Have Any Query?\n                    </h3>\n                    <div mbr-form class=\"form1\" mbr-if=\"showForm\">\n                        <!---Formbuilder Form--->\n                        <form action=\"info@accountancygroup.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler px-2\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! We will be in touch shortly.</div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 form-group\" data-for=\"name\">\n                                    <input type=\"text\" name=\"first-name\" placeholder=\"Your Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                </div>\n                                <div class=\"form-group col\" data-for=\"email\">\n                                    <input type=\"text\" name=\"email\" placeholder=\"Telephone number\" data-form-field=\"E-mail\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\">\n                                </div>\n                                <div data-for=\"message\" class=\"col-lg-12 form-group\">\n                                    <textarea name=\"message\" placeholder=\"Your requirement\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\" value></textarea>\n                                </div>\n                                <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\">\n                                    <a type=\"submit\" class=\"btn btn-lg btn-success\">Send Message</a>\n                                </div>\n                            </div>\n                        </form>\n                        <!---Formbuilder Form--->\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-8\">\n                <h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Details\n                </h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title mbr-bold align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">\n                    Feb 28th Deadline</h2>\n                <img src=\"@PROJECT_PATH@/assets/images/tax-return-new.png\" mbr-if=\"showImage\" class=\"mb-5 mt-3\" alt>\n\n\n                <p class=\"mbr-fonts-style mbr-text mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showTabText1\" data-app-selector=\".mbr-text\"><br>Normally, late filing penalties are applied to all returns filed after the 31 January deadline. Those penalties are cancelled if the customer has a reasonable excuse for filing late. However, this year HMRC is not issuing late filing penalties for a month to help taxpayers and agents who are unable to meet the deadline. Late filing penalties will not be issued for online tax returns received by 28 February.<br><br>HMRC has previously said that it was keeping the situation closely under review. It has become increasingly clear from the filing rate that some taxpayers and agents cannot file on time, and the department has now determined that ensuring no taxpayer will receive late filing penalties if they file online before the end of February is the best way to help them.<br><br>HMRC has increased support for taxpayers who may need help with their tax liabilities. Once they have completed their 2019-20 tax return, they can set up an online payment plan to spread Self Assessment bills of up to £30,000 over up to 12 monthly instalments. They can apply for self-serve Time to Pay via gov.uk. Interest will be applied to any outstanding balance from 1 February 2021.<br><br>More than 42,000 taxpayers have already used the service, without needing to call HMRC, to manage their liabilities totalling almost £130m.<br><br>Taxpayers with bills over £30,000, or who need longer than 12 months to pay their bill, can call HMRC on 0300 200 3822 to discuss time to pay.<br><br>Taxpayers who are required to make Payments on Account, and know their bill is going to be lower than the previous tax year, for example due to loss of earnings because of Covid-19, can reduce their Payments on Account. Visit GOV.UK to find out more about Payments on Account and how to reduce them.<br><br>Anyone trying to contact HMRC in the run up to the deadline can do so via webchat, Twitter or the Self Assessment phone helpline. They may also find the information they need via the free HMRC app or their Personal Tax Account.<br><br>Phil Hall, head of public affairs &amp; public policy at AAT, said: ‘AAT has been urging HMRC to either extend the self-assessment deadline or waive late filing penalties for several months, in order to help accountants and tax agents to support their clients without incurring financial penalties.<br><br>‘We therefore welcome today’s announcement that no late filing penalties will be applied until 28 February 2021. During a time of unprecedented challenge, this decision will help millions of taxpayers and also relieves some of the pressure on an incredibly busy accountancy sector who are doing their utmost to support individual taxpayers and businesses.’<br><br>The phone helpline and webchat will both be open on <br>30 and 31 January, in addition to the weekday service.&nbsp;<br></p>\n                <div class=\"cards-wrap d-flex mt-4\">\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 0\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-sale\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Our focus</h4>\n\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">To help our clients start, grow and succeed in their businesses</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">100% service\n                                    guarantee\n                                </h4>\n\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Safe &amp;\n                                    Effective\n                                </h4>\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-cash\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">About\n                                    Cleaning\n                                </h4>\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mbr-fonts-style mbr-text mbr-regular mb-5\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText2\" data-app-selector=\".mbr-text\">\n                    Tellus in hac habitasse platea dictumst vestibulum rhoncus est pellentesque. Pharetra convallis\n                    posuere morbi leo urna molestie at elementum eu. Sed felis eget velit aliquet sagittis. Congue\n                    mauris rhoncus aenean vel elit scelerisque mauris pellentesque. Eget arcu dictum varius duis at\n                    consectetur lorem. Porttitor massa id neque aliquam vestibulum morbi blandit cursus. Nisi vitae\n                    suscipit tellus mauris a diam maecenas sed enim.&nbsp;</p>\n                <div class=\"row bottomPart\" mbr-if=\"showBottomPart\">\n                    <div class=\"col-lg-6\">\n                        <div class=\"image-wrap mb-5\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr.jpg\" alt>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <div class=\"cards-wrap2 d-flex\">\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 0\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-sale\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Vetted,\n                                        background\n                                        checked\n                                    </h4>\n\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut labore et dolore tumber tur adipisicing\n                                        elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 1\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">100% service\n                                        guarantee\n                                    </h4>\n\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 2\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Safe &amp; Effective\n                                    </h4>\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 3\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Cleaning is...\n                                    </h4>\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mbr-section-btn align-left\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Learn More</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content6-bd",
          "_isUserblock": true,
          "_cid": "snjwDMGR0h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".counter-container": {
              "color": "#464646",
              "div": {
                "margin-bottom": "1rem",
                "padding-left": "5rem"
              },
              "li": {
                "list-style": "none",
                "padding-left": "6rem",
                "position": "relative"
              },
              ".counter": {
                "text-overflow": "clip",
                "overflow": "hidden",
                "white-space": "nowrap",
                "font-size": "40px",
                "position": "absolute",
                "left": "0",
                "display": "inline-block",
                "margin": "0 0 5px",
                "line-height": "40px",
                "transition": "all .2s",
                "width": "60px",
                "height": "40px"
              }
            },
            "P": {
              "text-align": "left",
              "color": "#767676"
            },
            "H3": {
              "color": "#0239b6"
            }
          },
          "_name": "extContent1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"mbr-section article extСontent\" group=\"Additional Blocks\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Counter Color\" name=\"counterColor\" value=\"#1ec5bf\" condition=\"stylizedCounters\">\n        <input type=\"range\" inline title=\"Count\" name=\"listItems\" min=\"1\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text counter-container col-12 col-md-8 mbr-fonts-style pt-5\" mbr-list mbr-list-grow=\"listItems\">\n                <div class=\"mb-5\">\n                    <h4 class=\"counter\">01.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Telephony and card payment lines</h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Saturday 30 January: 08:00 to 18:00 and <br>Sunday 31 January: 09:00 to 18:00</p>\n                </div>\n                <div class=\"mb-5\">\n                    <h4 class=\"counter\">02.</h4>\n                    <h3 class=\"mb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Webchat</h3>\n                    <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Saturday 30 January and <br>Sunday 31 January: 08:00 to 20:00</p>\n                </div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "snjxR8xwWj",
          "_anchor": "extContent1-bf",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@isGradientBg)": {
                "background": "linear-gradient(to bottom, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".content-inner": {
              ".left-content": {
                "display": "block",
                ".mbr-section-title": {
                  "color": "#ffffff",
                  "margin-bottom": "11px"
                },
                ".mbr-text": {
                  "color": "#ffffff"
                }
              },
              ".right-content": {
                "display": "block",
                ".mbr-text": {
                  "color": "#ffffff",
                  "font-weight": "500",
                  "margin-bottom": "17px",
                  "letter-spacing": ".02em"
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "border-radius": "30px",
                    "padding": "18px 42px !important",
                    "&-white": {
                      "color": "#000000 !important",
                      "&:hover": {
                        "background-color": "@successColor !important",
                        "border-color": "@successColor !important"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".content-inner": {
                "justify-content": "center !important"
              },
              "*": {
                "text-align": "center"
              }
            }
          },
          "_name": "title2",
          "_customHTML": "<section class=\"title2\" group=\"Title\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"25\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"25\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/background4.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#0239b6\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Bg\" name=\"isGradientBg\" condition=\"bg.type=='color'\" checked>\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#00da70\" condition=\"bg.type=='color' && isGradientBg\" selected>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#279e64\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.65\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-center\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"content-inner d-flex justify-content-between flex-wrap align-center\">\n                    <div class=\"left-content\">\n                        <h1 class=\"mbr-fonts-style mbr-section-title mbr-bold align-left\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".content-inner .left-content .mbr-section-title, .mbr-section-btn\">Take action today</h1>\n                        <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".content-inner .left-content .mbr-text, .mbr-section-btn\">Get upto 3 months FREE cloud accounting software<br>* Subject to contract<br></p>\n                    </div>\n                    <div class=\"right-content\">\n                        <p class=\"mbr-text align-center mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".content-inner .right-content .mbr-text, .mbr-section-btn\"></p>\n                        <div class=\"buttons-wrap w-100\">\n                            <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-success\" href=\"index.html#Calendly_html\" data-app-placeholder=\"Type Text\">FREE Consultation</a></div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sniQzdea6T",
          "_anchor": "title2-aw",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n<!-- Calendly inline widget begin -->\n<div class=\"calendly-inline-widget\" data-url=\"https://calendly.com/info-21052/30min\" style=\"min-width:320px;height:700px;\"></div>\n[JS_CODE_0]\n<!-- Calendly inline widget end -->\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "cleanm4",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script type=\"text/javascript\" src=\"https://assets.calendly.com/assets/external/widget.js\"></script>"
          ],
          "_anchor": "custom-html-ax"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "position": "relative",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              },
              ".content": {
                "padding-right": "30px"
              }
            },
            "& when not (@reverseContent)": {
              ".content": {
                "padding-left": "30px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor"
            },
            ".mbr-text": {
              "color": "@infoColor"
            },
            "margin-bottom": "70px",
            ".mbr-iconfont": {
              "font-family": "\"Moririse2\" !important",
              "display": "inline-flex",
              "transform-origin": "",
              "transform": "rotate(45deg)",
              "transition": "all 0.3s",
              "padding": "0 !important",
              "font-size": "1.4rem !important",
              "color": "@iconColor",
              "&:before": {
                "transform": "scaleY(0) !important",
                "transition": "all 0.4s"
              }
            },
            ".p-4": {
              "padding": "1rem 0 !important"
            },
            ".accordion .card .card-header": {
              "margin-bottom": "0px"
            },
            ".mbri-arrow-down:before": {
              "content": "\"\\e960\""
            },
            ".mbri-arrow-up:before": {
              "content": "\"\\e960\""
            },
            ".card": {
              "border-radius": "0px",
              "border-bottom": "2px solid @lineColor !important",
              "&:last-child": {
                "border-bottom": "none !important"
              },
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "background-color": "transparent",
                "padding": "0",
                "h4": {
                  "justify-content": "flex-start",
                  "width": "100%"
                },
                "a.panel-title": {
                  "margin-bottom": "0",
                  "display": "flex",
                  "width": "100%",
                  "justify-content": "space-between",
                  "&:focus": {
                    "text-decoration": "none !important"
                  },
                  "h4": {
                    "padding": "1.2rem 0rem",
                    "margin-bottom": "0",
                    "color": "@primaryColor",
                    "padding-right": "50px",
                    ".sign": {
                      "padding-right": "1rem"
                    }
                  },
                  ".toggle-icon": {
                    "right": "20px",
                    "position": "absolute",
                    "top": "17px",
                    "transform": "translate(-50%, 0) !important",
                    "display": "inline-block",
                    "margin-left": "0",
                    "width": "46px",
                    "height": "46px",
                    "background-color": "@iconColorClickedBg",
                    "transition": "all .3s ease 0s",
                    "box-shadow": "0 14px 40px 0 @iconColorClickedBg",
                    "&:before, &:after": {
                      "background": "@iconColorClicked",
                      "border": "0",
                      "box-sizing": "border-box",
                      "content": "\"\"",
                      "display": "block",
                      "left": "50%",
                      "position": "absolute",
                      "top": "50%"
                    },
                    "&:before": {
                      "height": "12px",
                      "margin-left": "-1px !important",
                      "width": "2px",
                      "margin-top": "-6px",
                      "background-color": "@iconColorClicked",
                      "border": "0",
                      "transform": "none"
                    },
                    "&:after": {
                      "height": "2px",
                      "width": "12px",
                      "margin-left": "-6px",
                      "margin-top": "-1px"
                    }
                  }
                }
              },
              ".panel-body": {
                "padding": "14px 20px",
                "p": {
                  "color": "@infoColor"
                }
              }
            },
            ".collapsed": {
              ".mbr-iconfont": {
                "transform": "rotate(0deg)",
                "&:before": {
                  "transform": "scaleY(1) !important",
                  "transition": "all 0.3s"
                }
              },
              ".toggle-icon": {
                "background-color": "transparent !important",
                "transform": "translate(0, 0)",
                "right": "7px !important",
                "box-shadow": "none !important",
                "&:before, &:after": {
                  "background": "@iconColor !important"
                },
                "&:before": {
                  "background-color": "@iconColor !important"
                }
              }
            },
            ".img-wrap": {
              "img": {
                "width": "100%"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".content .mbr-section-title": {
              "color": "#0355ff"
            }
          },
          "_name": "accordion1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"accordion1\" group=\"Accordions\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax, 'mbr-fullscreen': fullScreen}\" plugins=\"mbr-switch-arrow2, mobirise-icons2\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\" condition=\"!fullScreen\">\n        <header>Show/Hide</header>\n        <input type=\"range\" inline=\"\" title=\"Accordions Count\" name=\"bootstrapAccordion\" min=\"1\" max=\"12\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Colors</header>\n        <input type=\"color\" name=\"iconColor\" title=\"Icons\" value=\"#13287d\" selected=\"\">\n        <input type=\"color\" name=\"iconColorClicked\" title=\"Icons Clicked\" value=\"#ffffff\" selected=\"\">\n        <input type=\"color\" name=\"iconColorClickedBg\" title=\"Icons Clicked Bg\" value=\"#279e64\" selected=\"\">\n        <input type=\"color\" name=\"lineColor\" title=\"Line\" value=\"#efefef\" selected=\"\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked=\"\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-6\">\n                <div class=\"img-wrap mb-5\">\n                    <img src=\"@PROJECT_PATH@/assets/images/design-3588214.jpg\" alt=\"\" title=\"\">\n                </div>\n            </div>\n            <div class=\"col-lg-6 content\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style align-left mbr-semibold\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".content .mbr-section-subtitle\">So you are sure</h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title align-left mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".content .mbr-section-title\">Common questions</h2>\n                <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-article=\"\" data-app-selector=\".content .mbr-text\" data-multiline=\"\" mbr-if=\"showText\">\n                    Etiam non purus eros. Nam convallis lectus at felis faucibus, commodo vestibulum magna laoreet.\n                    Aenean nec\n                    sem semper sem ultricies interdum.</p>\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\n                                <h4 class=\"mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">How do you charge for services?\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                </h4>\n\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">Our fees are based on your requirements. We quote fixed fees in advance to avoid any surprises. Our fees are reasonable which take into account prompt and efficient delivery of services tailored to you and your business needs.&nbsp;</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>FREE appointments?</h4>\n                            </a>\n\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body pt\">Appointments can be made to meet in person or telephone calls to suit your convenience. You can contact us on - info@accountancygroup.com or on 020 8653 8538 or book an appointment via the website.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>FREE software and training?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">For regular accounting clients we can provide free software training and guidance to help you comply and monitor the performance of your business in real time and on a regular basis.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Support &amp; assistance other than accounting?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">We can help you structure your business efficiently so it meets your aims and goals. We cover business structure, salary, dividend planning, VAT, PAYE compliance, regular tax planning, management accounts and business planning. We aim to provide a holistic solutions to your needs.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    Bank accounts?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    What method of payment do you accept?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body pt\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 6\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse7\" aria-expanded=\"false\" aria-controls=\"collapse7\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Anything i should\n                                    know as a new client?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse7\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 7\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse8\" aria-expanded=\"false\" aria-controls=\"collapse8\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Can I make special\n                                    request?\n                                </h4>\n                            </a>\n\n                        </div>\n                        <div id=\"collapse8\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 8\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse9\" aria-expanded=\"false\" aria-controls=\"collapse9\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Any cancellation\n                                    fees?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse9\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">Sem nulla\n                                    pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus turpis.\n                                    Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat vivamus at\n                                    augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 9\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse10\" aria-expanded=\"false\" aria-controls=\"collapse10\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    Do you clean basementsand attics?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse10\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 10\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse11\" aria-expanded=\"false\" aria-controls=\"collapse11\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    How do i cancel of reshedule?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse11\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 11\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core=\"\" href=\"#collapse12\" aria-expanded=\"false\" aria-controls=\"collapse12\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    I don't need bathrrom/bedrooms cleaned?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse12\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n</section>",
          "_isUserblock": true,
          "_cid": "sniQzdwjGZ",
          "_anchor": "accordion1-ay",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".text-content": {
              ".mbr-subtitle": {
                "color": "@secondaryColor"
              },
              ".mbr-section-title": {
                "color": "@primaryColor"
              },
              ".mbr-text": {
                "color": "@infoColor"
              },
              ".list-block": {
                "margin-top": "16px",
                "padding-bottom": "16px",
                ".card-img": {
                  "width": "auto",
                  "span": {
                    "color": "@secondaryColor",
                    "font-size": "1.5rem"
                  }
                },
                ".list-item-title": {
                  "color": "@primaryColor",
                  "transition": "all .3s linear 0s",
                  "&:hover": {
                    "color": "@listTitleHoverColor"
                  }
                },
                ".list-item-text": {
                  "padding-top": "10px",
                  "color": "@infoColor",
                  "margin-bottom": "0"
                }
              },
              ".list-block.last": {
                "border-bottom": "none",
                "margin-bottom": "20px",
                "padding-bottom": "0"
              },
              ".social": {
                "font-size": "1.2rem",
                "span": {
                  "margin-right": "11.2px",
                  "margin-bottom": "8px",
                  "transition": "0.3s all",
                  "color": "@socIconsColor",
                  "&:hover": {
                    "color": "@socIconsHover",
                    "transition": "0.3s all"
                  }
                }
              }
            },
            ".card-img": {
              "display": "none",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "text-align": "left"
            },
            "& when (@showIcons)": {
              ".list-block": {
                "position": "relative",
                "& h4, p": {
                  "padding-left": "2.625rem"
                }
              },
              ".card-img": {
                "display": "block"
              }
            },
            "& when (@customStyle)": {
              "input, textarea": {
                "border-radius": "3px",
                "min-height": "3rem",
                "padding": "13px 20px !important",
                "font-size": "13px",
                "color": "@successColor",
                "height": "60px"
              },
              ".form-control, .field-input": {
                "padding": "13px 20px !important",
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none",
                "&:hover, &:focus": {
                  "background-color": "@fieldHover",
                  "border-color": "@borderHover",
                  "color": "contrast(@fieldColor)",
                  "box-shadow": "none",
                  "outline": "none"
                },
                "&:focus": {
                  "box-shadow": "0 2px 9px 2px rgba(0, 0, 0, 0.15)"
                }
              },
              "input::-webkit-input-placeholder, textarea::-webkit-input-placeholder": {
                "color": "@formPlaceholder"
              },
              "input:-moz-placeholder, textarea:-moz-placeholder": {
                "color": "@formPlaceholder"
              },
              ".jq-selectbox li, .jq-selectbox li": {
                "background-color": "@fieldColor",
                "color": "contrast(@fieldColor)"
              },
              ".jq-selectbox li:hover, .jq-selectbox li.selected": {
                "background-color": "@fieldHover",
                "color": "contrast(@fieldHover)"
              },
              ".jq-selectbox:hover .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldColor"
              },
              ".jq-selectbox .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldHover"
              }
            },
            ".mbr-form": {
              "max-width": "550px",
              ".content-title": {
                "color": "@primaryColor",
                "margin-bottom": "20px"
              },
              ".content-subtitle": {
                "color": "@infoColor"
              },
              "textarea": {
                "min-height": "100px",
                "height": "194px"
              },
              ".btn": {
                "justify-content": "space-between",
                "border-radius": "30px",
                "border-color": "@primaryColor",
                "color": "@primaryColor",
                "padding": "18px 42px",
                "margin": "0 !important",
                "margin-top": "7px !important"
              },
              ".btn-success": {
                "&:hover": {
                  "background-color": "@secondaryColor !important",
                  "border-color": "@secondaryColor !important",
                  "color": "#fff !important"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".mbr-form": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              ".mbr-section-title, .content-title, .mbr-section-btn": {
                "text-align": "left"
              }
            }
          },
          "_name": "form2",
          "_customHTML": "<section class=\"form2\" group=\"Forms & Maps\" plugins=\"formstyler, datepicker\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Contacts Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" checked>\n        <input type=\"color\" name=\"listTitleHoverColor\" title=\"List Hover Color\" value=\"#279e64\" condition=\"showListTitle\">\n        <input type=\"checkbox\" title=\"List Text\" name=\"showListText\">\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\">\n        <select title=\"List items\" name=\"listItemsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <select title=\"Social Icons\" name=\"socialIconsCount\" condition=\"showSocialIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Form Title\" name=\"showFormTitle\">\n        <input type=\"checkbox\" title=\"Form Text\" name=\"showFormText\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <header>Style</header>\n        <input type=\"color\" name=\"socIconsColor\" title=\"Soc icons\" value=\"#13287d\" condition=\"showSocialIcons\">\n        <input type=\"color\" name=\"socIconsHover\" title=\"Soc icons hover\" value=\"#279e64\" condition=\"showSocialIcons\">\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#dcdfe2\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#279e64\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#6d7a8c\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#eff2f7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay&&bg.type=='image')\"></div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 mb-5 text-content\">\n\n                <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".text-content .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-4\">Get in touch</h3>\n                <h2 class=\"mbr-section-title align-left mbr-bold mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\" data-app-selector=\".text-content .mbr-section-title\">Have more questions?</h2>\n                <p class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .mbr-text\" mbr-if=\"showText\">Lorem\n                    ipsum\n                    dolor sit amet, consectetur adipiscing elit. Etiam dignissim quis mi eu tristique. Cras et\n                    massa erat. Quisque tempus, dolor sit amet ultrices mattis.</p>\n                <div class=\"list-block mt-5\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-mobile mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">020 8653 8538</h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">24/7 Support\n                        <br> Call Us\n                    </p>\n                </div>\n                <div class=\"list-block\" mbr-if=\"listItemsAmount > 1\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-pin mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">SVS House, Oliver Grove<div><br></div><div>South Norwood, London SE25 6EJ</div></h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">Find Us\n                        Location</p>\n                </div>\n                <div class=\"list-block last\" mbr-if=\"listItemsAmount > 2\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-letter mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">\n                        info@accountancygroup.com</h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">\n                        Email</p>\n                </div>\n                <div class=\"social mt-4\" mbr-if=\"showSocialIcons\">\n                    <span mbr-icon class=\"mbr-iconfont fa-facebook-square fa\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-twitter-square fa\" mbr-if=\"socialIconsCount > 1\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-linkedin-square fa\" mbr-if=\"socialIconsCount > 2\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-instagram fa\" mbr-if=\"socialIconsCount > 3\"></span>\n                </div>\n            </div>\n            <div mbr-form class=\"col-lg-6 mx-auto mbr-form\" mbr-class=\"{'order-2': reverseContent}\">\n<!--Formbuilder Form-->\n<form action=\"info@accountancygroup.com\" name=\"AG form\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! We will be in touch shortly.</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-6 form-group\" data-for=\"first-name\">\n<input type=\"text\" name=\"first-name\" placeholder=\"Your Name*\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 form-group\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"Your Email*\" data-form-field=\"email\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div data-for=\"message\" class=\"col-lg-12 form-group\">\n<textarea name=\"message\" placeholder=\"Your Comment*\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-lg-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"btn btn-success btn-form btn-lg\">Send message</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sniQzdXwgQ",
          "_anchor": "form2-az",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n   <iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2489.2551749788176!2d-0.07918208404939583!3d51.39836587961745!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48760124bec86a13%3A0xdcbc8f030c5ca84e!2sAccountancy%20Group%20Plc!5e0!3m2!1sen!2suk!4v1603050927076!5m2!1sen!2suk\" width=\"100%\" height=\"450\" frameborder=\"0\" style=\"border:0;\" allowfullscreen=\"\" aria-hidden=\"false\" tabindex=\"0\"></iframe>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "cleanm4",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_params": {},
          "_anchor": "custom-html-b0"
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".navbar-logo": {
              "width": "100px",
              "margin-bottom": "10px",
              "margin": "auto"
            },
            ".navbar-brand": {
              "margin": "auto",
              "width": "100%",
              "text-align": "center"
            },
            ".socicon": {
              "font-size": "1.3rem",
              "background": "@Icons",
              "border-radius": "100%",
              "width": "40px",
              "height": "40px",
              "display": "flex",
              "-webkit-align-items": "center",
              "align-items": "center",
              "-webkit-justify-content": "center",
              "justify-content": "center"
            },
            ".social-list": {
              "padding-left": "0",
              "margin-bottom": "0",
              "list-style": "none",
              ".soc-item": {
                "display": "inline-block",
                "margin": "0 0.3rem"
              }
            },
            ".text2": {
              "color": "#000000",
              "text-align": "left"
            },
            ".group-title": {
              "text-align": "left",
              "color": "#000000",
              "padding-bottom": "0.2rem"
            },
            ".logo-title": {
              "text-align": "center"
            },
            ".logo-sub-title": {
              "text-align": "center"
            },
            ".links": {
              "text-align": "center",
              "color": "#656565"
            },
            ".logo-sub-title i": {
              "color": "#9e9e9e"
            },
            ".links, .social-list": {
              "color": "#0a1126"
            }
          },
          "_name": "extFooter26",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"extFooter\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <select title=\"Icons\" name=\"iconsCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showlogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Sub Title\" name=\"showSub\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Color</header>\n        <input type=\"color\" value=\"#e9e9e9\" name=\"Icons\" title=\"Icon\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-lg-6 col-md-8 col-sm-12\">\n\n                <div class=\"navbar-brand pb-3\" mbr-if=\"showlogo\">\n                    <div class=\"logo\">\n                        <a href=\"https://mobiri.se\">\n                            <img class=\"navbar-logo\" src=\"@PROJECT_PATH@/assets/images/logo.svg\" alt=\"Mobirise\">\n                        </a>\n                    </div>\n                </div>\n\n                <h3 mbr-if=\"showTitle\" class=\"mbr-text mbr-bold mbr-fonts-style logo-title\" mbr-theme-style=\"display-7\" data-app-selector=\".logo-title, .logo\">Company\n                    Name\n                </h3>\n\n                <h4 mbr-if=\"showSub\" class=\"mbr-text mbr-fonts-style logo-sub-title\" mbr-theme-style=\"display-4\" data-app-selector=\".logo-sub-title\"><i>University</i></h4>\n\n\n\n                <div class=\"social-list align-center py-4\" mbr-if=\"iconsCount > 0\">\n                    <div class=\"soc-item\" mbr-if=\"iconsCount > 0\">\n                        \n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-twitter socicon\" style=\"color: rgb(255, 124, 0); fill: rgb(255, 124, 0);\"></div>\n                        \n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>1\">\n                        \n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\" style=\"color: rgb(255, 124, 0); fill: rgb(255, 124, 0);\"></div>\n                        \n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>2\">\n                        <a href=\"https://plus.google.com/u/0/+Mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-googleplus socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>3\">\n                        <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-skype socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>4\">\n                        <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>5\">\n                        <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                </div>\n                <p mbr-if=\"showText\" class=\"mbr-text mbr-normal py-2 links mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".links, .social-list\">Copyright © 2022 - 23 - Accountancy Group<br>All Rights Reserved. Site by - <a href=\"https://www.trafik.design\" class=\"text-warning text-primary\" target=\"_blank\">Trafik.Design</a></p>\n\n            </div>\n\n\n\n\n\n\n\n\n\n        </div>\n    </div>\n\n</section>",
          "_cid": "sniQzeGCie",
          "_anchor": "extFooter26-b1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".navbar": {
              "padding": "0.5rem 0",
              "background": "@menuBgColor",
              "transition": "none",
              "min-height": "50px"
            },
            ".navbar-fixed-top": {
              "padding-top": "0"
            },
            ".navbar-collapse": {
              "flex-basis": "auto",
              "transition": "all 0.3s ease-in",
              "&.show": {
                "position": "absolute",
                "opacity": "1",
                "visibility": "visible",
                "top": "100%",
                "z-index": "999",
                "background-color": "rgb(255, 255, 255)",
                "border-top": "1px solid rgba(0, 0, 0, 0.08)",
                "padding": "15px 20px",
                "bottom": "auto",
                "left": "0px",
                "right": "0px",
                ".navbar-nav": {
                  ".nav-item": {
                    "text-align": "left",
                    "padding": "10px 0"
                  }
                }
              }
            },
            ".navbar-buttons when (@showButtons)": {
              "flex-wrap": "wrap"
            },
            ".menu-logo": {
              ".navbar-brand": {
                "display": "flex",
                "margin-left": "1.5rem",
                "padding": "0.5rem 0",
                "transition": "padding 0.2s",
                "min-height": "3.8rem",
                "align-items": "center",
                ".navbar-caption-wrap": {
                  "display": "flex",
                  "align-items": "center",
                  "word-break": "break-word",
                  "min-width": "7rem",
                  "margin": "0.3rem 0",
                  ".navbar-caption": {
                    "padding-right": "2rem"
                  }
                },
                ".navbar-logo": {
                  "font-size": "4rem",
                  "transition": "font-size 0.25s",
                  "& img": {
                    "display": "flex"
                  },
                  ".mbr-iconfont": {
                    "transition": "font-size 0.25s"
                  }
                }
              }
            },
            ".menu-content-top": {
              "background": "@menutopColor",
              "max-width": "100%",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "0 2rem",
              "width": "100%",
              "align-items": "center",
              "overflow": "hidden",
              "transition": "min-height 0.25s ease-in-out",
              ".right-wrap": {
                ".info-widget:last-child": {},
                ".info-widget": {
                  "& when (@widgetCount = '2')": {
                    "&:nth-child(2)": {
                      "padding-right": "0 !important"
                    }
                  }
                },
                ".info-widget:first-child": {
                  "padding-left": "0",
                  "border-left": "none"
                }
              }
            },
            ".dropdown-item": {
              "font-weight": "400",
              "margin": "0 !important",
              "padding": "0 40px !important",
              "line-height": "2.6"
            },
            ".dropdown-item, .nav-link, .brand-name": {
              "font-style": "normal",
              "&:hover": {
                "color": "@hoverItemsColor !important"
              }
            },
            ".dropdown-menu": {
              "background-color": "@drColor"
            },
            ".dropdown-item:active": {
              "background-color": "@drColor"
            },
            ".menu-bottom": {
              "margin": "auto",
              "width": "100%",
              "display": "flex",
              "padding": "0rem 2rem",
              "position": "relative",
              "align-items": "center",
              "& when (@menuAlign = \"center\")": {
                "justify-content": "center"
              },
              "& when (@menuAlign = \"right\")": {
                "justify-content": "flex-end"
              }
            },
            ".navbar-dropdown.bg-color.transparent.opened": {
              "background": "@menuBgColor"
            },
            ".nav-item": {
              "position": "relative",
              "& span": {
                "padding-right": "0.4em",
                "vertical-align": "text-bottom",
                "position": "relative",
                "top": "-0.2em",
                "text-decoration": "none"
              },
              ".nav-link": {
                "transition": "all 0.3s ease-in-out 0ms",
                "&:focus": {
                  "outline": "none"
                }
              }
            },
            "@media (min-width: 991px)": {
              ".nav-link": {
                "line-height": "6.13"
              },
              ".navbar-nav > li > a:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "-1px",
                "left": "0",
                "width": "0",
                "margin": "auto",
                "opacity": "0",
                "border-top": "2px solid @hoverLineColor",
                "transition": "all 0.3s ease-in-out 0ms"
              },
              ".navbar-nav > li:hover > a:before": {
                "opacity": "1",
                "width": "100%"
              },
              ".dropdown-item": {
                "color": "@infoColor !important",
                "border-bottom": "0px solid @drbrColor"
              }
            },
            ".dropdown-item:before": {
              "font-family": "MobiriseIcons !important",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".content-text": {
              "margin-bottom": "0"
            },
            ".navbar-nav": {
              "position": "relative",
              "flex-direction": "row",
              "@media (min-width: 992px)": {
                ".main-menu-animated-line": {
                  "position": "absolute",
                  "left": "0",
                  "width": "0",
                  "height": "0",
                  "z-index": "100",
                  "border-top": "4px solid @primaryColor",
                  "transition": "width 0.4s, left 0.6s cubic-bezier(0.19, 0.65, 0.02, 0.93)",
                  "&.bottom": {
                    "bottom": "0"
                  }
                }
              },
              ".nav-item span": {
                "padding-right": "0"
              },
              ".nav-item .link": {
                "margin": "0 20px !important"
              }
            },
            ".navbar-buttons.mbr-section-btn": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".menu .navbar-brand .logo-text-part": {
              "vertical-align": "top"
            },
            ".content-right-side": {
              "text-align": "center"
            },
            ".content-right-side .content-link": {
              "margin-left": "2rem",
              "span": {
                "vertical-align": "middle",
                "padding-right": "1rem"
              }
            },
            ".widget-icon": {
              "display": "inline-block",
              "padding-right": "1rem",
              "font-size": "1.65rem",
              "&.mobi-mbri-phone": {
                "-webkit-animation": "phone-icon-animate 1s ease-in-out infinite",
                "animation": "phone-icon-animate 1s ease-in-out infinite"
              },
              "color": "@secondaryColor"
            },
            ".info-widget": {
              "margin-left": "60px",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "&:first-child": {
                "margin-left": "0"
              }
            },
            ".widget-content": {
              "display": "inline-block",
              "vertical-align": "top",
              "text-align": "left",
              ".widget-title": {
                "margin-bottom": "3px",
                "line-height": "1.7"
              },
              ".widget-text": {
                "margin-bottom": "0"
              }
            },
            ".navbar .menu-content-top": {
              "display": "flex",
              "height": "90px",
              "border-bottom": "1px solid #e1e3e6"
            },
            "@media (min-width: 992px)": {
              ".content-right-side": {
                "text-align": "right",
                "flex-wrap": "nowrap",
                "display": "flex",
                "align-items": "center"
              },
              ".navbar": {
                "display": "block",
                "padding": "0",
                ".menu-logo": {
                  "margin": "auto",
                  "display": "flex",
                  "align-items": "center"
                }
              },
              ".navbar.navbar-toggleable-sm .navbar-collapse .navbar-nav .nav-item": {
                "align-self": "auto",
                "display": "flex",
                "align-items": "center",
                "z-index": "101",
                "min-height": "49px"
              },
              ".dropdown-item:hover:before": {
                "transform": "scale(1, 1)",
                "width": "16px",
                "-webkit-transform": "scale(1, 1)"
              },
              ".navbar-toggler": {
                "display": "none"
              },
              ".navbar-collapse": {
                "& when (@menuAlign = \"center\")": {
                  "justify-content": "center"
                },
                "& when (@menuAlign = \"right\")": {
                  "justify-content": "flex-end"
                },
                "& when (@menuAlign = \"left\")": {
                  "justify-content": "flex-start"
                }
              }
            },
            ".navbar-short .menu-content-top": {
              "height": "0",
              "min-height": "0",
              "border": "none"
            },
            ".btn": {
              "display": "-webkit-inline-flex",
              "align-items": "center",
              "-webkit-align-items": "center",
              "position": "relative",
              "overflow": "hidden",
              "margin-right": "0",
              "&-sm": {
                "padding": "13px 29px"
              },
              ".mbr-iconfont": {
                "font-size": "1.2em"
              },
              "&::after": {
                "background-color": "@infoColor",
                "content": "\"\"",
                "height": "150px",
                "left": "-75px",
                "position": "absolute",
                "top": "-60px",
                "transform": "rotate(35deg)",
                "transition": "all 1.5s cubic-bezier(0.19, 1, 0.22, 1)",
                "width": "40px",
                "opacity": "0",
                "outline": "none",
                "text-decoration": "none"
              },
              "&:hover": {
                "&::after": {
                  "left": "250px",
                  "opacity": "0.8"
                }
              }
            },
            ".navbar-toggleable-sm .navbar-collapse": {
              "width": "auto",
              ".navbar-nav": {
                "flex-wrap": "wrap",
                "padding-left": "0",
                ".nav-item": {
                  "align-self": "center"
                }
              },
              ".navbar-buttons": {
                "padding-left": "0",
                "padding-bottom": "0"
              }
            },
            ".dropdown": {
              ".dropdown-menu": {
                "display": "none",
                "position": "absolute",
                "@media (max-width: 991px)": {
                  "overflow": "hidden"
                },
                "padding": "25px 0",
                "text-align": "left",
                ".dropdown-item": {
                  "width": "auto",
                  "transition": "all 0.25s ease-in-out",
                  "&::after": {
                    "right": "0.5rem"
                  },
                  "&:hover": {
                    ".mbr-iconfont:before": {
                      "transform": "scale(0, 1)"
                    }
                  },
                  ".mbr-iconfont": {
                    "margin-left": "-1.8rem",
                    "padding-right": "1rem",
                    "font-size": "inherit",
                    "&:before": {
                      "display": "inline-block",
                      "transform": "scale(1, 1)",
                      "transition": "all 0.25s ease-in-out"
                    }
                  }
                },
                ".dropdown-submenu": {
                  "margin": "0"
                }
              },
              "&.open > .dropdown-menu": {
                "display": "block"
              }
            },
            ".navbar.navbar-short": {
              "min-height": "50px",
              "transition": "all 0.2s",
              "& .navbar-logo a": {
                "font-size": "2.5rem !important",
                "transition": "font-size 0.25s",
                "& .mbr-iconfont": {
                  "font-size": "2.5rem !important"
                },
                "& img": {
                  "height": "3rem !important"
                }
              },
              "& .navbar-brand": {
                "min-height": "3rem"
              }
            },
            "button.navbar-toggler": {
              "width": "31px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "margin": "1rem 0.8rem",
              "margin-right": "0",
              "&:focus": {
                "outline": "none"
              },
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              },
              ".btn": {
                "display": "flex"
              },
              ".navbar-collapse": {
                "display": "none !important",
                "padding-right": "0 !important",
                "&.collapsing, &.show": {
                  "display": "block !important",
                  ".navbar-nav": {
                    "display": "block",
                    "text-align": "center",
                    ".nav-item": {
                      "clear": "both",
                      "& when (@showButtons = false)": {
                        "&:last-child": {
                          "margin-bottom": "1rem"
                        }
                      }
                    }
                  },
                  ".navbar-buttons": {
                    "display": "flex",
                    "justify-content": "center",
                    "text-align": "center",
                    "&:last-child": {
                      "margin-bottom": "1rem"
                    }
                  }
                }
              },
              "@media (min-width: 992px)": {
                ".dropdown .dropdown-menu": {
                  "overflow": "hidden"
                }
              },
              "button.navbar-toggler": {
                "display": "block"
              },
              ".navbar-brand": {
                "margin-left": "1rem !important",
                "margin-top": "0.5rem"
              },
              ".navbar-toggleable-sm": {
                "flex-direction": "column"
              },
              ".dropdown": {
                ".dropdown-menu": {
                  "width": "100%",
                  "text-align": "center",
                  "position": "relative",
                  "opacity": "0",
                  "display": "block",
                  "height": "0",
                  "visibility": "hidden",
                  "padding": "0",
                  "transition-duration": "0.5s",
                  "transition-property": "opacity, padding, height"
                },
                "&.open > .dropdown-menu": {
                  "position": "relative",
                  "opacity": "1",
                  "height": "auto",
                  "padding": "1.4rem 0",
                  "visibility": "visible"
                },
                ".dropdown-submenu": {
                  "left": "0",
                  "text-align": "center",
                  "width": "100%"
                },
                ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after": {
                  "margin-top": "0",
                  "position": "inherit",
                  "right": "0",
                  "top": "50%",
                  "display": "inline-block",
                  "width": "0",
                  "height": "0",
                  "margin-left": "0.3em",
                  "vertical-align": "middle",
                  "content": "\"\"",
                  "border-top": "0.3em solid",
                  "border-right": "0.3em solid transparent",
                  "border-left": "0.3em solid transparent"
                }
              },
              ".menu-bottom": {
                "justify-content": "center"
              }
            },
            "@media (max-width: 991px)": {
              ".dropdown-menu": {
                "margin-top": "0px",
                "background-color": "transparent",
                "color": "black !important",
                "padding-left": "20px !important",
                ".dropdown-item": {
                  "text-align": "left",
                  "font-weight": "700"
                }
              },
              ".menu-bottom": {
                "display": "flex",
                "flex-direction": "row",
                "justify-content": "space-between",
                "align-items": "center",
                "margin": "0",
                ".menu-content-right": {
                  "display": "none"
                }
              },
              ".navbar-collapse": {
                "padding-bottom": "1rem",
                "display": "none !important",
                "padding-right": "0 !important",
                "opacity": "0",
                "transition": "all 0.3s ease-in",
                "position": "absolute",
                "top": "100%",
                "bottom": "auto",
                "left": "0px",
                "right": "0px",
                "z-index": "999",
                ".navbar-nav": {
                  ".nav-item": {
                    "clear": "both",
                    "text-align": "left",
                    "padding": "10px 0"
                  }
                },
                "&.collapsing, &.show": {
                  "display": "block !important",
                  ".navbar-nav": {
                    "display": "block",
                    "text-align": "center",
                    ".nav-item": {
                      "clear": "both",
                      "& when (@showButtons = false)": {
                        "&:last-child": {
                          "margin-bottom": "1rem"
                        }
                      },
                      ".nav-link": {
                        "font-weight": "700"
                      }
                    }
                  },
                  ".navbar-buttons": {
                    "display": "-webkit-flex",
                    "justify-content": "center",
                    "text-align": "center",
                    "-webkit-justify-content": "center",
                    "&:last-child": {
                      "margin-bottom": "1rem"
                    }
                  }
                }
              },
              "img": {
                "height": "3.8rem !important"
              },
              ".btn": {
                "display": "flex"
              },
              "button.navbar-toggler": {
                "display": "block"
              },
              ".navbar-brand": {
                "margin-left": "1rem !important",
                "margin-top": "0.5rem"
              },
              ".navbar-toggleable-sm": {
                "flex-direction": "column"
              },
              ".dropdown": {
                ".dropdown-menu": {
                  "width": "100%",
                  "text-align": "center",
                  "position": "relative",
                  "opacity": "0",
                  "display": "block",
                  "height": "0",
                  "visibility": "hidden",
                  "padding": "0",
                  "transition-duration": "0.5s",
                  "transition-property": "opacity, padding, height"
                },
                "&.open > .dropdown-menu": {
                  "position": "relative",
                  "opacity": "1",
                  "height": "auto",
                  "padding": "1.4rem 0",
                  "visibility": "visible"
                },
                ".dropdown-submenu": {
                  "left": "0",
                  "text-align": "center",
                  "width": "100%"
                },
                ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after": {
                  "margin-top": "0",
                  "position": "inherit",
                  "right": "0",
                  "top": "50%",
                  "display": "inline-block",
                  "width": "0",
                  "height": "0",
                  "margin-left": "0.3em",
                  "vertical-align": "middle",
                  "content": "\"\"",
                  "border-top": "0.3em solid",
                  "border-right": "0.3em solid transparent",
                  "border-left": "0.3em solid transparent"
                }
              },
              ".navbar-buttons.mbr-section-btn": {
                "width": "100%"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar-toggler": {
              "position": "relative"
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "color": "initial"
            },
            ".widget-title": {
              "color": "@infoColor"
            },
            ".widget-text": {
              "color": "@infoColor"
            },
            ".icons-menu": {
              "flex-wrap": "wrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "text-align": "center",
              "align-items": "center",
              ".mbr-iconfont": {
                "font-size": "1rem",
                "color": "@primaryColor",
                "display": "inline-flex",
                "background-color": "@iconsBgColor",
                "border-radius": "100%",
                "transition": "all 0.3s ease-in",
                "&:before": {
                  "padding": ".75rem"
                },
                "&:hover": {
                  "color": "@iconsHoverolor",
                  "background-color": "@iconsHoverBgColor",
                  "-webkit-animation-name": "animation-pulse",
                  "animation-name": "animation-pulse",
                  "-webkit-animation-duration": "1s",
                  "animation-duration": "1s",
                  "-webkit-animation-timing-function": "linear",
                  "animation-timing-function": "linear",
                  "-webkit-animation-iteration-count": "infinite",
                  "animation-iteration-count": "infinite",
                  "opacity": ".9"
                }
              }
            },
            ".soc-item": {
              "margin": ".5rem .3rem"
            },
            "@media (max-width: 768px)": {
              ".menu-content-top": {
                ".icons-menu": {
                  "padding-left": "0",
                  ".soc-item": {
                    ".mbr-iconfont": {
                      "font-size": "14px",
                      "&::before": {
                        "padding": "0.44rem"
                      }
                    }
                  }
                },
                ".right-wrap": {
                  ".info-widget": {
                    "margin-left": "20px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    ".widget-content": {
                      "display": "none"
                    },
                    ".widget-icon": {
                      "font-size": "25px",
                      "padding-right": "0"
                    }
                  }
                }
              },
              ".navbar-brand": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 576px)": {
              ".menu-content-top, .menu-bottom": {
                "padding": "0 15px"
              },
              "button.navbar-toggler": {
                "align-self": "center"
              }
            },
            "@-webkit-keyframes phone-icon-animate": {
              "0%, 100%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              },
              "10%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "20%, 40%": {
                "transform": "rotate(20deg) scale(1) skew(1deg)"
              },
              "30%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "50%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              }
            },
            "@keyframes phone-icon-animate": {
              "0%, 100%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              },
              "10%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "20%, 40%": {
                "transform": "rotate(20deg) scale(1) skew(1deg)"
              },
              "30%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "50%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              }
            },
            "@-webkit-keyframes animation-pulse": {
              "25%": {
                "transform": "scale(1.1)"
              },
              "75%": {
                "transform": "scale(0.9)"
              }
            },
            "@keyframes animation-pulse": {
              "25%": {
                "transform": "scale(1.1)"
              },
              "75%": {
                "transform": "scale(0.9)"
              }
            },
            ".widget-title, .widget-icon": {
              "color": "#0239b6"
            }
          },
          "_name": "menu2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"menu2 menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global always-top position-absolute once=\"menu\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"0\">0</option>\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <select title=\"Widget Count\" name=\"widgetCount\">\n            <option value=\"0\">0</option>\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <select title=\"Menu Align\" name=\"menuAlign\">\n            <option value=\"left\">Left</option>\n            <option value=\"center\">Center</option>\n            <option value=\"right\" selected>Right</option>\n        </select>\n\n\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.5\" value=\"4\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Top Menu\" name=\"menutopColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown Border\" name=\"drbrColor\" value=\"#4f5b77\">\n        <input type=\"color\" title=\"Hover Items\" name=\"hoverItemsColor\" value=\"#ff7c00\">\n        <input type=\"color\" title=\"Hover Line\" name=\"hoverLineColor\" value=\"#279e64\">\n        <input type=\"color\" title=\"Icons Bg\" name=\"iconsBgColor\" value=\"#eaebee\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Bg Hover\" name=\"iconsHoverBgColor\" value=\"#279e64\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Hover\" name=\"iconsHoverolor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#1b1a1a\">\n\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\" mbr-if=\"widgetCount > 0 &amp;&amp; iconsAmount > 0\">\n            <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                <div class=\"soc-item\">\n                    <a href=\"https://twitter.com/Ruvas\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 1\">\n                    <a href=\"https://www.facebook.com/AccountancyGroup?ref=hl\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 2\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 3\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 4\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-googleplus\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 5\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-behance\"></span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"right-wrap d-flex align-items-center\">\n                <div class=\"info-widget\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mdi-communication-business\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">How we can help</p>\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"Covid-19.html\" class=\"text-primary\" style=\"font-weight: bold;\">Covid 19</a>&nbsp;<b>&amp; Brexit</b></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 1\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">Need help?</p>\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><b>020 8653 8538</b><br></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 2\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">Email</p>\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><b>info@accountancygroup.com</b></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"menu-bottom\">\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-with-tagline.svg\" alt=\"AG logo\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-5\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\">\n                        <a href=\"https://mobiri.se\" class=\"brand-name text-primary mbr-bold\" data-app-selector=\".brand-name\" data-app-placeholder=\"Type Text\">CleanM4</a>\n                    </span>\n                </div>\n            </div>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish&&!showBrand&&!showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link text-black text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            Home</a>\n                    </li>\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"true\">Your Business</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item text-black text-primary\" href=\"Retail-and-wholesale.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Retail &amp; wholesale</a>\n                            <a class=\"dropdown-item text-black text-primary\" href=\"Healthcare.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Healthcare</a>\n                            <a class=\"dropdown-item text-black text-primary\" href=\"Hospitality.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Hospitality</a><a class=\"dropdown-item text-black text-primary\" href=\"Property.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Property</a><a class=\"dropdown-item text-black text-primary\" href=\"Construction.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Construction</a><a class=\"dropdown-item text-black text-primary\" href=\"Contractors.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Contractors</a><a class=\"dropdown-item text-black text-primary\" href=\"Professionals.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Professional services</a>\n                        </div>\n                    </li>\n                    \n                    \n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link text-black text-primary\" href=\"Who-we-are.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"true\">\n                            Who we are</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            Contact us</a>\n                    </li></ul>\n            </div>\n            <div class=\"menu-content-right\">\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-success\" href=\"index.html#custom-html-8w\" data-app-placeholder=\"Type Text\">FREE Consultation</a></div>\n            </div>\n            <button class=\"navbar-toggler \" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n        </div>\n    </nav>\n</section>",
          "_isUserblock": true,
          "_cid": "sniQzf1LV3",
          "_anchor": "menu2-b2",
          "_protectedParams": [],
          "_global": true,
