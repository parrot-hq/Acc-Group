    "Retail-and-wholesale.html": {
      "settings": {
        "title": "Retail-and-wholesale",
        "meta_descr": "Accounting for Retail - Petrol stations, shops",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": 1
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "font-weight": "500"
            },
            ".content-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "color": "#ffffff",
              "margin-left": "0.6rem",
              "span": {
                "margin-right": "15px",
                "margin-left": "20px",
                "padding": "10px",
                "border-radius": "100%",
                "color": "@primaryColor",
                "background-color": "#ffffff",
                "font-size": "2.475rem"
              }
            },
            ".mbr-section-btn": {
              "display": "flex",
              ".btn": {
                "font-weight": "700 !important"
              }
            },
            ".video-wrap": {
              "cursor": "pointer",
              "margin-left": "30px",
              ".mbr-media": {
                "z-index": "70",
                "height": "100%",
                "-o-object-fit": "cover",
                "object-fit": "cover",
                "background-repeat": "no-repeat",
                "background-size": "cover",
                "cursor": "pointer"
              },
              ".mbr-media span": {
                "font-size": "20px",
                "cursor": "pointer",
                "display": "inline-block",
                "transition": "all 0.25s",
                "color": "@iconColor",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              ".icon-wrap": {
                "background-color": "@bgIconColor",
                "width": "3.7em",
                "height": "3.7em",
                "border-radius": "50%",
                "max-width": "100% !important",
                "text-align": "center",
                "display": "inline-block",
                "border": "2px solid transparent",
                "box-sizing": "content-box",
                "position": "relative",
                ".line-video-1, .line-video-2": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "border": "2px solid rgba(255, 255, 255, 0.8)",
                  "border-radius": "50%",
                  "animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation": "squares 2.4s linear 0s infinite",
                  "-ms-animation": "squares 2.4s linear 0s infinite",
                  "-o-animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation-play-state": "running",
                  "animation-play-state": "running",
                  "opacity": "0"
                },
                ".line-video-2": {
                  "-webkit-animation-delay": "1.2s",
                  "animation-delay": "1.2s"
                }
              },
              ".mbr-text": {
                "color": "#ffffff",
                "font-weight": "700"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "calc(80vw / 1.778)",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "4vw",
              "top": "4vh",
              "color": "@successColor",
              "z-index": "5000000",
              "font-size": "37px",
              "background": "#000",
              "padding": "20px",
              "border-radius": "50%",
              "&:hover": {
                "color": "@successColor"
              }
            },
            "@media (max-width: 991px)": {
              ".separator, .sep-holder, .sep-line": {
                "display": "none !important"
              }
            },
            "@media (max-width: 768px)": {
              ".buttons-wrap": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  "justify-content": "center"
                },
                ".video-wrap": {
                  "margin-left": "0",
                  "margin-top": "25px",
                  "justify-content": "center"
                }
              }
            },
            "@-webkit-keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            "@keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            ".skew": {
              "background-image": "url(@bgImg1)",
              "background-position": "center left",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "overflow": "hidden",
              "transition": "background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s",
              "margin-top": "-140px",
              "margin-bottom": "0",
              "z-index": "8",
              "position": "absolute",
              "display": "block",
              "width": "100%",
              "bottom": "0",
              ".inner": {
                "min-height": "150px",
                "align-items": "center",
                "display": "flex",
                "margin-right": "auto",
                "margin-left": "auto",
                "position": "relative"
              }
            }
          },
          "_name": "header4",
          "_customHTML": "<section class=\"header4\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"playervimeo\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Buttons Position\" name=\"justify\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Video Button\" name=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n        <input type=\"color\" title=\"Play Icon Color\" name=\"iconColor\" value=\"#279e64\" condition=\"showVideoButton\">\n        <input type=\"color\" title=\"Play Icon Background\" name=\"bgIconColor\" value=\"#ffffff\" condition=\"showVideoButton\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=J21qu_vspfg\" condition=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Bottom Mask\" name=\"showBottmMask\" checked>\n        <input type=\"image\" title=\"Image 1\" name=\"bgImg1\" value=\"@PROJECT_PATH@/assets/images/bg-skew.png\" condition=\"showBottmMask\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/people-2594681.jpg\" title=\"Image\" selected>\n            <input type=\"color\" value=\"#13287d\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#1b1a1a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-left\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"wrap d-flex flex-column\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold align-left w-100\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><div><span style=\"font-size: 4.375rem;\">Meeting dynamic retail</span></div><div><span style=\"font-size: 4.375rem;\">&amp; wholesale needs</span><br></div></h1>\n                    <p class=\"mbr-section-subtitle mbr-bold align-left pb-1 mbr-fonts-style w-100\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        REGULAR CLEANING</p>\n                    <p class=\"mbr-text align-left mbr-fonts-style mt-4\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                         and we'll do the number crunching</p>\n                    <div class=\"buttons-wrap d-flex mt-4 w-100\" mbr-class=\"{'justify-content-start': justify == 1, 'justify-content-center': justify == 2, 'justify-content-end': justify == 3}\">\n                        <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"index.html#Calendly_html\" data-app-placeholder=\"Type Text\">FREE Business toolkit</a></div>\n                        <div class=\"video-wrap d-flex align-items-center\" mbr-if=\"showVideoButton\">\n                            <div class=\"mbr-media show-modal align-center d-flex align-items-center\" data-modal=\".modalWindow\" mbr-if=\"showVideoButton\">\n                                <div class=\"icon-wrap\" mbr-if=\"showVideoButton\">\n                                    <span mbr-icon class=\"mbr-iconfont fa-play fa\" mbr-if=\"showVideoButton\"></span>\n                                    <span class=\"line-video-animation line-video-1\"></span>\n                                    <br>\n                                    <span class=\"line-video-animation line-video-2\"></span>\n                                </div>\n                            </div>\n                            <h4 class=\"mbr-text mbr-fonts-style align-self-center ml-3 my-auto mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".video-wrap .mbr-text,.mbr-section-btn\" mbr-if=\"showVideoButton\">\n                                Our Video!\n                            </h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-arrow-down mbr-iconfont\"></i>\n        </a>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"skew\" mbr-if=\"showBottmMask\">\n        <div class=\"inner\">\n\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sdGHxsMK6r",
          "_anchor": "header4-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor",
              "text-align": "left"
            },
            "img": {
              "width": "100%"
            },
            ".mbr-text": {
              "color": "#0a1126"
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              ".btn": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".cards-wrap": {
              "flex-direction": "column"
            },
            ".wrapper": {
              "border-radius": "0.25rem",
              "margin-bottom": "26px",
              "display": "flex",
              ".img": {
                "margin-bottom": "20px",
                "margin-right": "25px",
                "background-color": "@iconBgColor",
                "width": "50px",
                "min-width": "50px",
                "height": "50px",
                "border-radius": "3px",
                "display": "inline-flex",
                "align-items": "center",
                "justify-content": "center",
                "&:hover": {
                  "-webkit-animation-name": "animation-wobble-vertical",
                  "animation-name": "animation-wobble-vertical",
                  "-webkit-animation-duration": "1s",
                  "animation-duration": "1s",
                  "-webkit-animation-timing-function": "ease-in-out",
                  "animation-timing-function": "ease-in-out",
                  "-webkit-animation-iteration-count": "1",
                  "animation-iteration-count": "1"
                },
                ".mbr-iconfont": {
                  "font-size": "1.875rem",
                  "top": "0",
                  "color": "contrast(@iconBgColor)",
                  "border-radius": "50%"
                }
              },
              ".content": {
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            ".widget-container": {
              "margin": "0 0 30px",
              ".project-info": {
                "padding": "15px 30px 13px",
                "background-color": "@widgetBgColor",
                "border-radius": "3px",
                ".info-item": {
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "padding": "17px 0",
                  "border-bottom": "1px solid @widgetBorderColor",
                  ".label": {
                    "font-weight": "500",
                    "margin-right": "10px",
                    "flex": "none",
                    "margin-bottom": "0"
                  },
                  ".info-text": {
                    "margin-bottom": "0"
                  },
                  "&:last-child": {
                    "border-bottom": "none"
                  }
                }
              }
            },
            ".newsletter": {
              "padding": "35px 30px 40px",
              "border-radius": "3px",
              "display": "block",
              ".mbr-section-subtitle": {
                "position": "relative",
                "margin-bottom": "25px",
                "color": "@primaryColor"
              },
              ".form-group, .mbr-section-btn": {
                "margin": "0",
                "padding": "0",
                "display": "-webkit-flex"
              },
              "textarea": {
                "height": "110px !important"
              },
              ".form-control": {
                "font-size": "14px",
                "background": "@inputBg",
                "color": "@inputTextColor",
                "display": "block",
                "height": "60px",
                "border-radius": "3px",
                "width": "100%",
                "padding": "13px 20px !important",
                "padding-right": "50px !important",
                "transition": "all .3s linear 0ms",
                "&::-webkit-input-placeholder": {
                  "color": "@inputTextColor"
                },
                "&::-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-ms-input-placeholder": {
                  "color": "@inputTextColor"
                }
              },
              ".form-group": {
                "margin-bottom": "8.6px"
              },
              ".dragArea": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  ".btn": {
                    "font-weight": "bold",
                    "margin-left": "0 !important",
                    "margin-right": "0 !important",
                    "position": "relative",
                    "overflow": "hidden",
                    "&.btn-success": {
                      "&:hover": {
                        "background-color": "@secondaryColor !important",
                        "border-color": "@secondaryColor !important",
                        "color": "#ffffff !important"
                      }
                    },
                    "&::after": {
                      "background-color": "@infoColor",
                      "content": "\"\"",
                      "height": "150px",
                      "left": "-75px",
                      "position": "absolute",
                      "top": "-60px",
                      "transform": "rotate(35deg)",
                      "transition": "all 1.5s cubic-bezier(0.19, 1, 0.22, 1)",
                      "width": "40px",
                      "opacity": "0",
                      "outline": "none",
                      "text-decoration": "none"
                    },
                    "&:hover": {
                      "&::after": {
                        "left": "250px",
                        "opacity": "0.8"
                      }
                    }
                  }
                }
              }
            },
            ".cards-wrap2": {
              "flex-direction": "column",
              ".wrapper2": {
                "border-radius": "0.25rem",
                "margin-bottom": "26px",
                ".img": {
                  "margin-bottom": "20px",
                  ".mbr-iconfont": {
                    "font-size": "50px",
                    "top": "0",
                    "color": "@secondaryColor",
                    "border-radius": "50%"
                  }
                },
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "padding-bottom": "14px",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            "@-webkit-keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            "@keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            ".cards-wrap .wrapper .content .mbr-text, .img": {
              "color": "#0a1126"
            },
            ".bottomPart .wrapper2 .mbr-text, .img": {
              "color": "#0a1126"
            },
            ".cards-wrap .wrapper .content .mbr-card-title, .img": {
              "color": "#ff7c00"
            }
          },
          "_name": "content6",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content6\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"7\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Widget\" name=\"showWidget\">\n        <input type=\"checkbox\" title=\"Form\" name=\"showForm\">\n        <input type=\"color\" title=\"Input BG Color\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n        <input type=\"color\" title=\"Input Text Color\" name=\"inputTextColor\" value=\"#83868c\" condition=\"showForm\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showTabText1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showTabText2\">\n        <input type=\"checkbox\" title=\"Bottom Part\" name=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icon Bg\" name=\"iconBgColor\" value=\"#279e64\" selected>\n        <header condition=\"showWidget\">Widget</header>\n        <select title=\"Items Count\" name=\"widgetItemsCount\" condition=\"showWidget\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n        </select>\n        <input type=\"color\" title=\"Bg Color\" name=\"widgetBgColor\" value=\"#eeeff2\" selected condition=\"showWidget\">\n        <input type=\"color\" title=\"Border Color\" name=\"widgetBorderColor\" value=\"#dcdfe2\" selected condition=\"showWidget\">\n\n        <header condition=\"showBottomPart\">Bottom Part</header>\n        <select title=\"Cards\" name=\"cardsAmount2\" condition=\"showBottomPart\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon2\" checked condition=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle2\" checked condition=\"showBottomPart\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText2\" checked condition=\"showBottomPart\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background2.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row main-row\">\n            <div class=\"col-md-4\">\n                <div class=\"widget-container\" mbr-if=\"showWidget\">\n                    <div class=\"project-info\">\n                        <div class=\"info-item\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Client Name:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                Cody Watson\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 1\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Category:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                Citchen Cleaning\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 2\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Location:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                25 Avenue, New York\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 3\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Date Start:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                10 July, 2025\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 4\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Date Completed:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                12 July, 2025\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 5\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Website:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                www.example.com\n                            </p>\n                        </div>\n                        <div class=\"info-item\" mbr-if=\"widgetItemsCount > 6\">\n                            <p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n                                Other Info:\n                            </p>\n                            <p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n                                Anything\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"newsletter\" mbr-if=\"showForm\">\n                    <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".newsletter .mbr-section-subtitle\">\n                        Have Any Query?\n                    </h3>\n                    <div mbr-form class=\"form1\" mbr-if=\"showForm\">\n                        <!---Formbuilder Form--->\n                        <form action=\"info@accountancygroup.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler px-2\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! We will be in touch shortly.</div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 form-group\" data-for=\"name\">\n                                    <input type=\"text\" name=\"first-name\" placeholder=\"Your Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                </div>\n                                <div class=\"form-group col\" data-for=\"email\">\n                                    <input type=\"text\" name=\"email\" placeholder=\"Telephone number\" data-form-field=\"E-mail\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\">\n                                </div>\n                                <div data-for=\"message\" class=\"col-lg-12 form-group\">\n                                    <textarea name=\"message\" placeholder=\"Your requirement\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\" value></textarea>\n                                </div>\n                                <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\">\n                                    <a type=\"submit\" class=\"btn btn-lg btn-success\">Send Message</a>\n                                </div>\n                            </div>\n                        </form>\n                        <!---Formbuilder Form--->\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-8\">\n                <h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Details\n                </h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title mbr-bold align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">\n                    Retail &amp; wholesale</h2>\n                <img src=\"../_images/img/05.jpg\" mbr-if=\"showImage\" class=\"mb-5 mt-3\">\n\n\n                <p class=\"mbr-fonts-style mbr-text mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showTabText1\" data-app-selector=\".mbr-text\">\n                    Retail and wholesale has gone through several challenging changes. This trend will continue to be dynamic with the ever changing customer needs.<br>Online suppliers are increasing to provide various goods &amp; services in wholesale and retail, not only within UK but also worldwide.<br><br>We have a wealth of expertise in supporting retail &amp; wholesale business owners with all our services throughout the year.</p>\n                <div class=\"cards-wrap d-flex mt-4\">\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 0\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-sale\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Our focus</h4>\n\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">To help our clients start, grow and succeed in their businesses</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">100% service\n                                    guarantee\n                                </h4>\n\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Safe &amp;\n                                    Effective\n                                </h4>\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-cash\"></span>\n                            </div>\n                            <div class=\"content\">\n                                <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">About\n                                    Cleaning\n                                </h4>\n                                <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Lorem ipsum dolor\n                                    amet, consecte tempor incididunt ut\n                                    labore\n                                    et\n                                    dolore tumber tur adipisicing elit.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mbr-fonts-style mbr-text mbr-regular mb-5\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText2\" data-app-selector=\".mbr-text\">\n                    Tellus in hac habitasse platea dictumst vestibulum rhoncus est pellentesque. Pharetra convallis\n                    posuere morbi leo urna molestie at elementum eu. Sed felis eget velit aliquet sagittis. Congue\n                    mauris rhoncus aenean vel elit scelerisque mauris pellentesque. Eget arcu dictum varius duis at\n                    consectetur lorem. Porttitor massa id neque aliquam vestibulum morbi blandit cursus. Nisi vitae\n                    suscipit tellus mauris a diam maecenas sed enim.&nbsp;</p>\n                <div class=\"row bottomPart\" mbr-if=\"showBottomPart\">\n                    <div class=\"col-lg-6\">\n                        <div class=\"image-wrap mb-5\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr.jpg\" alt>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <div class=\"cards-wrap2 d-flex\">\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 0\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-sale\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Vetted,\n                                        background\n                                        checked\n                                    </h4>\n\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut labore et dolore tumber tur adipisicing\n                                        elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 1\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">100% service\n                                        guarantee\n                                    </h4>\n\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 2\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Safe &amp; Effective\n                                    </h4>\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"row-item\" mbr-if=\"cardsAmount2 > 3\">\n                                <div class=\"wrapper2\">\n                                    <div class=\"img\" mbr-if=\"swIcon2\">\n                                        <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                                    </div>\n                                    <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Cleaning is...\n                                    </h4>\n                                    <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n                                        amet, consecte tempor incididunt ut\n                                        labore\n                                        et\n                                        dolore tumber tur adipisicing elit.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mbr-section-btn align-left\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Learn More</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
