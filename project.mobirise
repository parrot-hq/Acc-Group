        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@cardsAmount > 3)": {
              ".card-wrapper .card-img .meta-category": {
                "top": "165px"
              }
            },
            ".contents": {
              "text-align": "center",
              "margin-bottom": "54px",
              ".mbr-section-title": {
                "margin-bottom": "20px",
                "color": "@primaryColor"
              },
              ".mbr-subtitle": {
                "color": "@secondaryColor",
                "margin-bottom": "10px"
              },
              ".mbr-section-text": {
                "margin-top": "20px",
                "color": "@infoColor"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                "padding": "35px 30px 38px",
                "border": "1px solid @borderColor",
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500",
                  "span": {
                    "color": "@partOfDateColor"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "25px",
                  "color": "@infoColor"
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              },
              ".card-img": {
                "position": "relative",
                "overflow": "hidden",
                "img": {
                  "border": "none",
                  "border-radius": "0",
                  "box-shadow": "none",
                  "box-sizing": "border-box",
                  "vertical-align": "middle",
                  "transition": "all .8s",
                  "opacity": "1",
                  "width": "100%",
                  "max-width": "100%",
                  "margin": "auto",
                  "height": "auto",
                  "display": "block"
                },
                "&:hover": {
                  "img": {
                    "transform": "scale3d(1.05, 1.05, 1)",
                    "opacity": ".9"
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              ".card-wrapper .card-box .mbr-section-btn .link": {
                "justify-content": "center"
              }
            },
            ".contents .mbr-subtitle": {
              "color": "#1b1a1a"
            },
            ".card-wrapper .card-box .card-subtitle, .mbr-section-btn": {
              "color": "#232323"
            },
            ".card-wrapper .card-box .card-title, .mbr-section-btn": {
              "color": "#0239b6"
            },
            ".contents .mbr-section-title": {
              "color": "#0239b6"
            }
          },
          "_name": "features2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showCardSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Card Link\" name=\"showLink\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Colors</header>\n        <input type=\"color\" name=\"borderColor\" title=\"Borders\" value=\"#dcdfe2\" selected>\n        <input type=\"color\" name=\"partOfDateColor\" title=\"Date\" value=\"#83868c\" selected>\n        <input type=\"color\" name=\"iconColor\" title=\"Icons\" value=\"#13287d\" selected>\n        <input type=\"color\" name=\"iconColorHover\" title=\"Icons Hover\" value=\"#ffffff\" selected>\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Icons Hover Bg\" value=\"#279e64\" selected>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"contents\">\n\n            <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" data-app-selector=\".contents .mbr-section-title\" mbr-if=\"showMainTitle\" mbr-theme-style=\"display-2\"><span style=\"font-weight: normal;\">Meeting your bespoke needs</span></h1>\n            <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".contents .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-5\"><span style=\"font-weight: normal;\">Talk to our specialists today</span></h3>\n            <h2 class=\"mbr-section-text mbr-fonts-style mbr-regular\" data-app-selector=\".contents .mbr-section-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">Condimentum vitae sapien pellentesque habitant morbi\n                tristique senectus.\n                Nibh cras pulvinar mattis nunc.</h2>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6', 'col-lg-6': cardsAmount == '4'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Retail.html\"><img src=\"@PROJECT_PATH@/assets/images/people-2594681.jpg\" alt=\"Lady on escallator\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Petrol stations, shops</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><span style=\"font-weight: normal;\"><a href=\"Retail.html\" class=\"text-primary\">Retail</a></span><a href=\"Retail.html\" class=\"text-primary\">&nbsp;</a><span style=\"font-weight: normal;\"><a href=\"Retail.html\" class=\"text-primary\">&amp; wholesale</a></span></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Healthcare.html\"><img src=\"@PROJECT_PATH@/assets/images/running-573762.jpg\" alt=\"Running lady\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Care homes, doctors / dentists</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><a href=\"Healthcare.html\" class=\"text-primary\">Healthcare</a></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '5'|| cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Catering.html\"><img src=\"@PROJECT_PATH@/assets/images/chef-1.png\" alt=\"Chef\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Restaurants, cafes</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">\n                            <a href=\"Catering.html\" class=\"text-primary\">Catering</a>\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"false\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Office Cleaning\n                            <span>/ July 25, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Premium Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 4\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"false\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Carpet Cleaning\n                            <span>/ July 30, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Kitchen Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 5\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/09-1.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Toilet Cleaning\n                            <span>/ June 10, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Premium Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features2-1",
          "_isUserblock": true,
          "_cid": "sdGscZfDCa",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@cardsAmount > 3)": {
              ".card-wrapper .card-img .meta-category": {
                "top": "165px"
              }
            },
            ".contents": {
              "text-align": "center",
              "margin-bottom": "54px",
              ".mbr-section-title": {
                "margin-bottom": "20px",
                "color": "@primaryColor"
              },
              ".mbr-subtitle": {
                "color": "@secondaryColor",
                "margin-bottom": "10px"
              },
              ".mbr-section-text": {
                "margin-top": "20px",
                "color": "@infoColor"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                "padding": "35px 30px 38px",
                "border": "1px solid @borderColor",
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500",
                  "span": {
                    "color": "@partOfDateColor"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "25px",
                  "color": "@infoColor"
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              },
              ".card-img": {
                "position": "relative",
                "overflow": "hidden",
                "img": {
                  "border": "none",
                  "border-radius": "0",
                  "box-shadow": "none",
                  "box-sizing": "border-box",
                  "vertical-align": "middle",
                  "transition": "all .8s",
                  "opacity": "1",
                  "width": "100%",
                  "max-width": "100%",
                  "margin": "auto",
                  "height": "auto",
                  "display": "block"
                },
                "&:hover": {
                  "img": {
                    "transform": "scale3d(1.05, 1.05, 1)",
                    "opacity": ".9"
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              ".card-wrapper .card-box .mbr-section-btn .link": {
                "justify-content": "center"
              }
            },
            ".contents .mbr-subtitle": {
              "color": "#1b1a1a"
            },
            ".card-wrapper .card-box .card-subtitle, .mbr-section-btn": {
              "color": "#232323"
            },
            ".card-wrapper .card-box .card-title, .mbr-section-btn": {
              "color": "#0355ff"
            }
          },
          "_name": "features2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showCardSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Card Link\" name=\"showLink\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Colors</header>\n        <input type=\"color\" name=\"borderColor\" title=\"Borders\" value=\"#dcdfe2\" selected>\n        <input type=\"color\" name=\"partOfDateColor\" title=\"Date\" value=\"#83868c\" selected>\n        <input type=\"color\" name=\"iconColor\" title=\"Icons\" value=\"#13287d\" selected>\n        <input type=\"color\" name=\"iconColorHover\" title=\"Icons Hover\" value=\"#ffffff\" selected>\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Icons Hover Bg\" value=\"#279e64\" selected>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"contents\">\n\n            <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" data-app-selector=\".contents .mbr-section-title\" mbr-if=\"showMainTitle\" mbr-theme-style=\"display-2\">Different sectors. Bespoke needs</h1>\n            <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".contents .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-5\"><span style=\"font-weight: normal;\">Talk to our specialists to get started today</span></h3>\n            <h2 class=\"mbr-section-text mbr-fonts-style mbr-regular\" data-app-selector=\".contents .mbr-section-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">Condimentum vitae sapien pellentesque habitant morbi\n                tristique senectus.\n                Nibh cras pulvinar mattis nunc.</h2>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6', 'col-lg-6': cardsAmount == '4'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Hospitality.html\"><img src=\"@PROJECT_PATH@/assets/images/bed-4416515.jpg\" alt=\"Hotel Bed\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Hotels, leisure</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><a href=\"Hospitality.html\" class=\"text-primary\">Hospitality</a></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Contractors.html\"><img src=\"@PROJECT_PATH@/assets/images/coding-1853305.jpg\" alt=\"Computer screen\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">IT, oil &amp; gas</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><a href=\"Contractors.html\" class=\"text-primary\">Contractors</a></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '5'|| cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Construction.html\"><img src=\"@PROJECT_PATH@/assets/images/man1.png\" alt=\"Man cleaning windows\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Building services, support</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">\n                            <a href=\"Construction.html\" class=\"text-primary\">Construction</a>\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"false\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Office Cleaning\n                            <span>/ July 25, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Premium Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 4\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"false\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Carpet Cleaning\n                            <span>/ July 30, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Kitchen Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 5\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/09-1.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Toilet Cleaning\n                            <span>/ June 10, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Premium Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features2-2",
          "_isUserblock": true,
          "_cid": "sdGse6S67M",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@cardsAmount > 3)": {
              ".card-wrapper .card-img .meta-category": {
                "top": "165px"
              }
            },
            ".contents": {
              "text-align": "center",
              "margin-bottom": "54px",
              ".mbr-section-title": {
                "margin-bottom": "20px",
                "color": "@primaryColor"
              },
              ".mbr-subtitle": {
                "color": "@secondaryColor",
                "margin-bottom": "10px"
              },
              ".mbr-section-text": {
                "margin-top": "20px",
                "color": "@infoColor"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                "padding": "35px 30px 38px",
                "border": "1px solid @borderColor",
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500",
                  "span": {
                    "color": "@partOfDateColor"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "25px",
                  "color": "@infoColor"
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              },
              ".card-img": {
                "position": "relative",
                "overflow": "hidden",
                "img": {
                  "border": "none",
                  "border-radius": "0",
                  "box-shadow": "none",
                  "box-sizing": "border-box",
                  "vertical-align": "middle",
                  "transition": "all .8s",
                  "opacity": "1",
                  "width": "100%",
                  "max-width": "100%",
                  "margin": "auto",
                  "height": "auto",
                  "display": "block"
                },
                "&:hover": {
                  "img": {
                    "transform": "scale3d(1.05, 1.05, 1)",
                    "opacity": ".9"
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              ".card-wrapper .card-box .mbr-section-btn .link": {
                "justify-content": "center"
              }
            },
            ".contents .mbr-subtitle": {
              "color": "#1b1a1a"
            },
            ".card-wrapper .card-box .card-subtitle, .mbr-section-btn": {
              "color": "#232323"
            },
            ".card-wrapper .card-box .card-title, .mbr-section-btn": {
              "color": "#0239b6"
            }
          },
          "_name": "features2",
          "_customHTML": "<section class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showCardSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"Card Link\" name=\"showLink\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Colors</header>\n        <input type=\"color\" name=\"borderColor\" title=\"Borders\" value=\"#dcdfe2\" selected>\n        <input type=\"color\" name=\"partOfDateColor\" title=\"Date\" value=\"#83868c\" selected>\n        <input type=\"color\" name=\"iconColor\" title=\"Icons\" value=\"#13287d\" selected>\n        <input type=\"color\" name=\"iconColorHover\" title=\"Icons Hover\" value=\"#ffffff\" selected>\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Icons Hover Bg\" value=\"#279e64\" selected>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"contents\">\n\n            <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" data-app-selector=\".contents .mbr-section-title\" mbr-if=\"showMainTitle\" mbr-theme-style=\"display-2\">Different sectors. Bespoke needs</h1>\n            <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".contents .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-5\"><span style=\"font-weight: normal;\">Talk to our specialists to get started today</span></h3>\n            <h2 class=\"mbr-section-text mbr-fonts-style mbr-regular\" data-app-selector=\".contents .mbr-section-text\" mbr-if=\"showText\" mbr-theme-style=\"display-4\">Condimentum vitae sapien pellentesque habitant morbi\n                tristique senectus.\n                Nibh cras pulvinar mattis nunc.</h2>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6', 'col-lg-6': cardsAmount == '4'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Professionals.html\"><img src=\"@PROJECT_PATH@/assets/images/building-2762237.jpg\" alt=\"Builders\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Architects, Estate agents, Solicitors</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><a href=\"Professionals.html\" class=\"text-primary\">Professionals</a></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"Property.html\"><img src=\"@PROJECT_PATH@/assets/images/architecture-3383067.jpg\" alt=\"Row of houses\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Investments, buying &amp; selling</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><a href=\"Property.html\" class=\"text-primary\">Property</a></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '5'|| cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <a href=\"index.html#form2-i\"><img src=\"@PROJECT_PATH@/assets/images/avoid-penalties.png\" alt=\"Personal Tax returns deadline\"></a>\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Let's get started</h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\"><a href=\"index.html#form2-i\" class=\"text-primary\">Don't delay</a></h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Cras tempus\n                            consectetur\n                            venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/11.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Office Cleaning\n                            <span>/ July 25, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Premium Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 4\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/10.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Carpet Cleaning\n                            <span>/ July 30, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Kitchen Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 5\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/09.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn\">Toilet Cleaning\n                            <span>/ June 10, 2025</span></h5>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn\">Premium Cleaning\n                            Services\n                        </h4>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn, .mbr-section-btn\">\n                            Cras\n                            tempus consectetur venenatis.\n                            Quisque\n                            porttitor iaculis rutrum. Proin sed massa euismod, viverra lacus a, pellentesque nisi.\n                            Integer rutrum mi non est blandit rhoncus. Ut id enim est.</p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Read More<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features2-3",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "s2V9TbCQOl",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "image03",
          "_sourceTheme": "cryptom5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image3\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/cryptom5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <a href=\"https://www.trustpilot.com/review/accountancygroup.com?fbclid=IwAR1Dkj5lCP7j8cIstby6NLqJWbgEcA5ccf0iOwp6TsobdoPT8ipGJ97KWx4\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/accountancy-trustpilot-3.png\" alt></a>\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\">\n                        Image Description</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".row": {
              "flex-direction": "row-reverse"
            },
            "img": {
              "width": "100%"
            }
          },
          "_cid": "sWuCZTzuVu",
          "_anchor": "image03-bn",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "& > div": {
                "width": "100%"
              },
              "padding": "0 3rem"
            },
            ".carousel-item.active, .carousel-item-next, .carousel-item-prev": {
              "display": "flex"
            },
            ".carousel-controls": {
              "a": {
                "transition": "opacity .5s",
                "font-size": "1.2rem",
                "span": {
                  "padding": "15px",
                  "border-radius": "50%",
                  "color": "contrast(@arrowColor)",
                  "background": "@arrowColor",
                  "opacity": ".9"
                },
                "&:hover": {
                  "span": {
                    "opacity": "1"
                  }
                }
              }
            },
            ".signature,.desk": {
              "margin": "0"
            },
            ".mbr-text,.mbr-section-subtitle": {
              "color": "#efefef"
            },
            ".signature, .desk": {
              "color": "#ffffff"
            },
            "@media (min-width: 992px)": {
              ".carousel-item": {
                "padding": "0 5rem"
              }
            },
            "@media (min-width: 768px)": {
              ".carousel-controls": {
                "a": {
                  "width": "5%"
                }
              }
            },
            ".signature": {
              "color": "#ffffff"
            }
          },
          "_name": "extTestimonials16",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"carousel slide testimonials-slider extTestimonials\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" inline>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"20\" step=\"1\" value=\"2\">\n        <select name=\"columns\" title=\"Columns in Item\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n\n        <input type=\"checkbox\" title=\"Show Author Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Show Author Title\" name=\"showDesk\">\n        <!-- <input type=\"color\" title=\"Item Background\" name=\"itemBg\" value=\"#ffffff\"> -->\n        <input type=\"color\" title=\"Arrow Color\" name=\"arrowColor\" value=\"#ffffff\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background6.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#073b4c\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#0239b6\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container text-center\">\n        \n        <h3 class=\"mbr-section-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Testimonials</h3>\n\n        <h2 class=\"mbr-fonts-style mbr-section-title align-left mbr-white\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n            What clients say about us</h2>\n\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-4':showTitle || showSubtitle}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                <div class=\"carousel-item\">\n                    <div class=\"row justify-content-center\">\n                        <div class=\"col-md-4\">                          \n                            <div class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-article data-app-selector=\".mbr-text\" data-multiline><b>Catering Consultants &amp; International Recruitment Specialists for Hotel Industry</b><div>Team at Accountancy Group has assisted us with compliance with all the authorities and also with advise on tax planning and business structures. We feel they would add value to any business looking for support and advice.</div></div>\n                            <h4 class=\"mbr-fonts-style signature mbr-bold pt-3 align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\"><span style=\"font-weight: normal;\">Paolo &amp; Thomas Unitas</span></h4>                   \n                            <h5 class=\"desk mbr-fonts-style pt-3 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Manager</h5>\n                        </div>\n\n                        <div class=\"col-md-4\" mbr-if=\"columns>1\" mbr-class=\"{'d-none d-md-block': columns>1}\">\n                            <div class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-article data-app-selector=\".mbr-text\" data-multiline><b>Fast growing Environmental Services Business</b><div>We started as a new business in 2008. The services and support provided by Accountancy Group has been excellent.</div></div>\n                            <h4 class=\"mbr-fonts-style signature mbr-bold pt-3 align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\"><span style=\"font-weight: normal;\">Clearup Solutions</span></h4>       \n                            <h5 class=\"desk mbr-fonts-style pt-3 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Manager</h5>            \n                        </div>\n                        \n                        <div class=\"col-md-4\" mbr-if=\"columns>2\" mbr-class=\"{'d-none d-md-block': columns>2}\">\n                            <div class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-article data-app-selector=\".mbr-text\" data-multiline><b>Independent IT Contractor</b><div>I have been a client of Accountancy Group since 2011 and find them that their specialist knowledge as Contractors Accountants has helped me a great deal. I recommend them well.</div></div>\n                            <h4 class=\"mbr-fonts-style signature mbr-bold pt-3 align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\"><span style=\"font-weight: normal;\">Rajesh Appana&nbsp;</span></h4>\n                            <h5 class=\"desk mbr-fonts-style pt-3 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Manager</h5>                    \n                        </div>\n                    </div>\n                </div>\n            <div class=\"carousel-item\">\n                    <div class=\"row justify-content-center\">\n                        <div class=\"col-md-4\">                          \n                            <div class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-article data-app-selector=\".mbr-text\" data-multiline><div><b>Group of petrol &amp; convenience&nbsp;stores</b><br>We have been with Accountancy group for over 30yrs and highly recommend them for their professional &amp; prompt services in accountancy, taxation &amp; consultancy services</div></div>\n                            <h4 class=\"mbr-fonts-style signature mbr-bold pt-3 align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\"><span style=\"font-weight: normal;\">VS &amp; JS Group</span></h4>                   \n                            <h5 class=\"desk mbr-fonts-style pt-3 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Manager</h5>\n                        </div>\n\n                        <div class=\"col-md-4\" mbr-if=\"columns>1\" mbr-class=\"{'d-none d-md-block': columns>1}\">\n                            <div class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-article data-app-selector=\".mbr-text\" data-multiline><div><b>Hotel, retail &amp; care homes group<br></b>We have varied demands to meet in our business and the support Accountancy Group provides is invaluable to us.</div></div>\n                            <h4 class=\"mbr-fonts-style signature mbr-bold pt-3 align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\"><span style=\"font-weight: normal;\">S-Group of Businesses</span></h4>       \n                            <h5 class=\"desk mbr-fonts-style pt-3 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Manager</h5>            \n                        </div>\n                        \n                        <div class=\"col-md-4\" mbr-if=\"columns>2\" mbr-class=\"{'d-none d-md-block': columns>2}\">\n                            <div class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-article data-app-selector=\".mbr-text\" data-multiline><div><b>Builders<br></b>I run a building services business and the services I use with Accountancy Group has helped me manage and grow my business from a sole trader to a successful growing LTD company. I recommend them well.</div></div>\n                            <h4 class=\"mbr-fonts-style signature mbr-bold pt-3 align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".signature\"><span style=\"font-weight: normal;\">Z-2-Z Builders</span></h4>\n                            <h5 class=\"desk mbr-fonts-style pt-3 align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showDesk\" data-app-selector=\".desk\">Manager</h5>                    \n                        </div>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"mbri-left mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mbri-right mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sgUbjW46SM",
          "_anchor": "extTestimonials16-8v",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".container": {
              "max-width": "832px"
            },
            ".mbr-text": {
              "color": "#232323",
              "position": "relative",
              "z-index": "2",
              "width": "100%",
              "span": {
                "font-weight": "inherit",
                "line-height": "inherit",
                "color": "@coloredText"
              },
              "text-align": "center"
            }
          },
          "_name": "content2",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section class=\"content1\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Colored Text\" name=\"coloredText\" value=\"#E1965F\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/edgem5/components/_images/background7.svg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-text col-lg-{{textWidth}}\">\n                <p class=\"mbr-text mbr-fonts-style align-left mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\"><b>\n                    Certified by Xero means you get better deals </b><br><b>and faster turnarounds</b></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sXawPeeMIy",
          "_anchor": "content2-bs",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "background": "@bgColor",
            "& when (@fullWidth = false)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@fullWidth)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            ".image-block": {
              "margin": "auto",
              "img": {
                "width": "100%"
              },
              "& when (@fullWidth)": {
                "width": "100% !important"
              }
            },
            "@media (max-width: 767px)": {
              ".image-block": {
                "width": "100% !important"
              }
            },
            ".container-fluid": {
              "padding": "0"
            }
          },
          "_name": "image1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"image1 cleanm4_image1\" group=\"Images & Videos\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"0\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"4\" step=\"1\">\n\n\t\t<input type=\"range\" inline title=\"Width\" name=\"imageSize\" min=\"10\" max=\"100\" value=\"48\" step=\"1\" condition=\"fullWidth == false\">\n\t\t<header condition=\"fullWidth == false\">Background</header>\n\t\t<input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\" condition=\"fullWidth == false\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<figure class=\"mbr-figure\" mbr-class=\"{'container-fluid':fullWidth,'container':!fullWidth}\">\n\t\t<div class=\"image-block\" mbr-style=\"{'width':imageSize+'%'}\">\n\t\t\t<img src=\"@PROJECT_PATH@/assets/images/xero-logos.png\" alt>\n\t\t</div>\n\t</figure>\n</section>",
          "_cid": "st2oRUgM69",
          "_anchor": "image1-bg",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card-icon": {
              "font-size": "(@iconsSize * 8px)",
              "color": "@iconsColor",
              "transition": "color 0.3s"
            },
            ".icon2": {
              "color": "@iconsColor2"
            },
            ".card-title": {
              "font-weight": "600",
              "letter-spacing": "1px"
            },
            "p": {
              "font-weight": "400"
            },
            ".line": {
              "width": "35px",
              "height": "3px",
              "display": "inline-block",
              "background": "@lineColor",
              "margin-bottom": "1.5rem",
              "transition": "background 0.3s"
            },
            ".line2": {
              "background": "@lineColor2"
            },
            ".card-wrapper": {
              "padding": "2.5rem 2rem",
              "transition": "background 0.3s",
              "background": "@cardsBg",
              "&:hover .link-ico": {
                "background-color": "@iconsColor",
                "border-color": "@iconsColor",
                "color": "white"
              }
            },
            ".card2": {
              "background": "@cardsBg1"
            },
            ".card-title, .card-ico, .line-wrap": {
              "text-align": "center",
              "color": "#232323"
            },
            ".mbr-text, .card-link": {
              "text-align": "center",
              "color": "#232323"
            }
          },
          "_name": "extContacts1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"extContacts1\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#ffffff\" selected condition=\"showTitle\">\n        <input type=\"color\" title=\"Second Line Color\" name=\"lineColor2\" value=\"#ffffff\" selected condition=\"showTitle &amp;&amp; cardsAmount > 1\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Cards Bg\" name=\"cardsBg\" value=\"#eff2f7\">\n        <input type=\"color\" title=\"Second Cards Bg\" name=\"cardsBg1\" value=\"#e9e9e9\" condition=\"cardsAmount > 1\">\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"1\" max=\"9\" step=\"1\" value=\"7\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#efefef\" selected condition=\"showIcons\">\n        <input type=\"color\" title=\"Second Icon Color\" name=\"iconsColor2\" value=\"#ffffff\" selected condition=\"showIcons &amp;&amp; cardsAmount > 1\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center mbr-white\" mbr-cards=\"bootstrap\">\n            <div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 0\">\n                <div class=\"card-wrapper card1 align-left\">\n                    <div class=\"card-ico pb-4\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon mobi-mbri-phone mobi-mbri\" style=\"color: rgb(2, 57, 182); fill: rgb(2, 57, 182);\"></span>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\">Call us</h4>\n                        <div class=\"line-wrap\" mbr-if=\"showTitle\">\n                            <div class=\"line\"></div>\n                        </div>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\">Call us on <b>020 8653 8538</b><br>&nbsp;to arrange a consultation<br></p>\n                        <div class=\"card-link pt-2\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico mobi-mbri-arrow-next mobi-mbri\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper card2 align-left\">\n                    <div class=\"card-ico pb-4 align-left\" mbr-if=\"showIcons\">\n                        <a href=\"index.html#custom-html-8w\"><span mbr-icon class=\"mbr-iconfont card-icon icon2 mobi-mbri-video mobi-mbri\" style=\"color: rgb(2, 57, 182); fill: rgb(2, 57, 182);\"></span></a>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\">Video call</h4>\n                        <div class=\"line-wrap\" mbr-if=\"showTitle\">\n                            <div class=\"line line2\"></div>\n                        </div>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\"><a href=\"index.html#custom-html-8w\" class=\"text-black\">Arrange a free Zoom consultation with one of our experts</a><br></p>\n                        <div class=\"card-link pt-2\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico link2  mobi-mbri-arrow-next mobi-mbri\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper card3 align-left\">\n                    <div class=\"card-ico pb-4 align-left\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbr-iconfont card-icon mobi-mbri-users mobi-mbri\" style=\"color: rgb(2, 57, 182); fill: rgb(2, 57, 182);\"></span>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\">Visit us</h4>\n                        <div class=\"line-wrap\" mbr-if=\"showTitle\">\n                            <div class=\"line\"></div>\n                        </div>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\">Pop into our office when it's safe to do so for a meeting in person<br></p>\n                        <div class=\"card-link pt-2\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico mobi-mbri-arrow-next mobi-mbri\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "shWlD9FHio",
          "_anchor": "extContacts1-as",
