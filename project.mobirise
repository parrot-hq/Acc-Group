        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".contents": {
              "text-align": "center",
              "margin-bottom": "54px",
              ".mbr-subtitle": {
                "color": "@secondaryColor",
                "margin-bottom": "10px"
              },
              ".mbr-section-title": {
                "margin-bottom": "20px",
                "color": "@primaryColor"
              },
              ".mbr-text": {
                "color": "@infoColor"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "border-radius": "5px",
              "border": "1px solid @borderColor",
              "padding": "55px 50px 41px 45px",
              "transition": "all 0.3s",
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor"
                },
                ".mbr-text": {
                  "margin-bottom": "25px",
                  "color": "@infoColor"
                },
                ".mbr-iconfont": {
                  "padding-left": "0.2rem",
                  "display": "inline-block"
                }
              },
              ".card-img": {
                "margin-bottom": "40px",
                "transition": "all .9s",
                ".mbr-iconfont": {
                  "font-size": "77px",
                  "color": "@secondaryColor"
                }
              },
              ".mbr-link-btn": {
                "transition": "all 0.3s",
                ".btn": {
                  "transition": "all 0.3s",
                  "color": "@primaryColor",
                  "font-weight": "700",
                  ".mbr-iconfont": {
                    "font-weight": "700",
                    "padding-left": "40px !important",
                    "display": "inline",
                    "transition": "transform .3s linear 0s !important"
                  }
                },
                "&:hover": {
                  ".mbr-iconfont": {
                    "transform": "translateX(-10px)"
                  }
                }
              },
              "&:hover": {
                "background-color": "@hoverBgColor",
                "border-color": "@hoverBgColor",
                ".card-box": {
                  ".card-title": {
                    "color": "@hoverContentColor"
                  },
                  ".mbr-text": {
                    "color": "@hoverContentColor"
                  }
                },
                ".card-img": {
                  "transform": "rotateY(360deg)",
                  ".mbr-iconfont": {
                    "color": "@hoverContentColor"
                  }
                },
                ".mbr-link-btn": {
                  ".btn": {
                    "color": "@hoverContentColor"
                  }
                }
              }
            },
            ".btn[class*=\"-outline\"]": {
              "border": "none",
              "padding": "0",
              "margin": "0 !important",
              "box-shadow": "none !important",
              "span": {
                "order": "2",
                "font-size": "0.8rem",
                "transition": "padding 0.3s !important"
              },
              "&:hover span": {
                "padding-left": "10px"
              },
              "&:hover": {
                "background-color": "transparent !important",
                "color": "@primaryColor !important",
                "box-shadow": "none !important"
              },
              "&:active, &:focus": {
                "background-color": "transparent !important",
                "box-shadow": "none !important"
              }
            },
            "@media (max-width: 991px)": {
              ".card": {
                "margin-bottom": "15px"
              }
            },
            ".card-wrapper .card-box .card-title": {
              "color": "#0355ff"
            },
            ".contents .mbr-subtitle": {
              "color": "#232323"
            }
          },
          "_name": "features6",
          "_customHTML": "<section class=\"features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border Color\" value=\"#e9e9e9\" selected>\n        <header>Hover Color</header>\n        <input type=\"color\" title=\"Card Background\" name=\"hoverBgColor\" value=\"#6d7a8c\" selected>\n        <input type=\"color\" title=\"Content\" name=\"hoverContentColor\" value=\"#eeeff2\" selected>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#eff2f7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"contents\">\n            <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" data-app-selector=\".contents .mbr-section-title\" mbr-if=\"showMainTitle\" mbr-theme-style=\"display-2\"><span style=\"font-weight: normal;\">Supporting you</span></h1>\n            <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".contents .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\"><span style=\"font-weight: normal;\">We specialise in providing </span>cloud<span style=\"font-weight: normal;\"> </span>accounting solutions Xero, QuickBook &amp; Sage<span style=\"font-weight: normal;\"> <br><br>to help you keep your accounts online and provide real time business performance <br><br>information &amp; prompt&nbsp;compliance</span></h3>\n            <p class=\"mbr-text mbr-fonts-style mbr-regular\" data-app-selector=\".contents .mbr-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\">Each of our cleaners is interviewed in person, vetted and\n                comprehensively identity &amp; background checked, profesionally trained in the field.</p>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6', 'col-lg-6': cardsAmount == '4'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-gift\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Accountancy</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Preparing accounts &amp; taxation to help you comply with companies house, HMRC &amp; other public bodies' deadlines and statutory requirements - on time &amp; at the right cost</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-sun2\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title pb-3 align-center mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Auditing &amp; Taxation</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Complete taxation and persoanl tax, business tax, capital gains tax, inheritance tax, VAT and much more on an ongoing basis. Advance tax planning in property</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3' || cardsAmount == '5'|| cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-clock\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">\n                            Book keeping</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Regular book keeping for all types of businesses, updating all your records on a regular basis at a competitive fee. We can help you keep your bookkeeping up to date using software like - Sage, Xero, Quickbooks etc</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-map-pin\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Audit</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">We provide auditing services to check your internal records and provide statutory audit services through our Associate registered auditor</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 4\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-hot-cup\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Management accounting</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Knowing how your business performs is very important to make wise decisions. We can work with your lenders and banks to provide regular management information</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 5\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n    'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-setting\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Payroll</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">We provide prompt , accurate &amp; efficient payroll &amp; HR services. We can provide weekly, monthly 2 weekly payslips and all compliance reports through online RTI services to meet HMRC requirements<br></p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features6-4",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "s2V9TywmmC",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".contents": {
              "text-align": "center",
              "margin-bottom": "54px",
              ".mbr-subtitle": {
                "color": "@secondaryColor",
                "margin-bottom": "10px"
              },
              ".mbr-section-title": {
                "margin-bottom": "20px",
                "color": "@primaryColor"
              },
              ".mbr-text": {
                "color": "@infoColor"
              }
            },
            ".card-wrapper": {
              "height": "100%",
              "border-radius": "5px",
              "border": "1px solid @borderColor",
              "padding": "55px 50px 41px 45px",
              "transition": "all 0.3s",
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor"
                },
                ".mbr-text": {
                  "margin-bottom": "25px",
                  "color": "@infoColor"
                },
                ".mbr-iconfont": {
                  "padding-left": "0.2rem",
                  "display": "inline-block"
                }
              },
              ".card-img": {
                "margin-bottom": "40px",
                "transition": "all .9s",
                ".mbr-iconfont": {
                  "font-size": "77px",
                  "color": "@secondaryColor"
                }
              },
              ".mbr-link-btn": {
                "transition": "all 0.3s",
                ".btn": {
                  "transition": "all 0.3s",
                  "color": "@primaryColor",
                  "font-weight": "700",
                  ".mbr-iconfont": {
                    "font-weight": "700",
                    "padding-left": "40px !important",
                    "display": "inline",
                    "transition": "transform .3s linear 0s !important"
                  }
                },
                "&:hover": {
                  ".mbr-iconfont": {
                    "transform": "translateX(-10px)"
                  }
                }
              },
              "&:hover": {
                "background-color": "@hoverBgColor",
                "border-color": "@hoverBgColor",
                ".card-box": {
                  ".card-title": {
                    "color": "@hoverContentColor"
                  },
                  ".mbr-text": {
                    "color": "@hoverContentColor"
                  }
                },
                ".card-img": {
                  "transform": "rotateY(360deg)",
                  ".mbr-iconfont": {
                    "color": "@hoverContentColor"
                  }
                },
                ".mbr-link-btn": {
                  ".btn": {
                    "color": "@hoverContentColor"
                  }
                }
              }
            },
            ".btn[class*=\"-outline\"]": {
              "border": "none",
              "padding": "0",
              "margin": "0 !important",
              "box-shadow": "none !important",
              "span": {
                "order": "2",
                "font-size": "0.8rem",
                "transition": "padding 0.3s !important"
              },
              "&:hover span": {
                "padding-left": "10px"
              },
              "&:hover": {
                "background-color": "transparent !important",
                "color": "@primaryColor !important",
                "box-shadow": "none !important"
              },
              "&:active, &:focus": {
                "background-color": "#0355ff !important",
                "box-shadow": "none !important"
              }
            },
            "@media (max-width: 991px)": {
              ".card": {
                "margin-bottom": "15px"
              }
            },
            ".card-wrapper .card-box .card-title": {
              "color": "#0355ff"
            }
          },
          "_name": "features6",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border Color\" value=\"#e9e9e9\" selected>\n        <header>Hover Color</header>\n        <input type=\"color\" title=\"Card Background\" name=\"hoverBgColor\" value=\"#6d7a8c\" selected>\n        <input type=\"color\" title=\"Content\" name=\"hoverContentColor\" value=\"#eeeff2\" selected>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#eff2f7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"contents\">\n            <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" data-app-selector=\".contents .mbr-section-title\" mbr-if=\"showMainTitle\" mbr-theme-style=\"display-2\">Aligning, for business growth</h1>\n            <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".contents .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\">Because one size never fits all</h3>\n            <p class=\"mbr-text mbr-fonts-style mbr-regular\" data-app-selector=\".contents .mbr-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\">Each of our cleaners is interviewed in person, vetted and\n                comprehensively identity &amp; background checked, profesionally trained in the field.</p>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6', 'col-lg-6': cardsAmount == '4'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-gift\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">VAT</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">VAT rules are becoming more and more complex because of changes in EU rules etc. We can help you with HMRC requirements and ensure up to date VAT.&nbsp;</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3' || cardsAmount == '5' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-sun2\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title pb-3 align-center mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Business planning</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">We can provide business planning using accountancy and management information along with your input &amp; understanding of business information</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3' || cardsAmount == '5'|| cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-clock\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Consultancy</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Our consultancy services are based on years of experience in understanding your business. We can help you find solutions to day to day challenges and make major decisions such as buying &amp; selling businesses tax efficiently.</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                            'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-map-pin\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Startups</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Cras tempus\n                            consectetur venenatis. Quisque\n                            porttitor iaculis rutrum.&nbsp;</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 4\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n                'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-hot-cup\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Taxation</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Cras tempus\n                            consectetur venenatis. Quisque\n                            porttitor iaculis rutrum.&nbsp;</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 5\" mbr-class=\"{'col-lg-6': cardsAmount == '4',\n    'col-lg-4': cardsAmount == '3' || cardsAmount == '6'}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-setting\"></span>\n                    </div>\n                    <div class=\"card-box align-center\">\n                        <h4 class=\"card-title align-center pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-wrapper .card-box .card-title\">Payroll</h4>\n                        <p class=\"mbr-text align-center mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-wrapper .card-box .mbr-text\">Cras tempus\n                            consectetur venenatis. Quisque\n                            porttitor iaculis rutrum.&nbsp;</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-link-btn align-center\" mbr-if=\"showLink\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-black-outline\" href=\"https://mobiri.se/\" data-app-placeholder=\"Type Text\"><span class=\"mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>More Deatails</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features6-4w",
          "_isUserblock": true,
          "_cid": "seP8VbSOSg",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n<!-- Calendly inline widget begin -->\n<div class=\"calendly-inline-widget\" data-url=\"https://calendly.com/info-21052/30min\" style=\"min-width:320px;height:700px;\"></div>\n[JS_CODE_0]\n<!-- Calendly inline widget end -->\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "cleanm4",
          "_anchor": "custom-html-8w",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script type=\"text/javascript\" src=\"https://assets.calendly.com/assets/external/widget.js\"></script>"
          ]
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "position": "relative",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              },
              ".content": {
                "padding-right": "30px"
              }
            },
            "& when not (@reverseContent)": {
              ".content": {
                "padding-left": "30px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor"
            },
            ".mbr-text": {
              "color": "@infoColor"
            },
            "margin-bottom": "70px",
            ".mbr-iconfont": {
              "font-family": "\"Moririse2\" !important",
              "display": "inline-flex",
              "transform-origin": "",
              "transform": "rotate(45deg)",
              "transition": "all 0.3s",
              "padding": "0 !important",
              "font-size": "1.4rem !important",
              "color": "@iconColor",
              "&:before": {
                "transform": "scaleY(0) !important",
                "transition": "all 0.4s"
              }
            },
            ".p-4": {
              "padding": "1rem 0 !important"
            },
            ".accordion .card .card-header": {
              "margin-bottom": "0px"
            },
            ".mbri-arrow-down:before": {
              "content": "\"\\e960\""
            },
            ".mbri-arrow-up:before": {
              "content": "\"\\e960\""
            },
            ".card": {
              "border-radius": "0px",
              "border-bottom": "2px solid @lineColor !important",
              "&:last-child": {
                "border-bottom": "none !important"
              },
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "background-color": "transparent",
                "padding": "0",
                "h4": {
                  "justify-content": "flex-start",
                  "width": "100%"
                },
                "a.panel-title": {
                  "margin-bottom": "0",
                  "display": "flex",
                  "width": "100%",
                  "justify-content": "space-between",
                  "&:focus": {
                    "text-decoration": "none !important"
                  },
                  "h4": {
                    "padding": "1.2rem 0rem",
                    "margin-bottom": "0",
                    "color": "@primaryColor",
                    "padding-right": "50px",
                    ".sign": {
                      "padding-right": "1rem"
                    }
                  },
                  ".toggle-icon": {
                    "right": "20px",
                    "position": "absolute",
                    "top": "17px",
                    "transform": "translate(-50%, 0) !important",
                    "display": "inline-block",
                    "margin-left": "0",
                    "width": "46px",
                    "height": "46px",
                    "background-color": "@iconColorClickedBg",
                    "transition": "all .3s ease 0s",
                    "box-shadow": "0 14px 40px 0 @iconColorClickedBg",
                    "&:before, &:after": {
                      "background": "@iconColorClicked",
                      "border": "0",
                      "box-sizing": "border-box",
                      "content": "\"\"",
                      "display": "block",
                      "left": "50%",
                      "position": "absolute",
                      "top": "50%"
                    },
                    "&:before": {
                      "height": "12px",
                      "margin-left": "-1px !important",
                      "width": "2px",
                      "margin-top": "-6px",
                      "background-color": "@iconColorClicked",
                      "border": "0",
                      "transform": "none"
                    },
                    "&:after": {
                      "height": "2px",
                      "width": "12px",
                      "margin-left": "-6px",
                      "margin-top": "-1px"
                    }
                  }
                }
              },
              ".panel-body": {
                "padding": "14px 20px",
                "p": {
                  "color": "@infoColor"
                }
              }
            },
            ".collapsed": {
              ".mbr-iconfont": {
                "transform": "rotate(0deg)",
                "&:before": {
                  "transform": "scaleY(1) !important",
                  "transition": "all 0.3s"
                }
              },
              ".toggle-icon": {
                "background-color": "transparent !important",
                "transform": "translate(0, 0)",
                "right": "7px !important",
                "box-shadow": "none !important",
                "&:before, &:after": {
                  "background": "@iconColor !important"
                },
                "&:before": {
                  "background-color": "@iconColor !important"
                }
              }
            },
            ".img-wrap": {
              "img": {
                "width": "100%"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".content .mbr-section-title": {
              "color": "#0239b6"
            },
            ".card .card-header a.panel-title h4": {
              "color": "#000000"
            },
            ".card .panel-body p": {
              "color": "#000000"
            }
          },
          "_name": "accordion1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"accordion1\" group=\"Accordions\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax, 'mbr-fullscreen': fullScreen}\" plugins=\"mbr-switch-arrow2, mobirise-icons2\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show/Hide</header>\n        <input type=\"range\" inline title=\"Accordions Count\" name=\"bootstrapAccordion\" min=\"1\" max=\"12\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Colors</header>\n        <input type=\"color\" name=\"iconColor\" title=\"Icons\" value=\"#63b68f\" selected>\n        <input type=\"color\" name=\"iconColorClicked\" title=\"Icons Clicked\" value=\"#ffffff\" selected>\n        <input type=\"color\" name=\"iconColorClickedBg\" title=\"Icons Clicked Bg\" value=\"#6d7a8c\" selected>\n        <input type=\"color\" name=\"lineColor\" title=\"Line\" value=\"#efefef\" selected>\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-6\">\n                <div class=\"img-wrap mb-5\">\n                    <img src=\"@PROJECT_PATH@/assets/images/design-3588214.jpg\" alt title>\n                </div>\n            </div>\n            <div class=\"col-lg-6 content\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style align-left mbr-semibold\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".content .mbr-section-subtitle\">So you are sure</h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title align-left mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".content .mbr-section-title\"><span style=\"font-weight: normal;\">Common questions</span></h2>\n                <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-article data-app-selector=\".content .mbr-text\" data-multiline mbr-if=\"showText\">\n                    Etiam non purus eros. Nam convallis lectus at felis faucibus, commodo vestibulum magna laoreet.\n                    Aenean nec\n                    sem semper sem ultricies interdum.</p>\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\n                                <h4 class=\"mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\"><span style=\"font-weight: normal;\">How do you charge for services?\n                                    </span><span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                </h4>\n\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">Our fees are based on your requirements. We quote fixed fees in advance to avoid any surprises. Our fees are reasonable which take into account prompt and efficient delivery of services tailored to you and your business needs.&nbsp;</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span><span style=\"font-weight: normal;\">FREE appointments?</span></h4>\n                            </a>\n\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body pt\">Appointments can be made to meet in person or telephone calls to suit your convenience. You can contact us on - info@accountancygroup.com or on 020 8653 8538 or book an appointment via the website.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span><span style=\"font-weight: normal;\">FREE software and training?\n                                </span></h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">For regular accounting clients we can provide free software training and guidance to help you comply and monitor the performance of your business in real time and on a regular basis.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span><span style=\"font-weight: normal;\">Support &amp; assistance other than accounting?</span></h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">We can help you structure your business efficiently so it meets your aims and goals. We cover business structure, salary, dividend planning, VAT, PAYE compliance, regular tax planning, management accounts and business planning. We aim to provide a holistic solutions to your needs.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    Bank accounts?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    What method of payment do you accept?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body pt\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 6\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse7\" aria-expanded=\"false\" aria-controls=\"collapse7\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Anything i should\n                                    know as a new client?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse7\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 7\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse8\" aria-expanded=\"false\" aria-controls=\"collapse8\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Can I make special\n                                    request?\n                                </h4>\n                            </a>\n\n                        </div>\n                        <div id=\"collapse8\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 8\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse9\" aria-expanded=\"false\" aria-controls=\"collapse9\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Any cancellation\n                                    fees?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse9\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">Sem nulla\n                                    pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus turpis.\n                                    Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat vivamus at\n                                    augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 9\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse10\" aria-expanded=\"false\" aria-controls=\"collapse10\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    Do you clean basementsand attics?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse10\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 10\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse11\" aria-expanded=\"false\" aria-controls=\"collapse11\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    How do i cancel of reshedule?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse11\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 11\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse12\" aria-expanded=\"false\" aria-controls=\"collapse12\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    I don't need bathrrom/bedrooms cleaned?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse12\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n</section>",
          "_anchor": "accordion1-53",
          "_isUserblock": true,
          "_cid": "sfLZPLgXK0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".text-content": {
              ".mbr-subtitle": {
                "color": "@secondaryColor"
              },
              ".mbr-section-title": {
                "color": "@primaryColor"
              },
              ".mbr-text": {
                "color": "@infoColor"
              },
              ".list-block": {
                "margin-top": "16px",
                "padding-bottom": "16px",
                ".card-img": {
                  "width": "auto",
                  "span": {
                    "color": "@secondaryColor",
                    "font-size": "1.5rem"
                  }
                },
                ".list-item-title": {
                  "color": "@primaryColor",
                  "transition": "all .3s linear 0s",
                  "&:hover": {
                    "color": "@listTitleHoverColor"
                  }
                },
                ".list-item-text": {
                  "padding-top": "10px",
                  "color": "@infoColor",
                  "margin-bottom": "0"
                }
              },
              ".list-block.last": {
                "border-bottom": "none",
                "margin-bottom": "20px",
                "padding-bottom": "0"
              },
              ".social": {
                "font-size": "1.2rem",
                "span": {
                  "margin-right": "11.2px",
                  "margin-bottom": "8px",
                  "transition": "0.3s all",
                  "color": "@socIconsColor",
                  "&:hover": {
                    "color": "@socIconsHover",
                    "transition": "0.3s all"
                  }
                }
              }
            },
            ".card-img": {
              "display": "none",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "text-align": "left"
            },
            "& when (@showIcons)": {
              ".list-block": {
                "position": "relative",
                "& h4, p": {
                  "padding-left": "2.625rem"
                }
              },
              ".card-img": {
                "display": "block"
              }
            },
            "& when (@customStyle)": {
              "input, textarea": {
                "border-radius": "3px",
                "min-height": "3rem",
                "padding": "13px 20px !important",
                "font-size": "13px",
                "color": "@successColor",
                "height": "60px"
              },
              ".form-control, .field-input": {
                "padding": "13px 20px !important",
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none",
                "&:hover, &:focus": {
                  "background-color": "@fieldHover",
                  "border-color": "@borderHover",
                  "color": "contrast(@fieldColor)",
                  "box-shadow": "none",
                  "outline": "none"
                },
                "&:focus": {
                  "box-shadow": "0 2px 9px 2px rgba(0, 0, 0, 0.15)"
                }
              },
              "input::-webkit-input-placeholder, textarea::-webkit-input-placeholder": {
                "color": "@formPlaceholder"
              },
              "input:-moz-placeholder, textarea:-moz-placeholder": {
                "color": "@formPlaceholder"
              },
              ".jq-selectbox li, .jq-selectbox li": {
                "background-color": "@fieldColor",
                "color": "contrast(@fieldColor)"
              },
              ".jq-selectbox li:hover, .jq-selectbox li.selected": {
                "background-color": "@fieldHover",
                "color": "contrast(@fieldHover)"
              },
              ".jq-selectbox:hover .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldColor"
              },
              ".jq-selectbox .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldHover"
              }
            },
            ".mbr-form": {
              "max-width": "550px",
              ".content-title": {
                "color": "@primaryColor",
                "margin-bottom": "20px"
              },
              ".content-subtitle": {
                "color": "@infoColor"
              },
              "textarea": {
                "min-height": "100px",
                "height": "194px"
              },
              ".btn": {
                "justify-content": "space-between",
                "border-radius": "30px",
                "border-color": "@primaryColor",
                "color": "@primaryColor",
                "padding": "18px 42px",
                "margin": "0 !important",
                "margin-top": "7px !important"
              },
              ".btn-success": {
                "&:hover": {
                  "background-color": "@secondaryColor !important",
                  "border-color": "@secondaryColor !important",
                  "color": "#fff !important"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".mbr-form": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              ".mbr-section-title, .content-title, .mbr-section-btn": {
                "text-align": "left"
              }
            }
          },
          "_name": "form2",
          "_customHTML": "<section class=\"form2\" group=\"Forms & Maps\" plugins=\"formstyler, datepicker\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"!fullScreen\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Contacts Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" checked>\n        <input type=\"color\" name=\"listTitleHoverColor\" title=\"List Hover Color\" value=\"#279e64\" condition=\"showListTitle\">\n        <input type=\"checkbox\" title=\"List Text\" name=\"showListText\">\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\">\n        <select title=\"List items\" name=\"listItemsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <select title=\"Social Icons\" name=\"socialIconsCount\" condition=\"showSocialIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Form Title\" name=\"showFormTitle\">\n        <input type=\"checkbox\" title=\"Form Text\" name=\"showFormText\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <header>Style</header>\n        <input type=\"color\" name=\"socIconsColor\" title=\"Soc icons\" value=\"#13287d\" condition=\"showSocialIcons\">\n        <input type=\"color\" name=\"socIconsHover\" title=\"Soc icons hover\" value=\"#279e64\" condition=\"showSocialIcons\">\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#dcdfe2\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#279e64\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#6d7a8c\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#f9f9f9\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay&&bg.type=='image')\"></div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 mb-5 text-content\">\n\n                <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".text-content .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-4\">Get in touch</h3>\n                <h2 class=\"mbr-section-title align-left mbr-bold mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\" data-app-selector=\".text-content .mbr-section-title\"><span style=\"font-weight: normal;\">Get in touch</span></h2>\n                <p class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .mbr-text\" mbr-if=\"showText\">Lorem\n                    ipsum\n                    dolor sit amet, consectetur adipiscing elit. Etiam dignissim quis mi eu tristique. Cras et\n                    massa erat. Quisque tempus, dolor sit amet ultrices mattis.</p>\n                <div class=\"list-block mt-5\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-mobile mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">020 8653 8538</h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">24/7 Support\n                        <br> Call Us\n                    </p>\n                </div>\n                <div class=\"list-block\" mbr-if=\"listItemsAmount > 1\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-pin mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">SVS House, Oliver Grove<div><br></div><div>South Norwood, London SE25 6EJ</div></h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">Find Us\n                        Location</p>\n                </div>\n                <div class=\"list-block last\" mbr-if=\"listItemsAmount > 2\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-letter mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">\n                        info@accountancygroup.com</h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">\n                        Email</p>\n                </div>\n                <div class=\"social mt-4\" mbr-if=\"showSocialIcons\">\n                    <span mbr-icon class=\"mbr-iconfont fa-facebook-square fa\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-twitter-square fa\" mbr-if=\"socialIconsCount > 1\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-linkedin-square fa\" mbr-if=\"socialIconsCount > 2\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-instagram fa\" mbr-if=\"socialIconsCount > 3\"></span>\n                </div>\n            </div>\n            <div mbr-form class=\"col-lg-6 mx-auto mbr-form\" mbr-class=\"{'order-2': reverseContent}\">\n<!--Formbuilder Form-->\n<form action=\"info@accountancygroup.com\" name=\"AG form\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! We will be in touch shortly.</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-6 form-group\" data-for=\"first-name\">\n<input type=\"text\" name=\"first-name\" placeholder=\"Your Name*\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 form-group\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"Your Email*\" data-form-field=\"email\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\" value>\n</div>\n<div data-for=\"phone\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"tel\" name=\"phone\" placeholder=\"Your telephone number\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div data-for=\"message\" class=\"col-lg-12 form-group\">\n<textarea name=\"message\" placeholder=\"Your Comment\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-lg-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"btn btn-success btn-form btn-lg\">Send message</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_anchor": "form2-i",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "s2V9Yi1kG2",
