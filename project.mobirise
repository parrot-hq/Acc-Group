          "_name": "extContacts1",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"extContacts1\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#63b68f\" selected condition=\"showTitle\">\n        <input type=\"color\" title=\"Second Line Color\" name=\"lineColor2\" value=\"#63b68f\" selected condition=\"showTitle &amp;&amp; cardsAmount > 1\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\">\n        <input type=\"color\" title=\"Cards Bg\" name=\"cardsBg\" value=\"#eff2f7\">\n        <input type=\"color\" title=\"Second Cards Bg\" name=\"cardsBg1\" value=\"#eff2f7\" condition=\"cardsAmount > 1\">\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n        <input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"1\" max=\"9\" step=\"1\" value=\"7\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#13287d\" selected condition=\"showIcons\">\n        <input type=\"color\" title=\"Second Icon Color\" name=\"iconsColor2\" value=\"#13287d\" selected condition=\"showIcons &amp;&amp; cardsAmount > 1\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center mbr-white\" mbr-cards=\"bootstrap\">\n            <div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 0\">\n                <div class=\"card-wrapper card1 align-left\">\n                    <div class=\"card-ico pb-4\" mbr-if=\"showIcons\">\n                        <a href=\"https://www.gov.uk/government/collections/financial-support-for-businesses-during-coronavirus-covid-19\"><span mbr-icon class=\"mbr-iconfont card-icon mobi-mbri-cash mobi-mbri\"></span></a>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\"><a href=\"https://www.gov.uk/government/collections/financial-support-for-businesses-during-coronavirus-covid-19\" class=\"text-danger text-primary\" target=\"_blank\">Financial support</a></h4>\n                        <div class=\"line-wrap\" mbr-if=\"showTitle\">\n                            <div class=\"line\"></div>\n                        </div>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\">0 (800) 123 45 67<br>0 (800) 897 65 43</p>\n                        <div class=\"card-link pt-2\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico mobi-mbri-arrow-next mobi-mbri\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper card2 align-left\">\n                    <div class=\"card-ico pb-4 align-left\" mbr-if=\"showIcons\">\n                        <a href=\"https://www.gov.uk/difficulties-paying-hmrc\"><span mbr-icon class=\"mbr-iconfont card-icon icon2 mobi-mbri-timer mobi-mbri\"></span></a>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\"><a href=\"https://www.gov.uk/difficulties-paying-hmrc\" class=\"text-danger text-primary\" target=\"_blank\">Tax bill / HMRC</a></h4>\n                        <div class=\"line-wrap\" mbr-if=\"showTitle\">\n                            <div class=\"line line2\"></div>\n                        </div>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\">382 Dark Hollow Road\n                            <br>Mineral Point, WI</p>\n                        <div class=\"card-link pt-2\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico link2  mobi-mbri-arrow-next mobi-mbri\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card p-3 col-12 col-md-8 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper card3 align-left\">\n                    <div class=\"card-ico pb-4 align-left\" mbr-if=\"showIcons\">\n                        <a href=\"https://www.gov.uk/transition?utm_campaign=transition_p1&utm_medium=organic&utm_source=ogd_beis_twtr&utm_content=ala__act0&fbclid=IwAR1JuoybzOeDgxkrt8vwmDaTFhlK5upoPHsjWtaALxuxZpvGY6L6mkf54hc\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont card-icon mobi-mbri-users mobi-mbri\"></span></a>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-ico, .line-wrap\"><a href=\"https://www.gov.uk/transition?utm_campaign=transition_p1&utm_medium=organic&utm_source=ogd_beis_twtr&utm_content=ala__act0&fbclid=IwAR1JuoybzOeDgxkrt8vwmDaTFhlK5upoPHsjWtaALxuxZpvGY6L6mkf54hc\" class=\"text-danger text-primary\" target=\"_blank\"><b>Brexit</b> - UK Transition</a></h4>\n                        <div class=\"line-wrap\" mbr-if=\"showTitle\">\n                            <div class=\"line\"></div>\n                        </div>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .card-link\">\n                            info@site.com<br>www.mobirise.com<br></p>\n                        <div class=\"card-link pt-2\" mbr-if=\"showLink\">\n                            <a href=\"https://mobiri.se/\"><span mbr-icon class=\"mbr-iconfont link-ico mobi-mbri-arrow-next mobi-mbri\"></span></a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "extContacts1-4i",
          "_isUserblock": true,
          "_cid": "sdNzBUAZKA",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "max-width": "100%",
              "margin-bottom": "30px"
            },
            ".card-wrapper": {
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".meta": {
                  "color": "#999999",
                  "position": "relative",
                  "margin-bottom": "33px",
                  "& when (@showLines)": {
                    "&::before": {
                      "content": "\"\"",
                      "display": "block",
                      "width": "20px",
                      "height": "3px",
                      "background-color": "@linesColor",
                      "position": "absolute",
                      "left": "0",
                      "bottom": "-25px"
                    }
                  },
                  ".item": {
                    "transition": "all 0.3s ease-in",
                    "margin-right": "22px",
                    "&:hover": {
                      "color": "@tagsHoverColor !important",
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".mbr-iconfont": {
                    "color": "@infoColor",
                    "margin-right": "4px",
                    "font-size": "14px",
                    "font-weight": "400",
                    "transition": "all 0.3s ease-in"
                  },
                  ".item-author": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".author": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  },
                  ".item-date": {
                    ".date": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".item-comment": {
                    ".comment": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    "& when (@showLines)": {
                      "&:after": {
                        "content": "\"\"",
                        "display": "block",
                        "width": "35px",
                        "height": "3px",
                        "background-color": "@linesColor",
                        "position": "absolute",
                        "left": "30px",
                        "bottom": "-25px"
                      }
                    }
                  },
                  ".item-views": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".views": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500"
                },
                ".mbr-text": {
                  "margin-bottom": "24px",
                  "color": "@infoColor",
                  "&.accent-text": {
                    "color": "@primaryColor",
                    "position": "relative",
                    "padding-left": "62px",
                    ".mbr-iconfont": {
                      "display": "block",
                      "width": "41px",
                      "height": "36px",
                      "position": "absolute",
                      "left": "0",
                      "top": "10px",
                      "font-size": "41px",
                      "color": "@successColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                ".entry-content-bottom": {
                  "padding-top": "4px",
                  "padding-bottom": "38px",
                  "position": "relative",
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "justify-content": "space-between",
                  "align-items": "center",
                  ".entry-tags": {
                    "margin": "5px 15px 5px 0",
                    ".mbr-section-btn": {
                      "a": {
                        "border": "1px solid fade(@infoColor, 28.6%)",
                        "display": "inline-block",
                        "font-size": "14px !important",
                        "padding": "9.5px 31px",
                        "margin-top": "13px",
                        "margin-right": "6px",
                        "transition": "all .3s linear 0ms",
                        "&:hover": {
                          "background-color": "@secondaryColor",
                          "color": "#ffffff !important"
                        }
                      }
                    }
                  },
                  ".entry-social-share": {
                    "display": "flex",
                    "align-items": "flex-end",
                    "margin-top": "13px",
                    "ul": {
                      "margin": "0",
                      "padding": "0",
                      "display": "flex",
                      "align-items": "center",
                      "li": {
                        "padding": "4px",
                        "display": "flex",
                        "margin": "0 4px",
                        "background-color": "red",
                        "border-radius": "50%",
                        "width": "40px",
                        "height": "40px",
                        "align-items": "center",
                        "justify-content": "center",
                        "&.icon": {
                          "&1": {
                            "background-color": "@socialIconColor1"
                          },
                          "&2": {
                            "background-color": "@socialIconColor2"
                          },
                          "&3": {
                            "background-color": "@socialIconColor3"
                          },
                          "&4": {
                            "background-color": "@socialIconColor4"
                          },
                          "&5": {
                            "background-color": "@socialIconColor5"
                          }
                        },
                        ".icon-transition": {
                          ".mbr-iconfont": {
                            "font-size": "14px",
                            "color": "#ffffff"
                          }
                        },
                        "&:first-child": {
                          "margin-left": "0"
                        }
                      }
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".card-wrapper .card-box .mbr-text, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "content2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content2\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Meta\" name=\"showMeta\">\n        <input type=\"checkbox\" title=\"Lines\" name=\"showLines\" condition=\"showMeta\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Accent Text\" name=\"showAccentText\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"checkbox\" title=\"Bottom Content\" name=\"showBottomContent\">\n        <header condition=\"showMeta || showLink\">Colors</header>\n        <input type=\"color\" name=\"tagsHoverColor\" title=\"Tags Hover\" value=\"#279e64\" selected condition=\"showMeta\">\n        <input type=\"color\" name=\"linesColor\" title=\"Lines Color\" value=\"#279e64\" selected condition=\"showMeta && showLines\">\n        <input type=\"color\" name=\"iconColor\" title=\"Link Icon\" value=\"#13287d\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconColorHover\" title=\"Link Icon Hover\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Link Icon Bg Hover\" value=\"#279e64\" selected condition=\"showLink\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked condition=\"showBottomContent\">\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showBottomContent && showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <header condition=\"showBottomContent && showIcons\">Social Icons Color</header>\n        <input type=\"color\" name=\"socialIconColor1\" title=\"Icon 1 Bg\" value=\"#3b5998\" selected condition=\"showBottomContent && showIcons\">\n        <input type=\"color\" name=\"socialIconColor2\" title=\"Icon 2 Bg\" value=\"#00acee\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>1\">\n        <input type=\"color\" name=\"socialIconColor3\" title=\"Icon 3 Bg\" value=\"#ca1f27\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>2\">\n        <input type=\"color\" name=\"socialIconColor4\" title=\"Icon 4 Bg\" value=\"#dd4b39\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>3\">\n        <input type=\"color\" name=\"socialIconColor5\" title=\"Icon 5 Bg\" value=\"#279e64\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>4\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <img src=\"../_images/img/05.jpg\" mbr-if=\"showImage\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"meta mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showMeta\">\n                            <span class=\"item-author\">\n                                <span mbr-icon class=\"mbr-iconfont author mbrib-user\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text author item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-author .author, .card-wrapper .card-box .meta\">Matthew\n                                    Wheeler</span>\n                            </span>\n                            <span class=\"item-date\">\n                                <span mbr-icon class=\"mbr-iconfont date mbrib-calendar\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text date item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-date .date, .card-wrapper .card-box .meta\">July\n                                    25,\n                                    2025</span>\n                            </span>\n                            <span class=\"item-comment\">\n                                <span mbr-icon class=\"mbr-iconfont comment mbrib-help\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text comment item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-comment .comment, .card-wrapper .card-box .meta\">\n                                    Comments: 4</span>\n                            </span>\n                            <span class=\"item-views\">\n                                <span mbr-icon class=\"mbr-iconfont views mbrib-preview\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text views item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-views .views, .card-wrapper .card-box .meta\">\n                                    351 Views</span>\n                            </span>\n                        </div>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn, .card-wrapper .card-box .meta\">Covid-19 : Where are we at now?</h4>\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn, .card-wrapper .card-box .meta\">\n                            The best outdoor cleaning</h5>\n\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Either from a personal perspective or as a business owner it is likely you will have been hit with a whole raft of information being thrown at you from different sources at various times since the pandemic engulfed the UK back in March this year.<br>It makes sense just to take a deep breath, look at where we are now, look forward to what might be coming up over the next six months and what, if anything, we should consider doing to prepare.<br></p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-semibold accent-text align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showAccentText\" data-app-selector=\".card-wrapper .card-box .mbr-text.accent-text, .mbr-section-btn\">\n                            <span mbr-icon class=\"front mbr-iconfont fa-quote-left fa\" data-app-selector=\".content-link\"></span>\n                            Maybe you need to clean your house fast for a party, need a hotel maid to help scrub motel\n                            rooms, or are looking for a professional to help with hospital housekeeping.</p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"></p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Continue Reading<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                        <div class=\"entry-content-bottom\" mbr-if=\"showBottomContent\">\n                            <div class=\"entry-tags\">\n                                <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\">\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Office</a>\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Carpet</a>\n                                </div>\n                            </div>\n                            <div class=\"entry-social-share\" mbr-if=\"showIcons\">\n                                <ul>\n                                    <li mbr-if=\"iconsCount > 0\" class=\"icon icon1\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 1\" class=\"icon icon2\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 2\" class=\"icon icon3\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont fa-pinterest-p fa\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 3\" class=\"icon icon4\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-google socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 4\" class=\"icon icon5\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sg2hXe5vHM",
          "_anchor": "content2-8a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@isGradientBg)": {
                "background": "linear-gradient(to bottom, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".content-inner": {
              ".left-content": {
                "display": "block",
                ".mbr-section-title": {
                  "color": "#ffffff",
                  "margin-bottom": "11px"
                },
                ".mbr-text": {
                  "color": "#ffffff"
                }
              },
              ".right-content": {
                "display": "block",
                ".mbr-text": {
                  "color": "#ffffff",
                  "font-weight": "500",
                  "margin-bottom": "17px",
                  "letter-spacing": ".02em"
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "border-radius": "30px",
                    "padding": "18px 42px !important",
                    "&-white": {
                      "color": "#000000 !important",
                      "&:hover": {
                        "background-color": "@successColor !important",
                        "border-color": "@successColor !important"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".content-inner": {
                "justify-content": "center !important"
              },
              "*": {
                "text-align": "center"
              }
            }
          },
          "_name": "title2",
          "_customHTML": "<section class=\"title2\" group=\"Title\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"25\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"25\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/background4.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#0239b6\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Bg\" name=\"isGradientBg\" condition=\"bg.type=='color'\" checked>\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#00da70\" condition=\"bg.type=='color' && isGradientBg\" selected>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#279e64\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.65\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-center\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"content-inner d-flex justify-content-between flex-wrap align-center\">\n                    <div class=\"left-content\">\n                        <h1 class=\"mbr-fonts-style mbr-section-title mbr-bold align-left\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".content-inner .left-content .mbr-section-title, .mbr-section-btn\">Take action today</h1>\n                        <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".content-inner .left-content .mbr-text, .mbr-section-btn\">Get upto 3 months FREE cloud accounting software<br>* Subject to contract<br></p>\n                    </div>\n                    <div class=\"right-content\">\n                        <p class=\"mbr-text align-center mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".content-inner .right-content .mbr-text, .mbr-section-btn\"></p>\n                        <div class=\"buttons-wrap w-100\">\n                            <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-success\" href=\"index.html#pricing-tables2-h\" data-app-placeholder=\"Type Text\">FREE Consultation</a></div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sdNxulgACC",
          "_anchor": "title2-48",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "position": "relative",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              },
              ".content": {
                "padding-right": "30px"
              }
            },
            "& when not (@reverseContent)": {
              ".content": {
                "padding-left": "30px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor"
            },
            ".mbr-text": {
              "color": "@infoColor"
            },
            "margin-bottom": "70px",
            ".mbr-iconfont": {
              "font-family": "\"Moririse2\" !important",
              "display": "inline-flex",
              "transform-origin": "",
              "transform": "rotate(45deg)",
              "transition": "all 0.3s",
              "padding": "0 !important",
              "font-size": "1.4rem !important",
              "color": "@iconColor",
              "&:before": {
                "transform": "scaleY(0) !important",
                "transition": "all 0.4s"
              }
            },
            ".p-4": {
              "padding": "1rem 0 !important"
            },
            ".accordion .card .card-header": {
              "margin-bottom": "0px"
            },
            ".mbri-arrow-down:before": {
              "content": "\"\\e960\""
            },
            ".mbri-arrow-up:before": {
              "content": "\"\\e960\""
            },
            ".card": {
              "border-radius": "0px",
              "border-bottom": "2px solid @lineColor !important",
              "&:last-child": {
                "border-bottom": "none !important"
              },
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "background-color": "transparent",
                "padding": "0",
                "h4": {
                  "justify-content": "flex-start",
                  "width": "100%"
                },
                "a.panel-title": {
                  "margin-bottom": "0",
                  "display": "flex",
                  "width": "100%",
                  "justify-content": "space-between",
                  "&:focus": {
                    "text-decoration": "none !important"
                  },
                  "h4": {
                    "padding": "1.2rem 0rem",
                    "margin-bottom": "0",
                    "color": "@primaryColor",
                    "padding-right": "50px",
                    ".sign": {
                      "padding-right": "1rem"
                    }
                  },
                  ".toggle-icon": {
                    "right": "20px",
                    "position": "absolute",
                    "top": "17px",
                    "transform": "translate(-50%, 0) !important",
                    "display": "inline-block",
                    "margin-left": "0",
                    "width": "46px",
                    "height": "46px",
                    "background-color": "@iconColorClickedBg",
                    "transition": "all .3s ease 0s",
                    "box-shadow": "0 14px 40px 0 @iconColorClickedBg",
                    "&:before, &:after": {
                      "background": "@iconColorClicked",
                      "border": "0",
                      "box-sizing": "border-box",
                      "content": "\"\"",
                      "display": "block",
                      "left": "50%",
                      "position": "absolute",
                      "top": "50%"
                    },
                    "&:before": {
                      "height": "12px",
                      "margin-left": "-1px !important",
                      "width": "2px",
                      "margin-top": "-6px",
                      "background-color": "@iconColorClicked",
                      "border": "0",
                      "transform": "none"
                    },
                    "&:after": {
                      "height": "2px",
                      "width": "12px",
                      "margin-left": "-6px",
                      "margin-top": "-1px"
                    }
                  }
                }
              },
              ".panel-body": {
                "padding": "14px 20px",
                "p": {
                  "color": "@infoColor"
                }
              }
            },
            ".collapsed": {
              ".mbr-iconfont": {
                "transform": "rotate(0deg)",
                "&:before": {
                  "transform": "scaleY(1) !important",
                  "transition": "all 0.3s"
                }
              },
              ".toggle-icon": {
                "background-color": "transparent !important",
                "transform": "translate(0, 0)",
                "right": "7px !important",
                "box-shadow": "none !important",
                "&:before, &:after": {
                  "background": "@iconColor !important"
                },
                "&:before": {
                  "background-color": "@iconColor !important"
                }
              }
            },
            ".img-wrap": {
              "img": {
                "width": "100%"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".content .mbr-section-title": {
              "color": "#0355ff"
            }
          },
          "_name": "accordion1",
          "_customHTML": "<section class=\"accordion1\" group=\"Accordions\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax, 'mbr-fullscreen': fullScreen}\" plugins=\"mbr-switch-arrow2, mobirise-icons2\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\" condition=\"!fullScreen\">\n        <header>Show/Hide</header>\n        <input type=\"range\" inline title=\"Accordions Count\" name=\"bootstrapAccordion\" min=\"1\" max=\"12\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Colors</header>\n        <input type=\"color\" name=\"iconColor\" title=\"Icons\" value=\"#13287d\" selected>\n        <input type=\"color\" name=\"iconColorClicked\" title=\"Icons Clicked\" value=\"#ffffff\" selected>\n        <input type=\"color\" name=\"iconColorClickedBg\" title=\"Icons Clicked Bg\" value=\"#279e64\" selected>\n        <input type=\"color\" name=\"lineColor\" title=\"Line\" value=\"#efefef\" selected>\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-6\">\n                <div class=\"img-wrap mb-5\">\n                    <img src=\"@PROJECT_PATH@/assets/images/design-3588214.jpg\" alt title>\n                </div>\n            </div>\n            <div class=\"col-lg-6 content\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style align-left mbr-semibold\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".content .mbr-section-subtitle\">So you are sure</h3>\n                <h2 class=\"mbr-fonts-style mbr-section-title align-left mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".content .mbr-section-title\">Common questions</h2>\n                <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-article data-app-selector=\".content .mbr-text\" data-multiline mbr-if=\"showText\">\n                    Etiam non purus eros. Nam convallis lectus at felis faucibus, commodo vestibulum magna laoreet.\n                    Aenean nec\n                    sem semper sem ultricies interdum.</p>\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\n                                <h4 class=\"mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">How do you charge for services?\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                </h4>\n\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">Our fees are based on your requirements. We quote fixed fees in advance to avoid any surprises. Our fees are reasonable which take into account prompt and efficient delivery of services tailored to you and your business needs.&nbsp;</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>FREE appointments?</h4>\n                            </a>\n\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body pt\">Appointments can be made to meet in person or telephone calls to suit your convenience. You can contact us on - info@accountancygroup.com or on 020 8653 8538 or book an appointment via the website.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>FREE software and training?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">For regular accounting clients we can provide free software training and guidance to help you comply and monitor the performance of your business in real time and on a regular basis.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Support &amp; assistance other than accounting?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">We can help you structure your business efficiently so it meets your aims and goals. We cover business structure, salary, dividend planning, VAT, PAYE compliance, regular tax planning, management accounts and business planning. We aim to provide a holistic solutions to your needs.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    Bank accounts?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    What method of payment do you accept?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body pt\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 6\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse7\" aria-expanded=\"false\" aria-controls=\"collapse7\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Anything i should\n                                    know as a new client?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse7\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 7\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse8\" aria-expanded=\"false\" aria-controls=\"collapse8\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Can I make special\n                                    request?\n                                </h4>\n                            </a>\n\n                        </div>\n                        <div id=\"collapse8\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 8\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse9\" aria-expanded=\"false\" aria-controls=\"collapse9\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>Any cancellation\n                                    fees?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse9\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">Sem nulla\n                                    pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus turpis.\n                                    Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat vivamus at\n                                    augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 9\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse10\" aria-expanded=\"false\" aria-controls=\"collapse10\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    Do you clean basementsand attics?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse10\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 10\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse11\" aria-expanded=\"false\" aria-controls=\"collapse11\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    How do i cancel of reshedule?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse11\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 11\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black pr-5\" data-toggle=\"collapse\" data-core href=\"#collapse12\" aria-expanded=\"false\" aria-controls=\"collapse12\">\n                                <h4 class=\" mbr-fonts-style mbr-section-subtitle mbr-semibold\" mbr-theme-style=\"display-7\" data-app-selector=\".card .card-header a.panel-title h4\">\n                                    <span class=\"toggle-icon inactive sign mbr-iconfont\"></span>\n                                    I don't need bathrrom/bedrooms cleaned?\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse12\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style mbr-text mbr-regular panel-text pr-5\" mbr-theme-style=\"display-4\" data-app-selector=\".card .panel-body p\">\n                                    Sem nulla pharetra diam sit. Sapien eget mi proin sed libero enim sed faucibus\n                                    turpis. Vulputate odio ut enim blandit volutpat. Cras tincidunt lobortis feugiat\n                                    vivamus at augue eget. </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sdNxunxmnB",
          "_anchor": "accordion1-4c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<div>\n<!-- Calendly inline widget begin -->\n<div class=\"calendly-inline-widget\" data-url=\"https://calendly.com/info-21052/30min\" style=\"min-width:320px;height:700px;\"></div>\n[JS_CODE_0]\n<!-- Calendly inline widget end -->\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "cleanm4",
          "_anchor": "custom-html-93",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script type=\"text/javascript\" src=\"https://assets.calendly.com/assets/external/widget.js\"></script>"
          ]
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".text-content": {
              ".mbr-subtitle": {
                "color": "@secondaryColor"
              },
              ".mbr-section-title": {
                "color": "@primaryColor"
              },
              ".mbr-text": {
                "color": "@infoColor"
              },
              ".list-block": {
                "margin-top": "16px",
                "padding-bottom": "16px",
                ".card-img": {
                  "width": "auto",
                  "span": {
                    "color": "@secondaryColor",
                    "font-size": "1.5rem"
                  }
                },
                ".list-item-title": {
                  "color": "@primaryColor",
                  "transition": "all .3s linear 0s",
                  "&:hover": {
                    "color": "@listTitleHoverColor"
                  }
                },
                ".list-item-text": {
                  "padding-top": "10px",
                  "color": "@infoColor",
                  "margin-bottom": "0"
                }
              },
              ".list-block.last": {
                "border-bottom": "none",
                "margin-bottom": "20px",
                "padding-bottom": "0"
              },
              ".social": {
                "font-size": "1.2rem",
                "span": {
                  "margin-right": "11.2px",
                  "margin-bottom": "8px",
                  "transition": "0.3s all",
                  "color": "@socIconsColor",
                  "&:hover": {
                    "color": "@socIconsHover",
                    "transition": "0.3s all"
                  }
                }
              }
            },
            ".card-img": {
              "display": "none",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "text-align": "left"
            },
            "& when (@showIcons)": {
              ".list-block": {
                "position": "relative",
                "& h4, p": {
                  "padding-left": "2.625rem"
                }
              },
              ".card-img": {
                "display": "block"
              }
            },
            "& when (@customStyle)": {
              "input, textarea": {
                "border-radius": "3px",
                "min-height": "3rem",
                "padding": "13px 20px !important",
                "font-size": "13px",
                "color": "@successColor",
                "height": "60px"
              },
              ".form-control, .field-input": {
                "padding": "13px 20px !important",
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none",
                "&:hover, &:focus": {
                  "background-color": "@fieldHover",
                  "border-color": "@borderHover",
                  "color": "contrast(@fieldColor)",
                  "box-shadow": "none",
                  "outline": "none"
                },
                "&:focus": {
                  "box-shadow": "0 2px 9px 2px rgba(0, 0, 0, 0.15)"
                }
              },
              "input::-webkit-input-placeholder, textarea::-webkit-input-placeholder": {
                "color": "@formPlaceholder"
              },
              "input:-moz-placeholder, textarea:-moz-placeholder": {
                "color": "@formPlaceholder"
              },
              ".jq-selectbox li, .jq-selectbox li": {
                "background-color": "@fieldColor",
                "color": "contrast(@fieldColor)"
              },
              ".jq-selectbox li:hover, .jq-selectbox li.selected": {
                "background-color": "@fieldHover",
                "color": "contrast(@fieldHover)"
              },
              ".jq-selectbox:hover .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldColor"
              },
              ".jq-selectbox .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldHover"
              }
            },
            ".mbr-form": {
              "max-width": "550px",
              ".content-title": {
                "color": "@primaryColor",
                "margin-bottom": "20px"
              },
              ".content-subtitle": {
                "color": "@infoColor"
              },
              "textarea": {
                "min-height": "100px",
                "height": "194px"
              },
              ".btn": {
                "justify-content": "space-between",
                "border-radius": "30px",
                "border-color": "@primaryColor",
                "color": "@primaryColor",
                "padding": "18px 42px",
                "margin": "0 !important",
                "margin-top": "7px !important"
              },
              ".btn-success": {
                "&:hover": {
                  "background-color": "@secondaryColor !important",
                  "border-color": "@secondaryColor !important",
                  "color": "#fff !important"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".mbr-form": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              ".mbr-section-title, .content-title, .mbr-section-btn": {
                "text-align": "left"
              }
            }
          },
          "_name": "form2",
          "_customHTML": "<section class=\"form2\" group=\"Forms & Maps\" plugins=\"formstyler, datepicker\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Contacts Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" checked>\n        <input type=\"color\" name=\"listTitleHoverColor\" title=\"List Hover Color\" value=\"#279e64\" condition=\"showListTitle\">\n        <input type=\"checkbox\" title=\"List Text\" name=\"showListText\">\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\">\n        <select title=\"List items\" name=\"listItemsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <select title=\"Social Icons\" name=\"socialIconsCount\" condition=\"showSocialIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Form Title\" name=\"showFormTitle\">\n        <input type=\"checkbox\" title=\"Form Text\" name=\"showFormText\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <header>Style</header>\n        <input type=\"color\" name=\"socIconsColor\" title=\"Soc icons\" value=\"#13287d\" condition=\"showSocialIcons\">\n        <input type=\"color\" name=\"socIconsHover\" title=\"Soc icons hover\" value=\"#279e64\" condition=\"showSocialIcons\">\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#dcdfe2\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#279e64\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#6d7a8c\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#eff2f7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay&&bg.type=='image')\"></div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 mb-5 text-content\">\n\n                <h3 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".text-content .mbr-subtitle\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-4\">Get in touch</h3>\n                <h2 class=\"mbr-section-title align-left mbr-bold mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\" data-app-selector=\".text-content .mbr-section-title\"><div>Have more questions?</div></h2>\n                <p class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .mbr-text\" mbr-if=\"showText\">Lorem\n                    ipsum\n                    dolor sit amet, consectetur adipiscing elit. Etiam dignissim quis mi eu tristique. Cras et\n                    massa erat. Quisque tempus, dolor sit amet ultrices mattis.</p>\n                <div class=\"list-block mt-5\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-mobile mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">020 8653 8538</h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">24/7 Support\n                        <br> Call Us\n                    </p>\n                </div>\n                <div class=\"list-block\" mbr-if=\"listItemsAmount > 1\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-pin mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">SVS House, Oliver Grove<div><br></div><div>South Norwood, London SE25 6EJ</div></h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">Find Us\n                        Location</p>\n                </div>\n                <div class=\"list-block last\" mbr-if=\"listItemsAmount > 2\">\n                    <div class=\"card-img pb-3\" mbr-if=\"showIcons\">\n                        <span mbr-icon class=\"mbri-letter mbr-iconfont\"></span>\n                    </div>\n                    <h4 class=\"list-item-title mbr-fonts-style mbr-regular\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".text-content .list-block .list-item-title\">\n                        info@accountancygroup.com</h4>\n                    <p class=\"mbr-fonts-style mbr-text list-item-text\" mbr-theme-style=\"display-4\" data-app-selector=\".text-content .list-block .list-item-text\" mbr-if=\"showListText\">\n                        Email</p>\n                </div>\n                <div class=\"social mt-4\" mbr-if=\"showSocialIcons\">\n                    <span mbr-icon class=\"mbr-iconfont fa-facebook-square fa\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-twitter-square fa\" mbr-if=\"socialIconsCount > 1\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-linkedin-square fa\" mbr-if=\"socialIconsCount > 2\"></span>\n                    <span mbr-icon class=\"mbr-iconfont fa-instagram fa\" mbr-if=\"socialIconsCount > 3\"></span>\n                </div>\n            </div>\n            <div mbr-form class=\"col-lg-6 mx-auto mbr-form\" mbr-class=\"{'order-2': reverseContent}\">\n<!--Formbuilder Form-->\n<form action=\"info@accountancygroup.com\" name=\"AG form\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! We will be in touch shortly.</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-6 form-group\" data-for=\"first-name\">\n<input type=\"text\" name=\"first-name\" placeholder=\"Your Name*\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 form-group\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"Your Email*\" data-form-field=\"email\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div data-for=\"message\" class=\"col-lg-12 form-group\">\n<textarea name=\"message\" placeholder=\"Your Comment*\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-lg-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"btn btn-success btn-form btn-lg\">Send message</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "sdNxuogkZF",
          "_anchor": "form2-4e",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n   <iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2489.2551749788176!2d-0.07918208404939583!3d51.39836587961745!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48760124bec86a13%3A0xdcbc8f030c5ca84e!2sAccountancy%20Group%20Plc!5e0!3m2!1sen!2suk!4v1603050927076!5m2!1sen!2suk\" width=\"100%\" height=\"450\" frameborder=\"0\" style=\"border:0;\" allowfullscreen=\"\" aria-hidden=\"false\" tabindex=\"0\"></iframe>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "cleanm4",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_params": {},
          "_anchor": "custom-html-4t"
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".navbar-logo": {
              "width": "100px",
              "margin-bottom": "10px",
              "margin": "auto"
            },
            ".navbar-brand": {
              "margin": "auto",
              "width": "100%",
              "text-align": "center"
            },
            ".socicon": {
              "font-size": "1.3rem",
              "background": "@Icons",
              "border-radius": "100%",
              "width": "40px",
              "height": "40px",
              "display": "flex",
              "-webkit-align-items": "center",
              "align-items": "center",
              "-webkit-justify-content": "center",
              "justify-content": "center"
            },
            ".social-list": {
              "padding-left": "0",
              "margin-bottom": "0",
              "list-style": "none",
              ".soc-item": {
                "display": "inline-block",
                "margin": "0 0.3rem"
              }
            },
            ".text2": {
              "color": "#000000",
              "text-align": "left"
            },
            ".group-title": {
              "text-align": "left",
              "color": "#000000",
              "padding-bottom": "0.2rem"
            },
            ".logo-title": {
              "text-align": "center"
            },
            ".logo-sub-title": {
              "text-align": "center"
            },
            ".links": {
              "text-align": "center",
              "color": "#656565"
            },
            ".logo-sub-title i": {
              "color": "#9e9e9e"
            },
            ".links, .social-list": {
              "color": "#0a1126"
            }
          },
          "_name": "extFooter26",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"extFooter\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <select title=\"Icons\" name=\"iconsCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showlogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Sub Title\" name=\"showSub\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Color</header>\n        <input type=\"color\" value=\"#e9e9e9\" name=\"Icons\" title=\"Icon\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-lg-6 col-md-8 col-sm-12\">\n\n                <div class=\"navbar-brand pb-3\" mbr-if=\"showlogo\">\n                    <div class=\"logo\">\n                        <a href=\"https://mobiri.se\">\n                            <img class=\"navbar-logo\" src=\"@PROJECT_PATH@/assets/images/logo.svg\" alt=\"Mobirise\">\n                        </a>\n                    </div>\n                </div>\n\n                <h3 mbr-if=\"showTitle\" class=\"mbr-text mbr-bold mbr-fonts-style logo-title\" mbr-theme-style=\"display-7\" data-app-selector=\".logo-title, .logo\">Company\n                    Name\n                </h3>\n\n                <h4 mbr-if=\"showSub\" class=\"mbr-text mbr-fonts-style logo-sub-title\" mbr-theme-style=\"display-4\" data-app-selector=\".logo-sub-title\"><i>University</i></h4>\n\n\n\n                <div class=\"social-list align-center py-4\" mbr-if=\"iconsCount > 0\">\n                    <div class=\"soc-item\" mbr-if=\"iconsCount > 0\">\n                        \n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-twitter socicon\" style=\"color: rgb(255, 124, 0); fill: rgb(255, 124, 0);\"></div>\n                        \n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>1\">\n                        \n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\" style=\"color: rgb(255, 124, 0); fill: rgb(255, 124, 0);\"></div>\n                        \n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>2\">\n                        <a href=\"https://plus.google.com/u/0/+Mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-googleplus socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>3\">\n                        <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-skype socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>4\">\n                        <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"iconsCount>5\">\n                        <a href=\"https://instagram.com/mobirise\" target=\"_blank\">\n                            <div mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\" style=\"color: rgb(101, 101, 101);\"></div>\n                        </a>\n                    </div>\n                </div>\n                <p mbr-if=\"showText\" class=\"mbr-text mbr-normal py-2 links mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".links, .social-list\">Copyright © 2022 - 23 - Accountancy Group<br>All Rights Reserved. Site by - <a href=\"https://www.trafik.design\" class=\"text-warning text-primary\" target=\"_blank\">Trafik.Design</a></p>\n\n            </div>\n\n\n\n\n\n\n\n\n\n        </div>\n    </div>\n\n</section>",
          "_cid": "sdNxup37T3",
          "_anchor": "extFooter26-4g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".navbar": {
              "padding": "0.5rem 0",
              "background": "@menuBgColor",
              "transition": "none",
              "min-height": "50px"
            },
            ".navbar-fixed-top": {
              "padding-top": "0"
            },
            ".navbar-collapse": {
              "flex-basis": "auto",
              "transition": "all 0.3s ease-in",
              "&.show": {
                "position": "absolute",
                "opacity": "1",
                "visibility": "visible",
                "top": "100%",
                "z-index": "999",
                "background-color": "rgb(255, 255, 255)",
                "border-top": "1px solid rgba(0, 0, 0, 0.08)",
                "padding": "15px 20px",
                "bottom": "auto",
                "left": "0px",
                "right": "0px",
                ".navbar-nav": {
                  ".nav-item": {
                    "text-align": "left",
                    "padding": "10px 0"
                  }
                }
              }
            },
            ".navbar-buttons when (@showButtons)": {
              "flex-wrap": "wrap"
            },
            ".menu-logo": {
              ".navbar-brand": {
                "display": "flex",
                "margin-left": "1.5rem",
                "padding": "0.5rem 0",
                "transition": "padding 0.2s",
                "min-height": "3.8rem",
                "align-items": "center",
                ".navbar-caption-wrap": {
                  "display": "flex",
                  "align-items": "center",
                  "word-break": "break-word",
                  "min-width": "7rem",
                  "margin": "0.3rem 0",
                  ".navbar-caption": {
                    "padding-right": "2rem"
                  }
                },
                ".navbar-logo": {
                  "font-size": "4rem",
                  "transition": "font-size 0.25s",
                  "& img": {
                    "display": "flex"
                  },
                  ".mbr-iconfont": {
                    "transition": "font-size 0.25s"
                  }
                }
              }
            },
            ".menu-content-top": {
              "background": "@menutopColor",
              "max-width": "100%",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "0 2rem",
              "width": "100%",
              "align-items": "center",
              "overflow": "hidden",
              "transition": "min-height 0.25s ease-in-out",
              ".right-wrap": {
                ".info-widget:last-child": {},
                ".info-widget": {
                  "& when (@widgetCount = '2')": {
                    "&:nth-child(2)": {
                      "padding-right": "0 !important"
                    }
                  }
                },
                ".info-widget:first-child": {
                  "padding-left": "0",
                  "border-left": "none"
                }
              }
            },
            ".dropdown-item": {
              "font-weight": "400",
              "margin": "0 !important",
              "padding": "0 40px !important",
              "line-height": "2.6"
            },
            ".dropdown-item, .nav-link, .brand-name": {
              "font-style": "normal",
              "&:hover": {
                "color": "@hoverItemsColor !important"
              }
            },
            ".dropdown-menu": {
              "background-color": "@drColor"
            },
            ".dropdown-item:active": {
              "background-color": "@drColor"
            },
            ".menu-bottom": {
              "margin": "auto",
              "width": "100%",
              "display": "flex",
              "padding": "0rem 2rem",
              "position": "relative",
              "align-items": "center",
              "& when (@menuAlign = \"center\")": {
                "justify-content": "center"
              },
              "& when (@menuAlign = \"right\")": {
                "justify-content": "flex-end"
              }
            },
            ".navbar-dropdown.bg-color.transparent.opened": {
              "background": "@menuBgColor"
            },
            ".nav-item": {
              "position": "relative",
              "& span": {
                "padding-right": "0.4em",
                "vertical-align": "text-bottom",
                "position": "relative",
                "top": "-0.2em",
                "text-decoration": "none"
              },
              ".nav-link": {
                "transition": "all 0.3s ease-in-out 0ms",
                "&:focus": {
                  "outline": "none"
                }
              }
            },
            "@media (min-width: 991px)": {
              ".nav-link": {
                "line-height": "6.13"
              },
              ".navbar-nav > li > a:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "-1px",
                "left": "0",
                "width": "0",
                "margin": "auto",
                "opacity": "0",
                "border-top": "2px solid @hoverLineColor",
                "transition": "all 0.3s ease-in-out 0ms"
              },
              ".navbar-nav > li:hover > a:before": {
                "opacity": "1",
                "width": "100%"
              },
              ".dropdown-item": {
                "color": "@infoColor !important",
                "border-bottom": "0px solid @drbrColor"
              }
            },
            ".dropdown-item:before": {
              "font-family": "MobiriseIcons !important",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".content-text": {
              "margin-bottom": "0"
            },
            ".navbar-nav": {
              "position": "relative",
              "flex-direction": "row",
              "@media (min-width: 992px)": {
                ".main-menu-animated-line": {
                  "position": "absolute",
                  "left": "0",
                  "width": "0",
                  "height": "0",
                  "z-index": "100",
                  "border-top": "4px solid @primaryColor",
                  "transition": "width 0.4s, left 0.6s cubic-bezier(0.19, 0.65, 0.02, 0.93)",
                  "&.bottom": {
                    "bottom": "0"
                  }
                }
              },
              ".nav-item span": {
                "padding-right": "0"
              },
              ".nav-item .link": {
                "margin": "0 20px !important"
              }
            },
            ".navbar-buttons.mbr-section-btn": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".menu .navbar-brand .logo-text-part": {
              "vertical-align": "top"
            },
            ".content-right-side": {
              "text-align": "center"
            },
            ".content-right-side .content-link": {
              "margin-left": "2rem",
              "span": {
                "vertical-align": "middle",
                "padding-right": "1rem"
              }
            },
            ".widget-icon": {
              "display": "inline-block",
              "padding-right": "1rem",
              "font-size": "1.65rem",
              "&.mobi-mbri-phone": {
                "-webkit-animation": "phone-icon-animate 1s ease-in-out infinite",
                "animation": "phone-icon-animate 1s ease-in-out infinite"
              },
              "color": "@secondaryColor"
            },
            ".info-widget": {
              "margin-left": "60px",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "&:first-child": {
                "margin-left": "0"
              }
            },
            ".widget-content": {
              "display": "inline-block",
              "vertical-align": "top",
              "text-align": "left",
              ".widget-title": {
                "margin-bottom": "3px",
                "line-height": "1.7"
              },
              ".widget-text": {
                "margin-bottom": "0"
              }
            },
            ".navbar .menu-content-top": {
              "display": "flex",
              "height": "90px",
              "border-bottom": "1px solid #e1e3e6"
            },
            "@media (min-width: 992px)": {
              ".content-right-side": {
                "text-align": "right",
                "flex-wrap": "nowrap",
                "display": "flex",
                "align-items": "center"
              },
              ".navbar": {
                "display": "block",
                "padding": "0",
                ".menu-logo": {
                  "margin": "auto",
                  "display": "flex",
                  "align-items": "center"
                }
              },
              ".navbar.navbar-toggleable-sm .navbar-collapse .navbar-nav .nav-item": {
                "align-self": "auto",
                "display": "flex",
                "align-items": "center",
                "z-index": "101",
                "min-height": "49px"
              },
              ".dropdown-item:hover:before": {
                "transform": "scale(1, 1)",
                "width": "16px",
                "-webkit-transform": "scale(1, 1)"
              },
              ".navbar-toggler": {
                "display": "none"
              },
              ".navbar-collapse": {
                "& when (@menuAlign = \"center\")": {
                  "justify-content": "center"
                },
                "& when (@menuAlign = \"right\")": {
                  "justify-content": "flex-end"
                },
                "& when (@menuAlign = \"left\")": {
                  "justify-content": "flex-start"
                }
              }
            },
            ".navbar-short .menu-content-top": {
              "height": "0",
              "min-height": "0",
              "border": "none"
            },
            ".btn": {
              "display": "-webkit-inline-flex",
              "align-items": "center",
              "-webkit-align-items": "center",
              "position": "relative",
              "overflow": "hidden",
              "margin-right": "0",
              "&-sm": {
                "padding": "13px 29px"
              },
              ".mbr-iconfont": {
                "font-size": "1.2em"
              },
              "&::after": {
                "background-color": "@infoColor",
                "content": "\"\"",
                "height": "150px",
                "left": "-75px",
                "position": "absolute",
                "top": "-60px",
                "transform": "rotate(35deg)",
                "transition": "all 1.5s cubic-bezier(0.19, 1, 0.22, 1)",
                "width": "40px",
                "opacity": "0",
                "outline": "none",
                "text-decoration": "none"
              },
              "&:hover": {
                "&::after": {
                  "left": "250px",
                  "opacity": "0.8"
                }
              }
            },
            ".navbar-toggleable-sm .navbar-collapse": {
              "width": "auto",
              ".navbar-nav": {
                "flex-wrap": "wrap",
                "padding-left": "0",
                ".nav-item": {
                  "align-self": "center"
                }
              },
              ".navbar-buttons": {
                "padding-left": "0",
                "padding-bottom": "0"
              }
            },
            ".dropdown": {
              ".dropdown-menu": {
                "display": "none",
                "position": "absolute",
                "@media (max-width: 991px)": {
                  "overflow": "hidden"
                },
                "padding": "25px 0",
                "text-align": "left",
                ".dropdown-item": {
                  "width": "auto",
                  "transition": "all 0.25s ease-in-out",
                  "&::after": {
                    "right": "0.5rem"
                  },
                  "&:hover": {
                    ".mbr-iconfont:before": {
                      "transform": "scale(0, 1)"
                    }
                  },
                  ".mbr-iconfont": {
                    "margin-left": "-1.8rem",
                    "padding-right": "1rem",
                    "font-size": "inherit",
                    "&:before": {
                      "display": "inline-block",
                      "transform": "scale(1, 1)",
                      "transition": "all 0.25s ease-in-out"
                    }
                  }
                },
                ".dropdown-submenu": {
                  "margin": "0"
                }
              },
              "&.open > .dropdown-menu": {
                "display": "block"
              }
            },
            ".navbar.navbar-short": {
              "min-height": "50px",
              "transition": "all 0.2s",
              "& .navbar-logo a": {
                "font-size": "2.5rem !important",
                "transition": "font-size 0.25s",
                "& .mbr-iconfont": {
                  "font-size": "2.5rem !important"
                },
                "& img": {
                  "height": "3rem !important"
                }
              },
              "& .navbar-brand": {
                "min-height": "3rem"
              }
            },
            "button.navbar-toggler": {
              "width": "31px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "margin": "1rem 0.8rem",
              "margin-right": "0",
              "&:focus": {
                "outline": "none"
              },
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              },
              ".btn": {
                "display": "flex"
              },
              ".navbar-collapse": {
                "display": "none !important",
                "padding-right": "0 !important",
                "&.collapsing, &.show": {
                  "display": "block !important",
                  ".navbar-nav": {
                    "display": "block",
                    "text-align": "center",
                    ".nav-item": {
                      "clear": "both",
                      "& when (@showButtons = false)": {
                        "&:last-child": {
                          "margin-bottom": "1rem"
                        }
                      }
                    }
                  },
                  ".navbar-buttons": {
                    "display": "flex",
                    "justify-content": "center",
                    "text-align": "center",
                    "&:last-child": {
                      "margin-bottom": "1rem"
                    }
                  }
                }
              },
              "@media (min-width: 992px)": {
                ".dropdown .dropdown-menu": {
                  "overflow": "hidden"
                }
              },
              "button.navbar-toggler": {
                "display": "block"
              },
              ".navbar-brand": {
                "margin-left": "1rem !important",
                "margin-top": "0.5rem"
              },
              ".navbar-toggleable-sm": {
                "flex-direction": "column"
              },
              ".dropdown": {
                ".dropdown-menu": {
                  "width": "100%",
                  "text-align": "center",
                  "position": "relative",
                  "opacity": "0",
                  "display": "block",
                  "height": "0",
                  "visibility": "hidden",
                  "padding": "0",
                  "transition-duration": "0.5s",
                  "transition-property": "opacity, padding, height"
                },
                "&.open > .dropdown-menu": {
                  "position": "relative",
                  "opacity": "1",
                  "height": "auto",
                  "padding": "1.4rem 0",
                  "visibility": "visible"
                },
                ".dropdown-submenu": {
                  "left": "0",
                  "text-align": "center",
                  "width": "100%"
                },
                ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after": {
                  "margin-top": "0",
                  "position": "inherit",
                  "right": "0",
                  "top": "50%",
                  "display": "inline-block",
                  "width": "0",
                  "height": "0",
                  "margin-left": "0.3em",
                  "vertical-align": "middle",
                  "content": "\"\"",
                  "border-top": "0.3em solid",
                  "border-right": "0.3em solid transparent",
                  "border-left": "0.3em solid transparent"
                }
              },
              ".menu-bottom": {
                "justify-content": "center"
              }
            },
            "@media (max-width: 991px)": {
              ".dropdown-menu": {
                "margin-top": "0px",
                "background-color": "transparent",
                "color": "black !important",
                "padding-left": "20px !important",
                ".dropdown-item": {
                  "text-align": "left",
                  "font-weight": "700"
                }
              },
              ".menu-bottom": {
                "display": "flex",
                "flex-direction": "row",
                "justify-content": "space-between",
                "align-items": "center",
                "margin": "0",
                ".menu-content-right": {
                  "display": "none"
                }
              },
              ".navbar-collapse": {
                "padding-bottom": "1rem",
                "display": "none !important",
                "padding-right": "0 !important",
                "opacity": "0",
                "transition": "all 0.3s ease-in",
                "position": "absolute",
                "top": "100%",
                "bottom": "auto",
                "left": "0px",
                "right": "0px",
                "z-index": "999",
                ".navbar-nav": {
                  ".nav-item": {
                    "clear": "both",
                    "text-align": "left",
                    "padding": "10px 0"
                  }
                },
                "&.collapsing, &.show": {
                  "display": "block !important",
                  ".navbar-nav": {
                    "display": "block",
                    "text-align": "center",
                    ".nav-item": {
                      "clear": "both",
                      "& when (@showButtons = false)": {
                        "&:last-child": {
                          "margin-bottom": "1rem"
                        }
                      },
                      ".nav-link": {
                        "font-weight": "700"
                      }
                    }
                  },
                  ".navbar-buttons": {
                    "display": "-webkit-flex",
                    "justify-content": "center",
                    "text-align": "center",
                    "-webkit-justify-content": "center",
                    "&:last-child": {
                      "margin-bottom": "1rem"
                    }
                  }
                }
              },
              "img": {
                "height": "3.8rem !important"
              },
              ".btn": {
                "display": "flex"
              },
              "button.navbar-toggler": {
                "display": "block"
              },
              ".navbar-brand": {
                "margin-left": "1rem !important",
                "margin-top": "0.5rem"
              },
              ".navbar-toggleable-sm": {
                "flex-direction": "column"
              },
              ".dropdown": {
                ".dropdown-menu": {
                  "width": "100%",
                  "text-align": "center",
                  "position": "relative",
                  "opacity": "0",
                  "display": "block",
                  "height": "0",
                  "visibility": "hidden",
                  "padding": "0",
                  "transition-duration": "0.5s",
                  "transition-property": "opacity, padding, height"
                },
                "&.open > .dropdown-menu": {
                  "position": "relative",
                  "opacity": "1",
                  "height": "auto",
                  "padding": "1.4rem 0",
                  "visibility": "visible"
                },
                ".dropdown-submenu": {
                  "left": "0",
                  "text-align": "center",
                  "width": "100%"
                },
                ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after": {
                  "margin-top": "0",
                  "position": "inherit",
                  "right": "0",
                  "top": "50%",
                  "display": "inline-block",
                  "width": "0",
                  "height": "0",
                  "margin-left": "0.3em",
                  "vertical-align": "middle",
                  "content": "\"\"",
                  "border-top": "0.3em solid",
                  "border-right": "0.3em solid transparent",
                  "border-left": "0.3em solid transparent"
                }
              },
              ".navbar-buttons.mbr-section-btn": {
                "width": "100%"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar-toggler": {
              "position": "relative"
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "color": "initial"
            },
            ".widget-title": {
              "color": "@infoColor"
            },
            ".widget-text": {
              "color": "@infoColor"
            },
            ".icons-menu": {
              "flex-wrap": "wrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "text-align": "center",
              "align-items": "center",
              ".mbr-iconfont": {
                "font-size": "1rem",
                "color": "@primaryColor",
                "display": "inline-flex",
                "background-color": "@iconsBgColor",
                "border-radius": "100%",
                "transition": "all 0.3s ease-in",
                "&:before": {
                  "padding": ".75rem"
                },
                "&:hover": {
                  "color": "@iconsHoverolor",
                  "background-color": "@iconsHoverBgColor",
                  "-webkit-animation-name": "animation-pulse",
                  "animation-name": "animation-pulse",
                  "-webkit-animation-duration": "1s",
                  "animation-duration": "1s",
                  "-webkit-animation-timing-function": "linear",
                  "animation-timing-function": "linear",
                  "-webkit-animation-iteration-count": "infinite",
                  "animation-iteration-count": "infinite",
                  "opacity": ".9"
                }
              }
            },
            ".soc-item": {
              "margin": ".5rem .3rem"
            },
            "@media (max-width: 768px)": {
              ".menu-content-top": {
                ".icons-menu": {
                  "padding-left": "0",
                  ".soc-item": {
                    ".mbr-iconfont": {
                      "font-size": "14px",
                      "&::before": {
                        "padding": "0.44rem"
                      }
                    }
                  }
                },
                ".right-wrap": {
                  ".info-widget": {
                    "margin-left": "20px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    ".widget-content": {
                      "display": "none"
                    },
                    ".widget-icon": {
                      "font-size": "25px",
                      "padding-right": "0"
                    }
                  }
                }
              },
              ".navbar-brand": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 576px)": {
              ".menu-content-top, .menu-bottom": {
                "padding": "0 15px"
              },
              "button.navbar-toggler": {
                "align-self": "center"
              }
            },
            "@-webkit-keyframes phone-icon-animate": {
              "0%, 100%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              },
              "10%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "20%, 40%": {
                "transform": "rotate(20deg) scale(1) skew(1deg)"
              },
              "30%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "50%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              }
            },
            "@keyframes phone-icon-animate": {
              "0%, 100%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              },
              "10%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "20%, 40%": {
                "transform": "rotate(20deg) scale(1) skew(1deg)"
              },
              "30%": {
                "transform": "rotate(-20deg) scale(1) skew(1deg)"
              },
              "50%": {
                "transform": "rotate(0) scale(1) skew(1deg)"
              }
            },
            "@-webkit-keyframes animation-pulse": {
              "25%": {
                "transform": "scale(1.1)"
              },
              "75%": {
                "transform": "scale(0.9)"
              }
            },
            "@keyframes animation-pulse": {
              "25%": {
                "transform": "scale(1.1)"
              },
              "75%": {
                "transform": "scale(0.9)"
              }
            },
            ".widget-title, .widget-icon": {
              "color": "#0239b6"
            }
          },
          "_name": "menu2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"menu2 menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global always-top position-absolute once=\"menu\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"0\">0</option>\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <select title=\"Widget Count\" name=\"widgetCount\">\n            <option value=\"0\">0</option>\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <select title=\"Menu Align\" name=\"menuAlign\">\n            <option value=\"left\">Left</option>\n            <option value=\"center\">Center</option>\n            <option value=\"right\" selected>Right</option>\n        </select>\n\n\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.5\" value=\"4\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Top Menu\" name=\"menutopColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown Border\" name=\"drbrColor\" value=\"#4f5b77\">\n        <input type=\"color\" title=\"Hover Items\" name=\"hoverItemsColor\" value=\"#ff7c00\">\n        <input type=\"color\" title=\"Hover Line\" name=\"hoverLineColor\" value=\"#279e64\">\n        <input type=\"color\" title=\"Icons Bg\" name=\"iconsBgColor\" value=\"#eaebee\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Bg Hover\" name=\"iconsHoverBgColor\" value=\"#279e64\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Hover\" name=\"iconsHoverolor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#1b1a1a\">\n\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\" mbr-if=\"widgetCount > 0 &amp;&amp; iconsAmount > 0\">\n            <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                <div class=\"soc-item\">\n                    <a href=\"https://twitter.com/Ruvas\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 1\">\n                    <a href=\"https://www.facebook.com/AccountancyGroup?ref=hl\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 2\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 3\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 4\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-googleplus\"></span>\n                    </a>\n                </div>\n                <div class=\"soc-item\" mbr-if=\"iconsAmount > 5\">\n                    <a href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon socicon-behance\"></span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"right-wrap d-flex align-items-center\">\n                <div class=\"info-widget\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mdi-communication-business\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">How we can help</p>\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"Covid-19.html\" class=\"text-primary\" style=\"font-weight: bold;\">Covid 19</a>&nbsp;<b>&amp; Brexit</b></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 1\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">Need help?</p>\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><b>020 8653 8538</b><br></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 2\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">Email</p>\n                        <p class=\"mbr-fonts-style mbr-regular widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><b>info@accountancygroup.com</b></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"menu-bottom\">\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-with-tagline.svg\" alt=\"AG logo\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-5\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\">\n                        <a href=\"https://mobiri.se\" class=\"brand-name text-primary mbr-bold\" data-app-selector=\".brand-name\" data-app-placeholder=\"Type Text\">CleanM4</a>\n                    </span>\n                </div>\n            </div>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish&&!showBrand&&!showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link text-black text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            Home</a>\n                    </li>\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"true\">Your Business</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item text-black text-primary\" href=\"Retail-and-wholesale.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Retail &amp; wholesale</a>\n                            <a class=\"dropdown-item text-black text-primary\" href=\"Healthcare.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Healthcare</a>\n                            <a class=\"dropdown-item text-black text-primary\" href=\"Hospitality.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Hospitality</a><a class=\"dropdown-item text-black text-primary\" href=\"Property.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Property</a><a class=\"dropdown-item text-black text-primary\" href=\"Construction.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Construction</a><a class=\"dropdown-item text-black text-primary\" href=\"Contractors.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Contractors</a><a class=\"dropdown-item text-black text-primary\" href=\"Professionals.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Professional services</a>\n                        </div>\n                    </li>\n                    \n                    \n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link text-black text-primary\" href=\"Who-we-are.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"true\">\n                            Who we are</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            Contact us</a>\n                    </li></ul>\n            </div>\n            <div class=\"menu-content-right\">\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-success\" href=\"index.html#custom-html-8w\" data-app-placeholder=\"Type Text\">FREE Consultation</a></div>\n            </div>\n            <button class=\"navbar-toggler \" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n        </div>\n    </nav>\n</section>",
