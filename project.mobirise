                "display": "none !important",
                "padding-right": "0 !important",
                "opacity": "0",
                "transition": "all 0.3s ease-in",
                "position": "absolute",
                "top": "100%",
                "bottom": "auto",
                "left": "0px",
                "right": "0px",
                "z-index": "999",
                ".navbar-nav": {
