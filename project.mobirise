        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@mediaLeft)": {
              ".photo-split": {
                ".element-outer": {
                  "display": "none"
                },
                ".element-outer2": {
                  "display": "none"
                },
                ".element-inner": {
                  "display": "none"
                }
              },
              ".wrap-block": {
                "padding-left": "30px"
              },
              ".cards": {
                "padding-right": "30px"
              }
            },
            "& when not (@mediaLeft)": {
              ".wrap-block": {
                "padding-right": "30px"
              },
              ".cards": {
                "padding-left": "30px"
              }
            },
            ".content-row": {
              "& when (@mediaLeft)": {
                "flex-direction": "row-reverse"
              }
            },
            ".image-wrap": {
              "img": {
                "max-width": "100%",
                "max-height": "800px",
                "z-index": "9",
                "position": "relative"
              }
            },
            ".wrap-block": {
              ".contents": {
                "margin-bottom": "40px",
                ".mbr-subtitle": {
                  "color": "@secondaryColor",
                  "margin-bottom": "14px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "5px",
                  "color": "@primaryColor"
                },
                ".mbr-text": {
                  "margin-top": "17px"
                },
                "h3": {
                  "color": "@infoColor"
                },
                "h4": {
                  "color": "@infoColor"
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "margin-left": "0 !important"
                  }
                }
              }
            },
            ".cards-wrap": {
              "flex-direction": "column"
            },
            ".wrapper": {
              "border-radius": "0.25rem",
              "margin-bottom": "26px",
              ".img": {
                "margin-bottom": "20px",
                ".mbr-iconfont": {
                  "font-size": "50px",
                  "top": "0",
                  "color": "@secondaryColor",
                  "border-radius": "50%"
                }
              },
              ".mbr-card-title": {
                "color": "@primaryColor",
                "padding-bottom": "14px",
                "margin-bottom": "10px"
              },
              ".mbr-text": {
                "margin-bottom": "19px",
                "color": "@infoColor"
              }
            },
            "@media (max-width: 767px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".wrap-block .contents h4, .menu-content-right": {
              "color": "#0a1126"
            },
            ".wrapper .mbr-text, .img": {
              "color": "#232323"
            },
            ".wrapper .mbr-card-title, .img": {
              "color": "#232323"
            },
            ".wrap-block .contents .mbr-subtitle, .menu-content-right": {
              "color": "#63b68f"
            }
          },
          "_name": "header3",
          "_customHTML": "<section class=\"header3\" group=\"Headers\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Accent Text\" name=\"showMainText\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Icons\" name=\"swIcon\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"mediaLeft\">\n        <input type=\"color\" title=\"Circle Color\" name=\"circleColor\" value=\"#ffffff\" condition=\"swIcon\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row align-items-center content-row\">\n            <div class=\"col-lg-4 wrap-block\">\n                <div class=\"contents\">\n                    <h2 class=\"mbr-subtitle mbr-fonts-style mbr-semibold\" data-app-selector=\".wrap-block .contents .mbr-subtitle, .menu-content-right\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-4\">Just starting up or already in business?</h2>\n                    <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" data-app-selector=\".wrap-block .contents .mbr-section-title, .menu-content-right\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\"><span style=\"font-weight: normal;\">Business advice, that works</span></h1>\n                    <h3 class=\"mbr-text mbr-fonts-style mbr-bold boldSubtitle\" data-app-selector=\".wrap-block .contents h3, .menu-content-right\" mbr-if=\"showMainText\" mbr-theme-style=\"display-7\">\n                        An honest home cleaning\n                        Trusted cleaners, guaranteed.</h3>\n                    <h4 class=\"mbr-text mbr-fonts-style mbr-regular mb-4\" data-app-selector=\".wrap-block .contents h4, .menu-content-right\" mbr-if=\"showText\" mbr-theme-style=\"display-7\">Whether you are a new startup or an already growing business, you can talk to us for guidance &amp; advice.</h4>\n                    <div class=\"mbr-section-btn align-left \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-success\" href=\"index.html#custom-html-8w\" data-app-placeholder=\"Type Text\">FREE Consultation</a></div>\n                </div>\n            </div>\n            <div class=\"col-lg-4\">\n                <div class=\"image-wrap mb-5\">\n                    <img src=\"@PROJECT_PATH@/assets/images/office-building-1.jpeg\" alt=\"Office\" title>\n                </div>\n            </div>\n            <div class=\"col-lg-4 cards\">\n                <div class=\"cards-wrap d-flex\">\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 0\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\" style=\"color: rgb(99, 182, 143); fill: rgb(99, 182, 143);\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".wrapper .mbr-card-title, .img\">Help grow your business</h4>\n\n                            <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".wrapper .mbr-text, .img\">Providing right guidance and advice on time to save money and help your business succeed</p>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-flag mobi-mbri\" style=\"color: rgb(99, 182, 143); fill: rgb(99, 182, 143);\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".wrapper .mbr-card-title, .img\">Achieve goals</h4>\n\n                            <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".wrapper .mbr-text, .img\">Achieving your goals and aims is our wish too</p>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-features mobi-mbri\" style=\"color: rgb(99, 182, 143); fill: rgb(99, 182, 143);\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".wrapper .mbr-card-title, .img\">Support you at every step</h4>\n                            <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".wrapper .mbr-text, .img\">We will help you succeed, whatever the stage you are in<br></p>\n                        </div>\n                    </div>\n\n                    <div class=\"row-item\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"wrapper\">\n                            <div class=\"img\" mbr-if=\"swIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".wrapper .mbr-card-title, .img\">Cleaning is...\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".wrapper .mbr-text, .img\">Lorem ipsum dolor\n                                amet, consecte tempor incididunt ut\n                                labore\n                                et\n                                dolore tumber tur adipisicing elit.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "header3-2",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "s2V9SVDk5H",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
