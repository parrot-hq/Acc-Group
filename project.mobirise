    "Privacy.html": {
      "settings": {
        "title": "Privacy",
        "meta_descr": "Accounting in South Norwood - Privacy policy",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": 12
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "font-weight": "500"
            },
            ".content-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "color": "#ffffff",
              "margin-left": "0.6rem",
              "span": {
                "margin-right": "15px",
                "margin-left": "20px",
                "padding": "10px",
                "border-radius": "100%",
                "color": "@primaryColor",
                "background-color": "#ffffff",
                "font-size": "2.475rem"
              }
            },
            ".mbr-section-btn": {
              "display": "flex",
              ".btn": {
                "font-weight": "700 !important"
              }
            },
            ".video-wrap": {
              "cursor": "pointer",
              "margin-left": "30px",
              ".mbr-media": {
                "z-index": "70",
                "height": "100%",
                "-o-object-fit": "cover",
                "object-fit": "cover",
                "background-repeat": "no-repeat",
                "background-size": "cover",
                "cursor": "pointer"
              },
              ".mbr-media span": {
                "font-size": "20px",
                "cursor": "pointer",
                "display": "inline-block",
                "transition": "all 0.25s",
                "color": "@iconColor",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              ".icon-wrap": {
                "background-color": "@bgIconColor",
                "width": "3.7em",
                "height": "3.7em",
                "border-radius": "50%",
                "max-width": "100% !important",
                "text-align": "center",
                "display": "inline-block",
                "border": "2px solid transparent",
                "box-sizing": "content-box",
                "position": "relative",
                ".line-video-1, .line-video-2": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "border": "2px solid rgba(255, 255, 255, 0.8)",
                  "border-radius": "50%",
                  "animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation": "squares 2.4s linear 0s infinite",
                  "-ms-animation": "squares 2.4s linear 0s infinite",
                  "-o-animation": "squares 2.4s linear 0s infinite",
                  "-webkit-animation-play-state": "running",
                  "animation-play-state": "running",
                  "opacity": "0"
                },
                ".line-video-2": {
                  "-webkit-animation-delay": "1.2s",
                  "animation-delay": "1.2s"
                }
              },
              ".mbr-text": {
                "color": "#ffffff",
                "font-weight": "700"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "calc(80vw / 1.778)",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "4vw",
              "top": "4vh",
              "color": "@successColor",
              "z-index": "5000000",
              "font-size": "37px",
              "background": "#000",
              "padding": "20px",
              "border-radius": "50%",
              "&:hover": {
                "color": "@successColor"
              }
            },
            "@media (max-width: 991px)": {
              ".separator, .sep-holder, .sep-line": {
                "display": "none !important"
              }
            },
            "@media (max-width: 768px)": {
              ".buttons-wrap": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  "justify-content": "center"
                },
                ".video-wrap": {
                  "margin-left": "0",
                  "margin-top": "25px",
                  "justify-content": "center"
                }
              }
            },
            "@-webkit-keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            "@keyframes squares": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "0"
              },
              "20%": {
                "transform": "scale(1.24)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(2.1)",
                "opacity": "0"
              }
            },
            ".skew": {
              "background-image": "url(@bgImg1)",
              "background-position": "center left",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "overflow": "hidden",
              "transition": "background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s",
              "margin-top": "-140px",
              "margin-bottom": "0",
              "z-index": "8",
              "position": "absolute",
              "display": "block",
              "width": "100%",
              "bottom": "0",
              ".inner": {
                "min-height": "150px",
                "align-items": "center",
                "display": "flex",
                "margin-right": "auto",
                "margin-left": "auto",
                "position": "relative"
              }
            }
          },
          "_name": "header4",
          "_customHTML": "<section class=\"header4\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"playervimeo\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"15\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Buttons Position\" name=\"justify\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Video Button\" name=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n        <input type=\"color\" title=\"Play Icon Color\" name=\"iconColor\" value=\"#279e64\" condition=\"showVideoButton\">\n        <input type=\"color\" title=\"Play Icon Background\" name=\"bgIconColor\" value=\"#ffffff\" condition=\"showVideoButton\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=J21qu_vspfg\" condition=\"showVideoButton\">\n        <input type=\"checkbox\" title=\"Bottom Mask\" name=\"showBottmMask\" checked>\n        <input type=\"image\" title=\"Image 1\" name=\"bgImg1\" value=\"@PROJECT_PATH@/assets/images/bg-skew.png\" condition=\"showBottmMask\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/clem-onojeghuo-wmjtxztw4os-unsplash.jpg\" title=\"Image\" selected>\n            <input type=\"color\" value=\"#13287d\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#1b1a1a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"align-left\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"wrap d-flex flex-column\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold align-left w-100\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><div><span style=\"font-size: 4.375rem;\">Privacy policy</span><br></div></h1>\n                    <p class=\"mbr-section-subtitle mbr-bold align-left pb-1 mbr-fonts-style w-100\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        REGULAR CLEANING</p>\n                    <p class=\"mbr-text align-left mbr-fonts-style mt-4\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                         and we'll do the number crunching</p>\n                    <div class=\"buttons-wrap d-flex mt-4 w-100\" mbr-class=\"{'justify-content-start': justify == 1, 'justify-content-center': justify == 2, 'justify-content-end': justify == 3}\">\n                        <div class=\"mbr-section-btn align-center \" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"index.html#form2-i\" data-app-placeholder=\"Type Text\">FREE Business Toolkit</a></div>\n                        <div class=\"video-wrap d-flex align-items-center\" mbr-if=\"showVideoButton\">\n                            <div class=\"mbr-media show-modal align-center d-flex align-items-center\" data-modal=\".modalWindow\" mbr-if=\"showVideoButton\">\n                                <div class=\"icon-wrap\" mbr-if=\"showVideoButton\">\n                                    <span mbr-icon class=\"mbr-iconfont fa-play fa\" mbr-if=\"showVideoButton\"></span>\n                                    <span class=\"line-video-animation line-video-1\"></span>\n                                    <br>\n                                    <span class=\"line-video-animation line-video-2\"></span>\n                                </div>\n                            </div>\n                            <h4 class=\"mbr-text mbr-fonts-style align-self-center ml-3 my-auto mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".video-wrap .mbr-text,.mbr-section-btn\" mbr-if=\"showVideoButton\">\n                                Our Video!\n                            </h4>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-arrow-down mbr-iconfont\"></i>\n        </a>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"skew\" mbr-if=\"showBottmMask\">\n        <div class=\"inner\">\n\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "cleanm4",
          "_cid": "shPeYTFHDx",
          "_anchor": "header4-a4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "max-width": "100%",
              "margin-bottom": "30px"
            },
            ".card-wrapper": {
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".meta": {
                  "color": "#999999",
                  "position": "relative",
                  "margin-bottom": "33px",
                  "& when (@showLines)": {
                    "&::before": {
                      "content": "\"\"",
                      "display": "block",
                      "width": "20px",
                      "height": "3px",
                      "background-color": "@linesColor",
                      "position": "absolute",
                      "left": "0",
                      "bottom": "-25px"
                    }
                  },
                  ".item": {
                    "transition": "all 0.3s ease-in",
                    "margin-right": "22px",
                    "&:hover": {
                      "color": "@tagsHoverColor !important",
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".mbr-iconfont": {
                    "color": "@infoColor",
                    "margin-right": "4px",
                    "font-size": "14px",
                    "font-weight": "400",
                    "transition": "all 0.3s ease-in"
                  },
                  ".item-author": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".author": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  },
                  ".item-date": {
                    ".date": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".item-comment": {
                    ".comment": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    "& when (@showLines)": {
                      "&:after": {
                        "content": "\"\"",
                        "display": "block",
                        "width": "35px",
                        "height": "3px",
                        "background-color": "@linesColor",
                        "position": "absolute",
                        "left": "30px",
                        "bottom": "-25px"
                      }
                    }
                  },
                  ".item-views": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".views": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500"
                },
                ".mbr-text": {
                  "margin-bottom": "24px",
                  "color": "@infoColor",
                  "&.accent-text": {
                    "color": "@primaryColor",
                    "position": "relative",
                    "padding-left": "62px",
                    ".mbr-iconfont": {
                      "display": "block",
                      "width": "41px",
                      "height": "36px",
                      "position": "absolute",
                      "left": "0",
                      "top": "10px",
                      "font-size": "41px",
                      "color": "@successColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                ".entry-content-bottom": {
                  "padding-top": "4px",
                  "padding-bottom": "38px",
                  "position": "relative",
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "justify-content": "space-between",
                  "align-items": "center",
                  ".entry-tags": {
                    "margin": "5px 15px 5px 0",
                    ".mbr-section-btn": {
                      "a": {
                        "border": "1px solid fade(@infoColor, 28.6%)",
                        "display": "inline-block",
                        "font-size": "14px !important",
                        "padding": "9.5px 31px",
                        "margin-top": "13px",
                        "margin-right": "6px",
                        "transition": "all .3s linear 0ms",
                        "&:hover": {
                          "background-color": "@secondaryColor",
                          "color": "#ffffff !important"
                        }
                      }
                    }
                  },
                  ".entry-social-share": {
                    "display": "flex",
                    "align-items": "flex-end",
                    "margin-top": "13px",
                    "ul": {
                      "margin": "0",
                      "padding": "0",
                      "display": "flex",
                      "align-items": "center",
                      "li": {
                        "padding": "4px",
                        "display": "flex",
                        "margin": "0 4px",
                        "background-color": "red",
                        "border-radius": "50%",
                        "width": "40px",
                        "height": "40px",
                        "align-items": "center",
                        "justify-content": "center",
                        "&.icon": {
                          "&1": {
                            "background-color": "@socialIconColor1"
                          },
                          "&2": {
                            "background-color": "@socialIconColor2"
                          },
                          "&3": {
                            "background-color": "@socialIconColor3"
                          },
                          "&4": {
                            "background-color": "@socialIconColor4"
                          },
                          "&5": {
                            "background-color": "@socialIconColor5"
                          }
                        },
                        ".icon-transition": {
                          ".mbr-iconfont": {
                            "font-size": "14px",
                            "color": "#ffffff"
                          }
                        },
                        "&:first-child": {
                          "margin-left": "0"
                        }
                      }
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".card-wrapper .card-box .mbr-text, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "content2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content2\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Meta\" name=\"showMeta\">\n        <input type=\"checkbox\" title=\"Lines\" name=\"showLines\" condition=\"showMeta\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Accent Text\" name=\"showAccentText\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"checkbox\" title=\"Bottom Content\" name=\"showBottomContent\">\n        <header condition=\"showMeta || showLink\">Colors</header>\n        <input type=\"color\" name=\"tagsHoverColor\" title=\"Tags Hover\" value=\"#279e64\" selected condition=\"showMeta\">\n        <input type=\"color\" name=\"linesColor\" title=\"Lines Color\" value=\"#279e64\" selected condition=\"showMeta && showLines\">\n        <input type=\"color\" name=\"iconColor\" title=\"Link Icon\" value=\"#13287d\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconColorHover\" title=\"Link Icon Hover\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Link Icon Bg Hover\" value=\"#279e64\" selected condition=\"showLink\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked condition=\"showBottomContent\">\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showBottomContent && showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <header condition=\"showBottomContent && showIcons\">Social Icons Color</header>\n        <input type=\"color\" name=\"socialIconColor1\" title=\"Icon 1 Bg\" value=\"#3b5998\" selected condition=\"showBottomContent && showIcons\">\n        <input type=\"color\" name=\"socialIconColor2\" title=\"Icon 2 Bg\" value=\"#00acee\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>1\">\n        <input type=\"color\" name=\"socialIconColor3\" title=\"Icon 3 Bg\" value=\"#ca1f27\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>2\">\n        <input type=\"color\" name=\"socialIconColor4\" title=\"Icon 4 Bg\" value=\"#dd4b39\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>3\">\n        <input type=\"color\" name=\"socialIconColor5\" title=\"Icon 5 Bg\" value=\"#279e64\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>4\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <img src=\"../_images/img/05.jpg\" mbr-if=\"showImage\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"meta mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showMeta\">\n                            <span class=\"item-author\">\n                                <span mbr-icon class=\"mbr-iconfont author mbrib-user\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text author item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-author .author, .card-wrapper .card-box .meta\">Matthew\n                                    Wheeler</span>\n                            </span>\n                            <span class=\"item-date\">\n                                <span mbr-icon class=\"mbr-iconfont date mbrib-calendar\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text date item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-date .date, .card-wrapper .card-box .meta\">July\n                                    25,\n                                    2025</span>\n                            </span>\n                            <span class=\"item-comment\">\n                                <span mbr-icon class=\"mbr-iconfont comment mbrib-help\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text comment item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-comment .comment, .card-wrapper .card-box .meta\">\n                                    Comments: 4</span>\n                            </span>\n                            <span class=\"item-views\">\n                                <span mbr-icon class=\"mbr-iconfont views mbrib-preview\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text views item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-views .views, .card-wrapper .card-box .meta\">\n                                    351 Views</span>\n                            </span>\n                        </div>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn, .card-wrapper .card-box .meta\">Disclaimer</h4>\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn, .card-wrapper .card-box .meta\">\n                            The best outdoor cleaning</h5>\n\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">While we have made every effort to provide accurate and up to date information on our website, the law is constantly changing and affects each person or business in different ways.&nbsp;The information contained within this website is no substitute for specific advice and we will not accept liability if you rely solely on information from the website.<br><br>It is important that you read this page as it contains important information regarding accessing our website.&nbsp;By accessing this website you agree to the terms and conditions set out below:<br><b>General</b><br>- This website is published by Accountancy Group. The following statements apply to this website.<br>- This website is issued in the United Kingdom and is intended for the information and use of United Kingdom residents only.<br><br><b>Privacy</b><br>Accountancy Group respects your privacy and is committed to protecting your personal data. This privacy notice will inform you as to how we look after your personal data when you visit our website (regardless of where you visit it from) and tell you about your privacy rights and how the law protects you.<br></p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-semibold accent-text align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showAccentText\" data-app-selector=\".card-wrapper .card-box .mbr-text.accent-text, .mbr-section-btn\">\n                            <span mbr-icon class=\"front mbr-iconfont fa-quote-left fa\" data-app-selector=\".content-link\"></span>\n                            Maybe you need to clean your house fast for a party, need a hotel maid to help scrub motel\n                            rooms, or are looking for a professional to help with hospital housekeeping.</p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"></p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Continue Reading<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                        <div class=\"entry-content-bottom\" mbr-if=\"showBottomContent\">\n                            <div class=\"entry-tags\">\n                                <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\">\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Office</a>\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Carpet</a>\n                                </div>\n                            </div>\n                            <div class=\"entry-social-share\" mbr-if=\"showIcons\">\n                                <ul>\n                                    <li mbr-if=\"iconsCount > 0\" class=\"icon icon1\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 1\" class=\"icon icon2\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 2\" class=\"icon icon3\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont fa-pinterest-p fa\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 3\" class=\"icon icon4\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-google socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 4\" class=\"icon icon5\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "shPeYUJtal",
          "_anchor": "content2-a7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".row when (@showLine)": {
              "border-top": "1px solid @line",
              "padding-top": "2rem"
            },
            ".mbr-text": {
              "line-height": "1.5",
              "color": "#0239b6"
            },
            ".container2": {
              "display": "block",
              "position": "relative",
              "padding-left": "35px",
              "margin-bottom": "12px",
              "cursor": "pointer",
              "font-size": "22px",
              "-webkit-user-select": "none",
              "-moz-user-select": "none",
              "-ms-user-select": "none",
              "user-select": "none"
            },
            ".container2 input": {
              "position": "absolute",
              "opacity": "0",
              "cursor": "pointer"
            },
            ".checkmark": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "height": "25px",
              "width": "25px",
              "background-color": "#eee"
            },
            ".container2:hover input ~ .checkmark": {
              "background-color": "#ccc"
            },
            ".container2 input:checked ~ .checkmark": {
              "background-color": "#2196F3"
            },
            ".checkmark:after": {
              "content": "\"\"",
              "position": "absolute",
              "display": "none"
            },
            ".container2 input:checked ~ .checkmark:after": {
              "display": "block"
            },
            ".container2 .checkmark:after": {
              "left": "10px",
              "top": "7px",
              "width": "5px",
              "height": "10px",
              "border": "solid white",
              "border-width": "0 3px 3px 0",
              "-webkit-transform": "rotate(45deg)",
              "-ms-transform": "rotate(45deg)",
              "transform": "rotate(45deg)"
            },
            ".mbr-section-title": {
              "text-align": "left",
              "color": "#656565"
            }
          },
          "_name": "extContent21",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"extContent\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" value=\"0\">\n        <select title=\"Items\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Line\" name=\"showLine\" checked>\n        <header>Colors</header>\n        <input type=\"color\" title=\"Line\" value=\"#f1f1f1\" name=\"line\" selected condition=\"showLine\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=x9vz-axHndk\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <h2 class=\"mbr-section-title pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Details</h2>\n\n        <div class=\"row\">\n            <div class=\"col-md-4\">\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Important information <br>&amp; who we are</p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 1\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">How we use your personal data\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 2\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">International transfers\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 3\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">The data we collect about you<br>\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 4\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Disclosures of your <br>personal data\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 5\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Data security\n                </p>\n\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "shPfYkNIcJ",
          "_anchor": "extContent21-ag",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".row when (@showLine)": {
              "border-top": "1px solid @line",
              "padding-top": "2rem"
            },
            ".mbr-text": {
              "line-height": "1.5",
              "color": "#0239b6"
            },
            ".container2": {
              "display": "block",
              "position": "relative",
              "padding-left": "35px",
              "margin-bottom": "12px",
              "cursor": "pointer",
              "font-size": "22px",
              "-webkit-user-select": "none",
              "-moz-user-select": "none",
              "-ms-user-select": "none",
              "user-select": "none"
            },
            ".container2 input": {
              "position": "absolute",
              "opacity": "0",
              "cursor": "pointer"
            },
            ".checkmark": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "height": "25px",
              "width": "25px",
              "background-color": "#eee"
            },
            ".container2:hover input ~ .checkmark": {
              "background-color": "#ccc"
            },
            ".container2 input:checked ~ .checkmark": {
              "background-color": "#2196F3"
            },
            ".checkmark:after": {
              "content": "\"\"",
              "position": "absolute",
              "display": "none"
            },
            ".container2 input:checked ~ .checkmark:after": {
              "display": "block"
            },
            ".container2 .checkmark:after": {
              "left": "10px",
              "top": "7px",
              "width": "5px",
              "height": "10px",
              "border": "solid white",
              "border-width": "0 3px 3px 0",
              "-webkit-transform": "rotate(45deg)",
              "-ms-transform": "rotate(45deg)",
              "transform": "rotate(45deg)"
            },
            ".mbr-section-title": {
              "text-align": "left",
              "color": "#656565"
            }
          },
          "_name": "extContent21",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"extContent\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" value=\"6\">\n        <select title=\"Items\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Line\" name=\"showLine\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Line\" value=\"#f1f1f1\" name=\"line\" selected condition=\"showLine\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=x9vz-axHndk\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <h2 class=\"mbr-section-title pb-3 mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Details</h2>\n\n        <div class=\"row\">\n            <div class=\"col-md-4\">\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Data retention</p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 1\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Your legal rights\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 2\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Glossary\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 3\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Parking: Attached Garage\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 4\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Heating: Forced Air, Gas\n                </p>\n\n            </div>\n\n            <div class=\"col-md-4\" mbr-if=\"cardsAmount > 5\">\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Water: City\n                </p>\n\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "shPgrbW2b2",
          "_anchor": "extContent21-ah",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "max-width": "100%",
              "margin-bottom": "30px"
            },
            ".card-wrapper": {
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".meta": {
                  "color": "#999999",
                  "position": "relative",
                  "margin-bottom": "33px",
                  "& when (@showLines)": {
                    "&::before": {
                      "content": "\"\"",
                      "display": "block",
                      "width": "20px",
                      "height": "3px",
                      "background-color": "@linesColor",
                      "position": "absolute",
                      "left": "0",
                      "bottom": "-25px"
                    }
                  },
                  ".item": {
                    "transition": "all 0.3s ease-in",
                    "margin-right": "22px",
                    "&:hover": {
                      "color": "@tagsHoverColor !important",
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".mbr-iconfont": {
                    "color": "@infoColor",
                    "margin-right": "4px",
                    "font-size": "14px",
                    "font-weight": "400",
                    "transition": "all 0.3s ease-in"
                  },
                  ".item-author": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".author": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  },
                  ".item-date": {
                    ".date": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".item-comment": {
                    ".comment": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    "& when (@showLines)": {
                      "&:after": {
                        "content": "\"\"",
                        "display": "block",
                        "width": "35px",
                        "height": "3px",
                        "background-color": "@linesColor",
                        "position": "absolute",
                        "left": "30px",
                        "bottom": "-25px"
                      }
                    }
                  },
                  ".item-views": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".views": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500"
                },
                ".mbr-text": {
                  "margin-bottom": "24px",
                  "color": "@infoColor",
                  "&.accent-text": {
                    "color": "@primaryColor",
                    "position": "relative",
                    "padding-left": "62px",
                    ".mbr-iconfont": {
                      "display": "block",
                      "width": "41px",
                      "height": "36px",
                      "position": "absolute",
                      "left": "0",
                      "top": "10px",
                      "font-size": "41px",
                      "color": "@successColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                ".entry-content-bottom": {
                  "padding-top": "4px",
                  "padding-bottom": "38px",
                  "position": "relative",
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "justify-content": "space-between",
                  "align-items": "center",
                  ".entry-tags": {
                    "margin": "5px 15px 5px 0",
                    ".mbr-section-btn": {
                      "a": {
                        "border": "1px solid fade(@infoColor, 28.6%)",
                        "display": "inline-block",
                        "font-size": "14px !important",
                        "padding": "9.5px 31px",
                        "margin-top": "13px",
                        "margin-right": "6px",
                        "transition": "all .3s linear 0ms",
                        "&:hover": {
                          "background-color": "@secondaryColor",
                          "color": "#ffffff !important"
                        }
                      }
                    }
                  },
                  ".entry-social-share": {
                    "display": "flex",
                    "align-items": "flex-end",
                    "margin-top": "13px",
                    "ul": {
                      "margin": "0",
                      "padding": "0",
                      "display": "flex",
                      "align-items": "center",
                      "li": {
                        "padding": "4px",
                        "display": "flex",
                        "margin": "0 4px",
                        "background-color": "red",
                        "border-radius": "50%",
                        "width": "40px",
                        "height": "40px",
                        "align-items": "center",
                        "justify-content": "center",
                        "&.icon": {
                          "&1": {
                            "background-color": "@socialIconColor1"
                          },
                          "&2": {
                            "background-color": "@socialIconColor2"
                          },
                          "&3": {
                            "background-color": "@socialIconColor3"
                          },
                          "&4": {
                            "background-color": "@socialIconColor4"
                          },
                          "&5": {
                            "background-color": "@socialIconColor5"
                          }
                        },
                        ".icon-transition": {
                          ".mbr-iconfont": {
                            "font-size": "14px",
                            "color": "#ffffff"
                          }
                        },
                        "&:first-child": {
                          "margin-left": "0"
                        }
                      }
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".card-wrapper .card-box .mbr-text, .mbr-section-btn": {
              "color": "#232323"
            }
          },
          "_name": "content2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content2\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Meta\" name=\"showMeta\">\n        <input type=\"checkbox\" title=\"Lines\" name=\"showLines\" condition=\"showMeta\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Accent Text\" name=\"showAccentText\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"checkbox\" title=\"Bottom Content\" name=\"showBottomContent\">\n        <header condition=\"showMeta || showLink\">Colors</header>\n        <input type=\"color\" name=\"tagsHoverColor\" title=\"Tags Hover\" value=\"#279e64\" selected condition=\"showMeta\">\n        <input type=\"color\" name=\"linesColor\" title=\"Lines Color\" value=\"#279e64\" selected condition=\"showMeta && showLines\">\n        <input type=\"color\" name=\"iconColor\" title=\"Link Icon\" value=\"#13287d\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconColorHover\" title=\"Link Icon Hover\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Link Icon Bg Hover\" value=\"#279e64\" selected condition=\"showLink\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked condition=\"showBottomContent\">\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showBottomContent && showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <header condition=\"showBottomContent && showIcons\">Social Icons Color</header>\n        <input type=\"color\" name=\"socialIconColor1\" title=\"Icon 1 Bg\" value=\"#3b5998\" selected condition=\"showBottomContent && showIcons\">\n        <input type=\"color\" name=\"socialIconColor2\" title=\"Icon 2 Bg\" value=\"#00acee\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>1\">\n        <input type=\"color\" name=\"socialIconColor3\" title=\"Icon 3 Bg\" value=\"#ca1f27\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>2\">\n        <input type=\"color\" name=\"socialIconColor4\" title=\"Icon 4 Bg\" value=\"#dd4b39\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>3\">\n        <input type=\"color\" name=\"socialIconColor5\" title=\"Icon 5 Bg\" value=\"#279e64\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>4\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <img src=\"@PROJECT_PATH@/assets/images/05-1.jpg\" mbr-if=\"showImage\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"meta mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showMeta\">\n                            <span class=\"item-author\">\n                                <span mbr-icon class=\"mbr-iconfont author mbrib-user\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text author item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-author .author, .card-wrapper .card-box .meta\">Matthew\n                                    Wheeler</span>\n                            </span>\n                            <span class=\"item-date\">\n                                <span mbr-icon class=\"mbr-iconfont date mbrib-calendar\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text date item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-date .date, .card-wrapper .card-box .meta\">July\n                                    25,\n                                    2025</span>\n                            </span>\n                            <span class=\"item-comment\">\n                                <span mbr-icon class=\"mbr-iconfont comment mbrib-help\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text comment item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-comment .comment, .card-wrapper .card-box .meta\">\n                                    Comments: 4</span>\n                            </span>\n                            <span class=\"item-views\">\n                                <span mbr-icon class=\"mbr-iconfont views mbrib-preview\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text views item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-views .views, .card-wrapper .card-box .meta\">\n                                    351 Views</span>\n                            </span>\n                        </div>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn, .card-wrapper .card-box .meta\">Important information <br>and who we are</h4>\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn, .card-wrapper .card-box .meta\">\n                            The best outdoor cleaning</h5>\n\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"><b>Purpose of this privacy notice<br></b>This privacy notice aims to give you information on how Accountancy Group collects and processes your personal data through your use of this website, including any data you may provide through this website.<br><br>This website is not intended for children and we do not knowingly collect data relating to children.<br><br>It is important that you read this privacy notice together with any other privacy notice or fair processing notice we may provide on specific occasions when we are collecting or processing personal data about you so that you are fully aware of how and why we are using your data. This privacy notice supplements the other notices and is not intended to override them.<br><br><b>Controller</b><br>Accountancy Group is the controller and responsible for your personal data (collectively referred to as Accountancy Group, 'we', 'us' or 'our' in this privacy notice).<br><br>We have appointed a data privacy manager who is responsible for overseeing questions in relation to this privacy notice. If you have any questions about this privacy notice, including any requests to exercise your legal rights, please contact the data privacy manager using the details set out below.<br><br>You have the right to make a complaint at any time to the Information Commissioner’s Office (ICO), the UK supervisory authority for data protection issues (www.ico.org.uk). We would, however, appreciate the chance to deal with your concerns before you approach the ICO so please contact us in the first instance.<br><br><b>Changes to the privacy notice and your duty to inform us of changes<br></b>This version was last updated on 1st May 2018 and historic versions can be obtained by contacting us.<br><br>It is important that the personal data we hold about you is accurate and current. Please keep us informed if your personal data changes during your relationship with us.<br><br><b>Third-party links<br></b>This website may include links to third-party websites, plug-ins and applications. Clicking on those links or enabling those connections may allow third parties to collect or share data about you. We do not control these third-party websites and are not responsible for their privacy statements. When you leave our website, we encourage you to read the privacy notice of every website you visit.<br><br><b>The data we collect about you<br></b>Personal data, or personal information, means any information about an individual from which that person can be identified. It does not include data where the identity has been removed (anonymous data).&nbsp;We may collect, use, store and transfer different kinds of personal data about you which we have grouped together as follows:<br></p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-semibold accent-text align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showAccentText\" data-app-selector=\".card-wrapper .card-box .mbr-text.accent-text, .mbr-section-btn\">\n                            <span mbr-icon class=\"front mbr-iconfont fa-quote-left fa\" data-app-selector=\".content-link\"></span>\n                            Maybe you need to clean your house fast for a party, need a hotel maid to help scrub motel\n                            rooms, or are looking for a professional to help with hospital housekeeping.</p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"></p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Continue Reading<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                        <div class=\"entry-content-bottom\" mbr-if=\"showBottomContent\">\n                            <div class=\"entry-tags\">\n                                <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\">\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Office</a>\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Carpet</a>\n                                </div>\n                            </div>\n                            <div class=\"entry-social-share\" mbr-if=\"showIcons\">\n                                <ul>\n                                    <li mbr-if=\"iconsCount > 0\" class=\"icon icon1\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 1\" class=\"icon icon2\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 2\" class=\"icon icon3\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont fa-pinterest-p fa\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 3\" class=\"icon icon4\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-google socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 4\" class=\"icon icon5\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content2-ai",
          "_isUserblock": true,
          "_cid": "shPgXWS0ww",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "max-width": "100%",
              "margin-bottom": "30px"
            },
            ".card-wrapper": {
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".meta": {
                  "color": "#999999",
                  "position": "relative",
                  "margin-bottom": "33px",
                  "& when (@showLines)": {
                    "&::before": {
                      "content": "\"\"",
                      "display": "block",
                      "width": "20px",
                      "height": "3px",
                      "background-color": "@linesColor",
                      "position": "absolute",
                      "left": "0",
                      "bottom": "-25px"
                    }
                  },
                  ".item": {
                    "transition": "all 0.3s ease-in",
                    "margin-right": "22px",
                    "&:hover": {
                      "color": "@tagsHoverColor !important",
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".mbr-iconfont": {
                    "color": "@infoColor",
                    "margin-right": "4px",
                    "font-size": "14px",
                    "font-weight": "400",
                    "transition": "all 0.3s ease-in"
                  },
                  ".item-author": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".author": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  },
                  ".item-date": {
                    ".date": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".item-comment": {
                    ".comment": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    "& when (@showLines)": {
                      "&:after": {
                        "content": "\"\"",
                        "display": "block",
                        "width": "35px",
                        "height": "3px",
                        "background-color": "@linesColor",
                        "position": "absolute",
                        "left": "30px",
                        "bottom": "-25px"
                      }
                    }
                  },
                  ".item-views": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".views": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500"
                },
                ".mbr-text": {
                  "margin-bottom": "24px",
                  "color": "@infoColor",
                  "&.accent-text": {
                    "color": "@primaryColor",
                    "position": "relative",
                    "padding-left": "62px",
                    ".mbr-iconfont": {
                      "display": "block",
                      "width": "41px",
                      "height": "36px",
                      "position": "absolute",
                      "left": "0",
                      "top": "10px",
                      "font-size": "41px",
                      "color": "@successColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                ".entry-content-bottom": {
                  "padding-top": "4px",
                  "padding-bottom": "38px",
                  "position": "relative",
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "justify-content": "space-between",
                  "align-items": "center",
                  ".entry-tags": {
                    "margin": "5px 15px 5px 0",
                    ".mbr-section-btn": {
                      "a": {
                        "border": "1px solid fade(@infoColor, 28.6%)",
                        "display": "inline-block",
                        "font-size": "14px !important",
                        "padding": "9.5px 31px",
                        "margin-top": "13px",
                        "margin-right": "6px",
                        "transition": "all .3s linear 0ms",
                        "&:hover": {
                          "background-color": "@secondaryColor",
                          "color": "#ffffff !important"
                        }
                      }
                    }
                  },
                  ".entry-social-share": {
                    "display": "flex",
                    "align-items": "flex-end",
                    "margin-top": "13px",
                    "ul": {
                      "margin": "0",
                      "padding": "0",
                      "display": "flex",
                      "align-items": "center",
                      "li": {
                        "padding": "4px",
                        "display": "flex",
                        "margin": "0 4px",
                        "background-color": "red",
                        "border-radius": "50%",
                        "width": "40px",
                        "height": "40px",
                        "align-items": "center",
                        "justify-content": "center",
                        "&.icon": {
                          "&1": {
                            "background-color": "@socialIconColor1"
                          },
                          "&2": {
                            "background-color": "@socialIconColor2"
                          },
                          "&3": {
                            "background-color": "@socialIconColor3"
                          },
                          "&4": {
                            "background-color": "@socialIconColor4"
                          },
                          "&5": {
                            "background-color": "@socialIconColor5"
                          }
                        },
                        ".icon-transition": {
                          ".mbr-iconfont": {
                            "font-size": "14px",
                            "color": "#ffffff"
                          }
                        },
                        "&:first-child": {
                          "margin-left": "0"
                        }
                      }
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".card-wrapper .card-box .mbr-text, .mbr-section-btn": {
              "color": "#232323"
            }
          },
          "_name": "content2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content2\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Meta\" name=\"showMeta\">\n        <input type=\"checkbox\" title=\"Lines\" name=\"showLines\" condition=\"showMeta\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Accent Text\" name=\"showAccentText\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"checkbox\" title=\"Bottom Content\" name=\"showBottomContent\">\n        <header condition=\"showMeta || showLink\">Colors</header>\n        <input type=\"color\" name=\"tagsHoverColor\" title=\"Tags Hover\" value=\"#279e64\" selected condition=\"showMeta\">\n        <input type=\"color\" name=\"linesColor\" title=\"Lines Color\" value=\"#279e64\" selected condition=\"showMeta && showLines\">\n        <input type=\"color\" name=\"iconColor\" title=\"Link Icon\" value=\"#13287d\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconColorHover\" title=\"Link Icon Hover\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Link Icon Bg Hover\" value=\"#279e64\" selected condition=\"showLink\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked condition=\"showBottomContent\">\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showBottomContent && showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <header condition=\"showBottomContent && showIcons\">Social Icons Color</header>\n        <input type=\"color\" name=\"socialIconColor1\" title=\"Icon 1 Bg\" value=\"#3b5998\" selected condition=\"showBottomContent && showIcons\">\n        <input type=\"color\" name=\"socialIconColor2\" title=\"Icon 2 Bg\" value=\"#00acee\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>1\">\n        <input type=\"color\" name=\"socialIconColor3\" title=\"Icon 3 Bg\" value=\"#ca1f27\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>2\">\n        <input type=\"color\" name=\"socialIconColor4\" title=\"Icon 4 Bg\" value=\"#dd4b39\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>3\">\n        <input type=\"color\" name=\"socialIconColor5\" title=\"Icon 5 Bg\" value=\"#279e64\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>4\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <img src=\"@PROJECT_PATH@/assets/images/05-1.jpg\" mbr-if=\"showImage\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"meta mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showMeta\">\n                            <span class=\"item-author\">\n                                <span mbr-icon class=\"mbr-iconfont author mbrib-user\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text author item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-author .author, .card-wrapper .card-box .meta\">Matthew\n                                    Wheeler</span>\n                            </span>\n                            <span class=\"item-date\">\n                                <span mbr-icon class=\"mbr-iconfont date mbrib-calendar\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text date item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-date .date, .card-wrapper .card-box .meta\">July\n                                    25,\n                                    2025</span>\n                            </span>\n                            <span class=\"item-comment\">\n                                <span mbr-icon class=\"mbr-iconfont comment mbrib-help\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text comment item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-comment .comment, .card-wrapper .card-box .meta\">\n                                    Comments: 4</span>\n                            </span>\n                            <span class=\"item-views\">\n                                <span mbr-icon class=\"mbr-iconfont views mbrib-preview\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text views item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-views .views, .card-wrapper .card-box .meta\">\n                                    351 Views</span>\n                            </span>\n                        </div>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn, .card-wrapper .card-box .meta\">The data we collect about you</h4>\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn, .card-wrapper .card-box .meta\">\n                            The best outdoor cleaning</h5>\n\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">Personal data, or personal information, means any information about an individual from which that person can be identified. It does not include data where the identity has been removed (anonymous data).<br><br>We may collect, use, store and transfer different kinds of personal data about you which we have grouped together as follows:<br></p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-semibold accent-text align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showAccentText\" data-app-selector=\".card-wrapper .card-box .mbr-text.accent-text, .mbr-section-btn\">\n                            <span mbr-icon class=\"front mbr-iconfont fa-quote-left fa\" data-app-selector=\".content-link\"></span>\n                            Maybe you need to clean your house fast for a party, need a hotel maid to help scrub motel\n                            rooms, or are looking for a professional to help with hospital housekeeping.</p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"></p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Continue Reading<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                        <div class=\"entry-content-bottom\" mbr-if=\"showBottomContent\">\n                            <div class=\"entry-tags\">\n                                <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\">\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Office</a>\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Carpet</a>\n                                </div>\n                            </div>\n                            <div class=\"entry-social-share\" mbr-if=\"showIcons\">\n                                <ul>\n                                    <li mbr-if=\"iconsCount > 0\" class=\"icon icon1\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 1\" class=\"icon icon2\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 2\" class=\"icon icon3\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont fa-pinterest-p fa\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 3\" class=\"icon icon4\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-google socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 4\" class=\"icon icon5\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content2-ak",
          "_isUserblock": true,
          "_cid": "shPhsC8kKn",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-title": {
              "color": "@primaryColor"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            ".nav-tabs": {
              "flex-wrap": "wrap",
              "border-bottom": "none",
              ".nav-item": {
                "&:first-child": {
                  ".nav-link": {
                    "border-left": "1px solid @borderColor"
                  }
                },
                "& when (@bootstrapTabs = '3')": {
                  "&:nth-child(3)": {
                    "border-right": "1px solid @borderColor"
                  }
                },
                "& when (@bootstrapTabs = '4')": {
                  "&:nth-child(4)": {
                    "border-right": "1px solid @borderColor"
                  }
                },
                "& when (@bootstrapTabs = '5')": {
                  "&:nth-child(5)": {
                    "border-right": "1px solid @borderColor"
                  }
                },
                "& when (@bootstrapTabs = '6')": {
                  "&:nth-child(6)": {
                    "border-right": "1px solid @borderColor"
                  }
                }
              }
            },
            ".nav-tabs .nav-link": {
              "color": "@tabsColor",
              "font-style": "normal",
              "font-weight": "500",
              "transition": "all .5s",
              "border": "1px solid @borderColor",
              "border-bottom": "none",
              "border-right": "none",
              "border-radius": "0 !important",
              "padding": "16px 40px",
              "&:hover": {
                "cursor": "pointer",
                "color": "@activeTabColor"
              },
              "&.active": {
                "font-weight": "500",
                "color": "@activeTabColor",
                "font-style": "normal",
                "border-bottom": "none"
              }
            },
            ".tab-title": {
              "color": "@primaryColor"
            },
            "P": {
              "color": "#232323"
            },
            ".tab-pane": {
              "padding": "40px 25px",
              "border": "1px solid @borderColor"
            },
            "@media (max-width: 576px)": {
              ".nav-tabs": {
                "flex-direction": "column",
                "justify-content": "center"
              },
              ".mbr-text, .nav-link": {
                "text-align": "center"
              }
            }
          },
          "_name": "tabs3",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"tabs3\" group=\"Tabs\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax, 'mbr-fullscreen': fullScreen}\" plugins=\"mobirise-tabs\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"!fullScreen\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"color\" title=\"Tabs Color\" name=\"tabsColor\" value=\"#13287d\">\n        <input type=\"color\" title=\"Active Tab Color\" name=\"activeTabColor\" value=\"#ff7c00\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#dcdfe2\">\n        <select title=\"Tabs Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <h2 class=\"align-left mbr-fonts-style mbr-section-title mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Basic Clean\n        </h2>\n        <div class=\"row\">\n            <div class=\"col-12 col-md-12\">\n                <ul class=\"nav nav-tabs\" role=\"tablist\">\n                    <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs3-am_tab0\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Identity</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs3-am_tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Contact</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs3-am_tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Transaction</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs3-am_tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Technical</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs3-am_tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Profile</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs3-am_tab5\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Usage, marketing &amp; communications</a></li>\n                </ul>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-semibold tab-title\" mbr-theme-style=\"display-7\" data-app-selector=\".tab-title\">\n                                    Identity</h3>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Includes first name, maiden name, last name, username or similar identifier, marital status, title, date of birth and gender.<br></p>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-semibold tab-title\" mbr-theme-style=\"display-7\" data-app-selector=\".tab-title\">Contact</h3>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Includes company address, email address and telephone numbers.<br></p>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-semibold tab-title\" mbr-theme-style=\"display-7\" data-app-selector=\".tab-title\">\n                                    Transaction\n                                </h3>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Includes details about payments to and from you and other details of the services you use from us.<br></p>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-semibold tab-title\" mbr-theme-style=\"display-7\" data-app-selector=\".tab-title\">\n                                    Technical</h3>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Includes internet protocol (IP) address, your login data, browser type and version, time zone setting and location, browser plug-in types and versions, operating system and platform and other technology on the devices you use to access this website.<br></p>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-semibold tab-title\" mbr-theme-style=\"display-7\" data-app-selector=\".tab-title\">\n                                    Profile</h3>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Includes your username and password, preferences, feedback and survey responses.<br></p>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-semibold tab-title\" mbr-theme-style=\"display-7\" data-app-selector=\".tab-title\">\n                                    Usage, marketing &amp; communications</h3>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Usage - Includes information about how you use our website, products and services.<br></p>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Marketing &amp; communications- Includes your preferences in receiving marketing from us and our third parties and your communication preferences.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "shPirQPI9p",
          "_anchor": "tabs3-am",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "img": {
              "max-width": "100%",
              "margin-bottom": "30px"
            },
            ".card-wrapper": {
              "margin-top": "15px",
              "margin-bottom": "15px",
              ".card-box": {
                ".card-title": {
                  "color": "@primaryColor",
                  "transition": "0.3s all",
                  "margin-bottom": "20px",
                  "&:hover": {
                    "color": "@primaryColor",
                    "transition": "0.3s all"
                  }
                },
                ".meta": {
                  "color": "#999999",
                  "position": "relative",
                  "margin-bottom": "33px",
                  "& when (@showLines)": {
                    "&::before": {
                      "content": "\"\"",
                      "display": "block",
                      "width": "20px",
                      "height": "3px",
                      "background-color": "@linesColor",
                      "position": "absolute",
                      "left": "0",
                      "bottom": "-25px"
                    }
                  },
                  ".item": {
                    "transition": "all 0.3s ease-in",
                    "margin-right": "22px",
                    "&:hover": {
                      "color": "@tagsHoverColor !important",
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".mbr-iconfont": {
                    "color": "@infoColor",
                    "margin-right": "4px",
                    "font-size": "14px",
                    "font-weight": "400",
                    "transition": "all 0.3s ease-in"
                  },
                  ".item-author": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".author": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  },
                  ".item-date": {
                    ".date": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    }
                  },
                  ".item-comment": {
                    ".comment": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    },
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    "& when (@showLines)": {
                      "&:after": {
                        "content": "\"\"",
                        "display": "block",
                        "width": "35px",
                        "height": "3px",
                        "background-color": "@linesColor",
                        "position": "absolute",
                        "left": "30px",
                        "bottom": "-25px"
                      }
                    }
                  },
                  ".item-views": {
                    "&:hover": {
                      ".mbr-iconfont": {
                        "color": "@tagsHoverColor !important"
                      }
                    },
                    ".views": {
                      "color": "@infoColor",
                      "font-weight": "500"
                    }
                  }
                },
                ".card-subtitle": {
                  "color": "@primaryColor",
                  "margin-bottom": "13px",
                  "font-weight": "500"
                },
                ".mbr-text": {
                  "margin-bottom": "24px",
                  "color": "@infoColor",
                  "&.accent-text": {
                    "color": "@primaryColor",
                    "position": "relative",
                    "padding-left": "62px",
                    ".mbr-iconfont": {
                      "display": "block",
                      "width": "41px",
                      "height": "36px",
                      "position": "absolute",
                      "left": "0",
                      "top": "10px",
                      "font-size": "41px",
                      "color": "@successColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "position": "relative",
                  "margin-left": "1px",
                  ".link": {
                    "display": "flex !important",
                    "justify-content": "flex-start",
                    "align-items": "center"
                  },
                  ".mbr-iconfont": {
                    "font-size": "16px",
                    "margin-left": "40px",
                    "position": "relative",
                    "top": "1px",
                    "display": "inline-flex",
                    "width": "46px",
                    "height": "46px",
                    "background": "0 0",
                    "color": "@iconColor",
                    "align-items": "center",
                    "justify-content": "center",
                    "transition": "all .3s linear 0s",
                    "order": "2",
                    "&::after": {
                      "content": "\"\"",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "display": "block",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@iconBgColorHover",
                      "transform": "scale(0)",
                      "transition": "all .3s linear 0s"
                    },
                    "&::before": {
                      "position": "relative",
                      "z-index": "1"
                    }
                  }
                },
                ".entry-content-bottom": {
                  "padding-top": "4px",
                  "padding-bottom": "38px",
                  "position": "relative",
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "justify-content": "space-between",
                  "align-items": "center",
                  ".entry-tags": {
                    "margin": "5px 15px 5px 0",
                    ".mbr-section-btn": {
                      "a": {
                        "border": "1px solid fade(@infoColor, 28.6%)",
                        "display": "inline-block",
                        "font-size": "14px !important",
                        "padding": "9.5px 31px",
                        "margin-top": "13px",
                        "margin-right": "6px",
                        "transition": "all .3s linear 0ms",
                        "&:hover": {
                          "background-color": "@secondaryColor",
                          "color": "#ffffff !important"
                        }
                      }
                    }
                  },
                  ".entry-social-share": {
                    "display": "flex",
                    "align-items": "flex-end",
                    "margin-top": "13px",
                    "ul": {
                      "margin": "0",
                      "padding": "0",
                      "display": "flex",
                      "align-items": "center",
                      "li": {
                        "padding": "4px",
                        "display": "flex",
                        "margin": "0 4px",
                        "background-color": "red",
                        "border-radius": "50%",
                        "width": "40px",
                        "height": "40px",
                        "align-items": "center",
                        "justify-content": "center",
                        "&.icon": {
                          "&1": {
                            "background-color": "@socialIconColor1"
                          },
                          "&2": {
                            "background-color": "@socialIconColor2"
                          },
                          "&3": {
                            "background-color": "@socialIconColor3"
                          },
                          "&4": {
                            "background-color": "@socialIconColor4"
                          },
                          "&5": {
                            "background-color": "@socialIconColor5"
                          }
                        },
                        ".icon-transition": {
                          ".mbr-iconfont": {
                            "font-size": "14px",
                            "color": "#ffffff"
                          }
                        },
                        "&:first-child": {
                          "margin-left": "0"
                        }
                      }
                    }
                  }
                },
                "&:hover": {
                  ".mbr-section-btn": {
                    ".mbr-iconfont": {
                      "&::before": {
                        "color": "@iconColorHover"
                      },
                      "&::after": {
                        "transform": "scale(1)",
                        "box-shadow": "0 10px 30px 0 @iconBgColorHover"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".card-wrapper .card-box .mbr-text, .mbr-section-btn": {
              "color": "#232323"
            }
          },
          "_name": "content2",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content2\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <input type=\"checkbox\" title=\"Meta\" name=\"showMeta\">\n        <input type=\"checkbox\" title=\"Lines\" name=\"showLines\" condition=\"showMeta\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Accent Text\" name=\"showAccentText\">\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"checkbox\" title=\"Bottom Content\" name=\"showBottomContent\">\n        <header condition=\"showMeta || showLink\">Colors</header>\n        <input type=\"color\" name=\"tagsHoverColor\" title=\"Tags Hover\" value=\"#279e64\" selected condition=\"showMeta\">\n        <input type=\"color\" name=\"linesColor\" title=\"Lines Color\" value=\"#279e64\" selected condition=\"showMeta && showLines\">\n        <input type=\"color\" name=\"iconColor\" title=\"Link Icon\" value=\"#13287d\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconColorHover\" title=\"Link Icon Hover\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" name=\"iconBgColorHover\" title=\"Link Icon Bg Hover\" value=\"#279e64\" selected condition=\"showLink\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked condition=\"showBottomContent\">\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showBottomContent && showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <header condition=\"showBottomContent && showIcons\">Social Icons Color</header>\n        <input type=\"color\" name=\"socialIconColor1\" title=\"Icon 1 Bg\" value=\"#3b5998\" selected condition=\"showBottomContent && showIcons\">\n        <input type=\"color\" name=\"socialIconColor2\" title=\"Icon 2 Bg\" value=\"#00acee\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>1\">\n        <input type=\"color\" name=\"socialIconColor3\" title=\"Icon 3 Bg\" value=\"#ca1f27\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>2\">\n        <input type=\"color\" name=\"socialIconColor4\" title=\"Icon 4 Bg\" value=\"#dd4b39\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>3\">\n        <input type=\"color\" name=\"socialIconColor5\" title=\"Icon 5 Bg\" value=\"#279e64\" selected condition=\"showBottomContent &amp;&amp; showIcons &amp;&amp; iconsCount>4\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <img src=\"@PROJECT_PATH@/assets/images/05-1.jpg\" mbr-if=\"showImage\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"meta mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showMeta\">\n                            <span class=\"item-author\">\n                                <span mbr-icon class=\"mbr-iconfont author mbrib-user\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text author item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-author .author, .card-wrapper .card-box .meta\">Matthew\n                                    Wheeler</span>\n                            </span>\n                            <span class=\"item-date\">\n                                <span mbr-icon class=\"mbr-iconfont date mbrib-calendar\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text date item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-date .date, .card-wrapper .card-box .meta\">July\n                                    25,\n                                    2025</span>\n                            </span>\n                            <span class=\"item-comment\">\n                                <span mbr-icon class=\"mbr-iconfont comment mbrib-help\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text comment item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-comment .comment, .card-wrapper .card-box .meta\">\n                                    Comments: 4</span>\n                            </span>\n                            <span class=\"item-views\">\n                                <span mbr-icon class=\"mbr-iconfont views mbrib-preview\"></span>\n                                <span mbr-text class=\"mbr-fonts-style mbr-text views item\" mbr-theme-style=\"display-4\" data-app-selector=\".card-wrapper .card-box .meta .item-views .views, .card-wrapper .card-box .meta\">\n                                    351 Views</span>\n                            </span>\n                        </div>\n                        <h4 class=\"mbr-fonts-style mbr-semibold align-left card-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-wrapper .card-box .card-title, .mbr-section-btn, .card-wrapper .card-box .meta\">Disclaimer</h4>\n                        <h5 class=\"card-subtitle align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-wrapper .card-box .card-subtitle, .mbr-section-btn, .card-wrapper .card-box .meta\">\n                            The best outdoor cleaning</h5>\n\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\">We do not collect any Special Categories of Personal Data about you (this includes details about your race or ethnicity, religious or philosophical beliefs, sex life, sexual orientation, political opinions, trade union membership, information about your health and genetic and biometric data). Nor do we collect any information about criminal convictions and offences.<br><br><b>If you fail to provide personal data<br></b>Where we need to collect personal data by law, or under the terms of a contract we have with you and you fail to provide that data when requested, we may not be able to perform the contract we have or are trying to enter into with you (for example, to provide you with goods or services). In this case, we may have to cancel a product or service you have with us but we will notify you if this is the case at the time.<br><br><b>How is your personal data collected?<br></b>We use different methods to collect data from and about you including through:<br><i><b>Direct interactions<br></b></i>You may give us your Identity / Contact data by filling in forms or by corresponding with us by post, phone, email or otherwise. This includes personal data you provide when you:<br>- apply for our products or services<br>- create an account on our website<br>- subscribe to our service or publications<br>- request marketing to be sent to you<br>- enter a survey<br>- apply for employment or to provide us with services<br>- give us some feedback.<br><br><b><i>Automated technologies or interactions<br></i></b>As you interact with our website, we may automatically collect Technical Data about your equipment, browsing actions and patterns. We collect this personal data by using cookies, server logs and other similar technologies. Please see our cookie policy for further details.<br><br><b><i>Third parties or publicly available sources.<br></i></b>We may receive personal data about you from various third parties, including technical data from the following parties:<br>- analytics providers [such as Google based outside the EU]<br>- advertising networks [such as Google based outside the EU]<br>- search information providers [such as Google based outside the EU].<br><br><b>How we use your personal data<br></b>We will only use your personal data when the law allows us to. Most commonly, we will use your personal data in the following circumstances:<br><br>Where we need to perform the contract we are about to enter into or have entered into with you.<br>Where it is necessary for our legitimate interests (or those of a third party) and your interests and fundamental rights do not override those interests.<br>Where we need to comply with a legal or regulatory obligation.<br>Generally we do not rely on consent as a legal basis for processing your personal data other than in relation to sending third party direct marketing communications to you via email or text message. You have the right to withdraw consent to marketing at any time by contacting us.<br><br><b>Purposes for which we will use your personal data<br></b>We have set out below a description of all the ways we plan to use your personal data, and which of the legal bases we rely on to do so. We have also identified what our legitimate interests are where appropriate.<br><br>Note that we may process your personal data for more than one lawful ground depending on the specific purpose for which we are using your data. Please contact us if you need details about the specific legal ground we are relying on to process your personal data where more than one ground has been set out in the table below.<br></p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-semibold accent-text align-left pt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showAccentText\" data-app-selector=\".card-wrapper .card-box .mbr-text.accent-text, .mbr-section-btn\">\n                            <span mbr-icon class=\"front mbr-iconfont fa-quote-left fa\" data-app-selector=\".content-link\"></span>\n                            Maybe you need to clean your house fast for a party, need a hotel maid to help scrub motel\n                            rooms, or are looking for a professional to help with hospital housekeeping.</p>\n                        <p class=\"mbr-fonts-style mbr-text mbr-regular align-left pt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-wrapper .card-box .mbr-text, .mbr-section-btn\"></p>\n\n                        <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\" mbr-if=\"showLink\">\n                            <a class=\"mbr-section-text mbr-bold pb-3 mbr-fonts-style d-inline-block link text-primary\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                Continue Reading<span mbr-icon class=\"mbrib-plus mbr-iconfont mbr-iconfont-btn mbr-bold\"></span></a>\n                        </div>\n                        <div class=\"entry-content-bottom\" mbr-if=\"showBottomContent\">\n                            <div class=\"entry-tags\">\n                                <div class=\"mbr-section-btn mbr-fonts-style mbr-text\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"mbrBtnMove,mbrBtnLink,mbrBtnAdd\" data-app-selector=\".mbr-fonts-style\">\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Office</a>\n                                    <a class=\"mbr-section-text mbr-regular mbr-fonts-style d-inline-block text-info\" mbr-if=\"showLink\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-fonts-style\">\n                                        Carpet</a>\n                                </div>\n                            </div>\n                            <div class=\"entry-social-share\" mbr-if=\"showIcons\">\n                                <ul>\n                                    <li mbr-if=\"iconsCount > 0\" class=\"icon icon1\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 1\" class=\"icon icon2\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 2\" class=\"icon icon3\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont fa-pinterest-p fa\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 3\" class=\"icon icon4\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-google socicon\">\n                                            </span>\n                                        </a>\n                                    </li>\n                                    <li mbr-if=\"iconsCount > 4\" class=\"icon icon5\">\n                                        <a class=\"icon-transition\" href=\"#\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                        <span class=\"sr-only\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content2-an",
          "_isUserblock": true,
          "_cid": "shPjDnZUVE",
